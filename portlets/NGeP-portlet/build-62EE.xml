<?xml version="1.0"?> 
<!DOCTYPE project>

<project name="6_1_to_6_2" default="copyTo62EE">

	<property name="61PortletDir" location="." />
	<property name="62PortletDir" location="../../../liferay-plugins-sdk-6.2/portlets/NGeP-portlet" />
	
	
	
	<target name="build-NGeP-portlet-war">
		<antcall target="copyTo62EE" />
		<antcall target="war-62" />
		<rename src="../../../liferay-plugins-sdk-6.2/dist/NGeP-portlet-6.2.0.1.war" dest="../../../liferay-plugins-sdk-6.2/dist/NGeP-portlet.war"/>
		<antcall target="war-deployment-assembly" />
	</target>
	
	<target name="war-deployment-assembly">
		<zip destfile="../../../liferay-plugins-sdk-6.2/dist/NGeP-portlet.war"
		    basedir="../../../Deployment-assembly/NGeP-portlet"			
		   	update="true"/> 
		
		<delete dir="../../../Deployment-assembly/NGeP-portlet/" />
	</target>
	
	<target name="clean">
		
		<delete file="${62PortletDir}/kmc.properties" />
		<delete file="${62PortletDir}/kmc-host.crt" />
		
		<delete dir="${62PortletDir}/docroot/css/images" />
		<delete dir="${62PortletDir}/docroot/excelUpload" />
		<delete dir="${62PortletDir}/docroot/images" />
		<delete dir="${62PortletDir}/docroot/js" />
		<delete dir="${62PortletDir}/docroot/META-INF" />
		<delete dir="${62PortletDir}/docroot/resources" />
		<delete dir="${62PortletDir}/docroot/wsdl" /> 
		
		<delete dir="${62PortletDir}/docroot/WEB-INF/config" />
		<delete dir="${62PortletDir}/docroot/WEB-INF/facelets" />
		<delete dir="${62PortletDir}/docroot/WEB-INF/src" />
		<delete dir="${62PortletDir}/docroot/WEB-INF/templates" />
		<delete dir="${62PortletDir}/docroot/WEB-INF/lib" />
		
		<delete file="${62PortletDir}/docroot/WEB-INF/portlet.xml" />
		<delete file="${62PortletDir}/docroot/WEB-INF/liferay-display.xml" />
		<delete file="${62PortletDir}/docroot/WEB-INF/liferay-portlet.xml" />
		<delete file="${62PortletDir}/docroot/WEB-INF/faces-config.xml" />
		<delete file="${62PortletDir}/docroot/WEB-INF/jboss-deployment-structure.xml" />
		<!--<delete file="${62PortletDir}/docroot/WEB-INF/liferay-plugin-package.properties" />-->
		<delete file="${62PortletDir}/docroot/WEB-INF/web.xml" />
		
		<delete dir="${62PortletDir}/docroot/xhtml" />
		
	</target>
	
	<target name="copyTo62EE" >
		
		<!--<copy file="${61PortletDir}/kmc.properties" todir="${62PortletDir}"></copy>
		<copy file="${61PortletDir}/kmc-host.crt" 	todir="${62PortletDir}"></copy>-->
		
		<copydir forceoverwrite="true" dest="${62PortletDir}/docroot/css/images" 		src="${61PortletDir}/docroot/css/images" />
		<copydir forceoverwrite="true" dest="${62PortletDir}/docroot/excelUpload" src="${61PortletDir}/docroot/excelUpload" />
		<copydir forceoverwrite="true" dest="${62PortletDir}/docroot/images" 		src="${61PortletDir}/docroot/images" />
		<copydir forceoverwrite="true" dest="${62PortletDir}/docroot/js" 			src="${61PortletDir}/docroot/js" />
		<copydir forceoverwrite="true" dest="${62PortletDir}/docroot/META-INF" 	src="${61PortletDir}/docroot/META-INF" />
		<copydir forceoverwrite="true" dest="${62PortletDir}/docroot/resources" 	src="${61PortletDir}/docroot/resources" />
		<copydir forceoverwrite="true" dest="${62PortletDir}/docroot/wsdl" 		src="${61PortletDir}/docroot/wsdl" />
		<copydir forceoverwrite="true" dest="${62PortletDir}/docroot/xhtml" 		src="${61PortletDir}/docroot/xhtml" />
		<copydir forceoverwrite="true" dest="${62PortletDir}/docroot/encryptionKeys" 		src="${61PortletDir}/docroot/encryptionKeys" />
		
		<copydir forceoverwrite="true" dest="${62PortletDir}/docroot/WEB-INF/config" src="${61PortletDir}/docroot/WEB-INF/config" />
		<copydir forceoverwrite="true" dest="${62PortletDir}/docroot/WEB-INF/config/soft-certificate" src="${61PortletDir}/docroot/WEB-INF/config/soft-certificate" />
		<copydir forceoverwrite="true" dest="${62PortletDir}/docroot/WEB-INF/facelets" src="${61PortletDir}/docroot/WEB-INF/facelets" />
		<copydir forceoverwrite="true" dest="${62PortletDir}/docroot/WEB-INF/src" src="${61PortletDir}/docroot/WEB-INF/src" />
		<copydir forceoverwrite="true" dest="${62PortletDir}/docroot/WEB-INF/templates" src="${61PortletDir}/docroot/WEB-INF/templates" />
		
		<move file="${62PortletDir}/docroot/WEB-INF/config/messageprovider-config" todir="${62PortletDir}/docroot/WEB-INF/src" />
		<move file="${62PortletDir}/docroot/WEB-INF/templates" todir="${62PortletDir}/docroot/WEB-INF/src" />
		
		<copydir forceoverwrite="true" dest="${62PortletDir}/docroot/WEB-INF/lib" src="${61PortletDir}/docroot/WEB-INF/lib" />
		<delete file="${62PortletDir}/docroot/WEB-INF/lib/jboss-el-2.0.0.GA.jar" />
		<delete file="${62PortletDir}/docroot/WEB-INF/lib/jsf-api-2.1.3-b02.jar" />
		<delete file="${62PortletDir}/docroot/WEB-INF/lib/jsf-impl-2.1.3-b02.jar" />
		<delete file="${62PortletDir}/docroot/WEB-INF/lib/liferay-faces-bridge-api-3.1.1-ga2.jar" />
		<delete file="${62PortletDir}/docroot/WEB-INF/lib/liferay-faces-bridge-impl-3.1.1-ga2.jar" />
		<delete file="${62PortletDir}/docroot/WEB-INF/lib/liferay-faces-portal-3.1.1-ga2.jar" />
		<delete file="${62PortletDir}/docroot/WEB-INF/lib/liferay-faces-util-3.1.1-ga2.jar" />
		<!-- <delete file="${62PortletDir}/docroot/WEB-INF/lib/primefaces-3.5.jar" /> -->
		
		<copy overwrite="true" file="${61PortletDir}/docroot/WEB-INF/liferay-hook.xml" 		todir="${62PortletDir}/docroot/WEB-INF" />
		<copy overwrite="true" file="${61PortletDir}/docroot/WEB-INF/portlet.xml" 			todir="${62PortletDir}/docroot/WEB-INF" />
		<copy overwrite="true" file="${61PortletDir}/docroot/WEB-INF/liferay-display.xml" 	todir="${62PortletDir}/docroot/WEB-INF" />
		<copy overwrite="true" file="${61PortletDir}/docroot/WEB-INF/liferay-portlet.xml" 	todir="${62PortletDir}/docroot/WEB-INF" />
		<copy overwrite="true" file="${61PortletDir}/docroot/WEB-INF/faces-config.xml" 		todir="${62PortletDir}/docroot/WEB-INF" />
		<copy overwrite="true" file="${61PortletDir}/docroot/WEB-INF/jboss-deployment-structure.xml" 	todir="${62PortletDir}/docroot/WEB-INF" />
		<!--<copy overwrite="true" file="${61PortletDir}/docroot/WEB-INF/liferay-plugin-package.properties" 	todir="${62PortletDir}/docroot/WEB-INF" />-->
		<copy overwrite="true" file="${61PortletDir}/docroot/WEB-INF/web.xml" 				todir="${62PortletDir}/docroot/WEB-INF" />
		
		<replaceregexp file="${62PortletDir}/docroot/WEB-INF/liferay-hook.xml" match="DTD Hook 6.1.0" replace="DTD Hook 6.2.0" flags="g" byline="true" />
		<replaceregexp file="${62PortletDir}/docroot/WEB-INF/liferay-hook.xml" match="liferay-hook_6_1_0.dtd" replace="liferay-hook_6_2_0.dtd" flags="g" byline="true" />
		
		<replaceregexp file="${62PortletDir}/docroot/WEB-INF/liferay-portlet.xml" match="DTD Portlet Application 6.1.0" replace="DTD Portlet Application 6.2.0" flags="g" byline="true" />
		<replaceregexp file="${62PortletDir}/docroot/WEB-INF/liferay-portlet.xml" match="liferay-portlet-app_6_1_0.dtd" replace="liferay-portlet-app_6_2_0.dtd" flags="g" byline="true" />
		<replaceregexp file="${62PortletDir}/docroot/WEB-INF/liferay-portlet.xml" match="&lt;instanceable&gt;(.*?)&lt;/instanceable&gt;" replace="&lt;requires-namespaced-parameters&gt;false&lt;/requires-namespaced-parameters&gt;" flags="g" byline="true" />

		<replaceregexp file="${62PortletDir}/docroot/WEB-INF/liferay-display.xml" match="DTD Display 6.1.0" replace="DTD Display 6.2.0" flags="g" byline="true" />
		<replaceregexp file="${62PortletDir}/docroot/WEB-INF/liferay-display.xml" match="liferay-display_6_1_0.dtd" replace="liferay-display_6_2_0.dtd" flags="g" byline="true" />
		
	</target>
	
	<target name="NGeP-bizBaseClient">
		<jar jarfile="${62PortletDir}/docroot/WEB-INF/lib/NGeP-bizBaseClient.jar" >
			<fileset dir="../../../NGeP-bizBaseClient/bin" />                
		</jar>
  	</target>

	<target name="NGeP-bizRemoteClient"> 
		<jar jarfile="${62PortletDir}/docroot/WEB-INF/lib/NGeP-bizRemoteClient.jar" >
			<fileset dir="../../../NGeP-bizRemoteClient/bin" />                
		</jar>
  	</target>
	
	<target name="NGeP-bpmBaseClient">
		<jar jarfile="${62PortletDir}/docroot/WEB-INF/lib/NGeP-bpmBaseClient.jar" >
			<fileset dir="../../../NGeP-bpmBaseClient/bin" />
		</jar>
  	</target>

	<target name="NGeP-bpmRemoteClient">
		<jar jarfile="${62PortletDir}/docroot/WEB-INF/lib/NGeP-bpmRemoteClient.jar" >
			<fileset dir="../../../NGeP-bpmRemoteClient/bin" />
		</jar>
  	</target>
	
	<target name="NGeP-bpm-schema">
		<jar jarfile="${62PortletDir}/docroot/WEB-INF/lib/NGeP-bpm-schema.jar" >
			<fileset dir="../../../NGeP-bpm-schema/bin" />
		</jar>
  	</target>
  	
  	<target name="NGeP-portlet-deployment-assembly" 
  		depends="NGeP-bizBaseClient, NGeP-bizRemoteClient, NGeP-bpmBaseClient, NGeP-bpmRemoteClient, NGeP-bpm-schema" /> 
  		
	<target name="delete-ngep-jar-after-war-62">
		<delete file="${62PortletDir}/docroot/WEB-INF/lib/NGeP-bizBaseClient.jar" />
		<delete file="${62PortletDir}/docroot/WEB-INF/lib/NGeP-bizRemoteClient.jar" />
		<delete file="${62PortletDir}/docroot/WEB-INF/lib/NGeP-bpmBaseClient.jar" />
		<delete file="${62PortletDir}/docroot/WEB-INF/lib/NGeP-bpmRemoteClient.jar" />
		<delete file="${62PortletDir}/docroot/WEB-INF/lib/NGeP-bpm-schema.jar" />
	</target>
	 
	<target name="war-62">
		<ant antfile="build.xml" dir="${62PortletDir}" inheritAll="false" target="war"></ant>
	</target>
	
</project>