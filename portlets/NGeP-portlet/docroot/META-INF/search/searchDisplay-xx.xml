<bean id="CM_COLOR" class="my.ep.web.bean.LovBean">
	<property name="pk" value="colorId" />

	<property name="daoClass" value="my.ep.persistence.dao.cm.catalog.ColorDAO" />
	<!-- <property name="searchMethod" value="findColor" /> -->
	<property name="columns">
		<list>
			<bean class="my.ep.web.bean.LovColumnBean">
		        <property name="columnName" 	value="colorName" />
      			<property name="bundleFile" 	value="messageprovider-config.bundles.labels.labels" />
      			<property name="bundleKey" 		value="lbl.cm.color.name" />
      			<property name="columnWidth" 	value="150" />
      			<!-- <property name="columnTitle" 	value="Color Name" /> -->
			</bean>
			<bean class="my.ep.web.bean.LovColumnBean">
		        <property name="columnName" 	value="colorCode" />
      			<property name="bundleFile" 	value="messageprovider-config.bundles.labels.labels" />
      			<property name="bundleKey" 		value="lbl.cm.color.code" />
      			<property name="columnWidth" 	value="150" />
      			<!-- <property name="columnTitle" 	value="Color Code" /> -->
			</bean>
		</list>
	</property>
</bean>

