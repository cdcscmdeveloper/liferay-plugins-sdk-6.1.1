<jboss-ejb-client xmlns="urn:jboss:ejb-client:1.2">
	<client-context deployment-node-selector="my.ep.util.nodeselector.LocalNodeSelector">
		<ejb-receivers exclude-local-receiver="true">
			<remoting-ejb-receiver outbound-connection-ref="remote-ejb-connection-node1" />
		</ejb-receivers>
		<clusters>
            <cluster name="ejb" connect-timeout="15000" security-realm="ejb-security-realm" username="ejbapps">
                <connection-creation-options>
                    <property name="org.xnio.Options.SSL_ENABLED" value="false" />
                    <property name="org.xnio.Options.SASL_POLICY_NOANONYMOUS" value="false" />
					<property name="org.xnio.Options.SASL_POLICY_NOPLAINTEXT" value="false" />
                </connection-creation-options>
            </cluster>
        </clusters>
	</client-context>
</jboss-ejb-client>