<?xml version="1.0"?>

<faces-config
    version="2.0"
    xmlns="http://java.sun.com/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_2_0.xsd">

	<managed-bean>
		<description>Report Constants</description>
		<managed-bean-name>ReportConst</managed-bean-name>
		<managed-bean-class>my.ep.web.constant.report.ReportConst</managed-bean-class>
		<managed-bean-scope>application</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<description>SM Report Constants</description>
		<managed-bean-name>SmReportConst</managed-bean-name>
		<managed-bean-class>my.ep.web.constant.report.SmReportConst</managed-bean-class>
		<managed-bean-scope>application</managed-bean-scope>
	</managed-bean>
	
</faces-config>