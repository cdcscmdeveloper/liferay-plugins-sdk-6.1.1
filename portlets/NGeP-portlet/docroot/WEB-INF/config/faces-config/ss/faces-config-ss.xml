<?xml version="1.0"?>

<faces-config version="2.0" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_2_0.xsd">
	<navigation-rule>
		<from-view-id>*</from-view-id>

		<navigation-case>
			<from-outcome>createSimpleQuoteBid</from-outcome>
			<to-view-id>/xhtml/ss/directpurchase/common/simpleQuoteGroupTab.xhtml</to-view-id>
			<redirect />
		</navigation-case>
	</navigation-rule>
	<navigation-rule>
		<from-view-id>*</from-view-id>
		<navigation-case>
			<from-outcome>directPurchase</from-outcome>
			<to-view-id>/xhtml/ss/directpurchase/directPurchase.xhtml</to-view-id>
			<redirect />
		</navigation-case>
	</navigation-rule>
	<navigation-rule>
		<from-view-id>*</from-view-id>
		<navigation-case>
			<from-outcome>taskListView</from-outcome>
			<to-view-id>/xhtml/tasklist/taskListView.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	<navigation-rule>
		<from-view-id>*</from-view-id>
		<navigation-case>
			<from-outcome>quoteBidSupplier</from-outcome>
			<to-view-id>/xhtml/ss/directpurchase/simpleQuoteBidSupplier.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<converter>
		<converter-id>approverConverter</converter-id>
		<converter-class>my.ep.web.ss.converter.ApproverPickListConverter</converter-class>
	</converter>
	<converter>
		<converter-id>procurementTypeConverter</converter-id>
		<converter-class>my.ep.web.ss.converter.ProcumentTypeConverter</converter-class>
	</converter>
	<converter>
		<converter-id>justificationTypeConverter</converter-id>
		<converter-class>my.ep.web.ss.converter.JustificationTypeConverter</converter-class>
	</converter>
	<managed-bean>
		<description>Sourcing Constants</description>
		<managed-bean-name>SourcingConstants</managed-bean-name>
		<managed-bean-class>my.ep.constant.ss.SourcingConstants</managed-bean-class>
		<managed-bean-scope>application</managed-bean-scope>
	</managed-bean>
</faces-config>

