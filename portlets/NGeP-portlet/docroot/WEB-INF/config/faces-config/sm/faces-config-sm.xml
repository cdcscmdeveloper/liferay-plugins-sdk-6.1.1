<?xml version="1.0"?>

<faces-config version="2.0" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_2_0.xsd">
	<navigation-rule>
		<from-view-id>*</from-view-id>

		<navigation-case>
			<from-outcome>editSmPersonnel</from-outcome>
			<to-view-id>/xhtml/sm/userProfileMaintenance/editSelSmUserProfile.xhtml</to-view-id>
			<redirect />
		</navigation-case>
		<navigation-case>
			<from-outcome>smUserManagementHome</from-outcome>
			<to-view-id>/xhtml/sm/userProfileMaintenance/userProfileSearch.xhtml</to-view-id>
			<redirect />
		</navigation-case>
		<navigation-case>
			<from-outcome>basicSmUser</from-outcome>
			<to-view-id>/xhtml/sm/userProfileMaintenance/basicUserProfile.xhtml</to-view-id>
			<redirect />
		</navigation-case>
		<navigation-case>
			<from-outcome>cancelPendingAcknowledgePage</from-outcome>
			<to-view-id>/xhtml/sm/deletePendingMofAppln/cancelPendingAcknowledgePage.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<managed-bean>
		  <description>Disciplinary Action Status Constants</description>
		  <managed-bean-name>DisciplinaryActionConst</managed-bean-name>
		  <managed-bean-class>my.ep.constant.sm.DisciplinaryActionConst</managed-bean-class>
		  <managed-bean-scope>application</managed-bean-scope>
 	</managed-bean>
</faces-config>

