<?xml version="1.0"?>

<faces-config version="2.0" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_2_0.xsd">


	<converter>
		<converter-id>cmType</converter-id>
		<converter-class>my.ep.web.vo.CmTypeConverter</converter-class>
	</converter>

	<converter>
		<converter-id>cmBrand</converter-id>
		<converter-class>my.ep.web.vo.CmBrandConverter</converter-class>
	</converter>

	<converter>
		<converter-id>cmMeasurement</converter-id>
		<converter-class>my.ep.web.vo.CmMeasurementConverter</converter-class>
	</converter>

	<converter>
		<converter-id>cmColor</converter-id>
		<converter-class>my.ep.web.vo.CmColorConverter</converter-class>
	</converter>

	<navigation-rule>
		<from-view-id>*</from-view-id>

		<navigation-case>
			<from-outcome>extensionSearch</from-outcome>
			<to-view-id>/xhtml/cm/codification/extensionSearch.xhtml</to-view-id>
		</navigation-case>


		<navigation-case>
			<from-outcome>codificationView</from-outcome>
			<to-view-id>/xhtml/cm/codification/codificationView.xhtml</to-view-id>
			<redirect />
		</navigation-case>
		
		<navigation-case>
			<from-outcome>preRenderCodificationView</from-outcome>
			<to-view-id>/xhtml/cm/codification/preRenderCodificationView.xhtml</to-view-id>
			<redirect />
		</navigation-case>

		<navigation-case>
			<from-outcome>addCatalogItem</from-outcome>
			<to-view-id>/xhtml/cm/catalogue/addCatalogView.xhtml</to-view-id>
		</navigation-case>
		
		<navigation-case>
			<from-outcome>editCatalogItem</from-outcome>
			<to-view-id>/xhtml/cm/catalogue/addCatalogEdit.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>catalogueMaintenanceFile</from-outcome>
			<to-view-id>/xhtml/cm/catalogue/catalogMaintenanceFile.xhtml</to-view-id>
			<redirect />
		</navigation-case>

		<navigation-case>
			<from-outcome>taskListView</from-outcome>
			<to-view-id>/xhtml/bpmtasklist/taskListView.xhtml</to-view-id>
		</navigation-case>


		<navigation-case>
			<from-outcome>BPMtesting</from-outcome>
			<to-view-id>/xhtml/common/acknowledge.xhtml</to-view-id>
		</navigation-case>


		<navigation-case>
			<from-outcome>reviewUnspscCode</from-outcome>
			<to-view-id>/xhtml/cm/codification/reviewUnspscCode.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>reviewBeforeCreateTempCode</from-outcome>
			<to-view-id>/xhtml/cm/codification/reviewBeforeCreateTempCode.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>reviewBeforeCreateExtCode</from-outcome>
			<to-view-id>/xhtml/cm/codification/reviewBeforeCreateExtCode.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>cmSupplierZoneMaintenance</from-outcome>
			<to-view-id>/xhtml/cm/zm/zmHome.xhtml</to-view-id>
			<redirect />
		</navigation-case>





	</navigation-rule>
</faces-config>