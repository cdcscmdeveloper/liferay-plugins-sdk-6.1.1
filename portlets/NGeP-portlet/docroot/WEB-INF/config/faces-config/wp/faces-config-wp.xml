<?xml version="1.0"?>

<faces-config
    version="2.0"
    xmlns="http://java.sun.com/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_2_0.xsd">
	
	<managed-bean>
        <managed-bean-name>DisplayInformation</managed-bean-name>
        <managed-bean-class>my.ep.web.portal.information.DisplayInformation</managed-bean-class>
        <managed-bean-scope>request</managed-bean-scope>
    </managed-bean>
    <managed-bean>
        <managed-bean-name>HelpDisplay</managed-bean-name>
        <managed-bean-class>my.ep.web.portal.help.HelpDisplay</managed-bean-class>
        <managed-bean-scope>request</managed-bean-scope>
    </managed-bean>
    <managed-bean>
        <managed-bean-name>SearchHelp</managed-bean-name>
        <managed-bean-class>my.ep.web.portal.help.SearchHelp</managed-bean-class>
        <managed-bean-scope>request</managed-bean-scope>
        <managed-property>
            <property-name>helpSearch</property-name>
            <value>#{param.helpSearch}</value>
        </managed-property>
    </managed-bean>
    <managed-bean>
        <managed-bean-name>AllHelpDisplay</managed-bean-name>
        <managed-bean-class>my.ep.web.portal.help.AllHelpDisplay</managed-bean-class>
        <managed-bean-scope>request</managed-bean-scope>
        <managed-property>
            <property-name>helpCount</property-name>
            <value>#{param.helpcount}</value>
        </managed-property>
    </managed-bean>
    <managed-bean>
        <managed-bean-name>ForgotLogin</managed-bean-name>
        <managed-bean-class>my.ep.web.portal.login.ForgotLogin</managed-bean-class>
        <managed-bean-scope>request</managed-bean-scope>
    </managed-bean>
	<navigation-rule>
   		<from-view-id>/xhtml/wp/onlinehelpdisplay/displayOnlineHelp.xhtml</from-view-id>
   		<navigation-case>
	      	<from-action>#{AllHelpDisplay.processPage}</from-action>
	      	<from-outcome>page</from-outcome>
	      	<to-view-id>/xhtml/wp/onlinehelpdisplay/displayContent.xhtml</to-view-id>
	   	</navigation-case>
	</navigation-rule>
	<navigation-rule>
	   	<from-view-id>/xhtml/wp/onlinehelpdisplay/displayOnlineHelp.xhtml</from-view-id>
	   	<navigation-case>
	      	<from-action>#{SearchHelp.searchcontent}</from-action>
	      	<from-outcome>search</from-outcome>
	      	<to-view-id>/xhtml/wp/onlinehelpdisplay/displayResult.xhtml</to-view-id>
	   	</navigation-case>
	</navigation-rule>
	<navigation-rule>
	   	<from-view-id>/xhtml/wp/onlinehelpdisplay/displayResult.xhtml</from-view-id>
	   	<navigation-case>
	      	<from-action>#{SearchHelp.searchcontent}</from-action>
	      	<from-outcome>search</from-outcome>
	      	<to-view-id>/xhtml/wp/onlinehelpdisplay/displayResult.xhtml</to-view-id>
	   	</navigation-case>
	</navigation-rule>	
	<navigation-rule>
	   	<from-view-id>/xhtml/wp/onlinehelpdisplay/displayContent.xhtml</from-view-id>
	   	<navigation-case>
	      	<from-action>#{SearchHelp.searchcontent}</from-action>
	      	<from-outcome>search</from-outcome>
	      	<to-view-id>/xhtml/wp/onlinehelpdisplay/displayResult.xhtml</to-view-id>
	   	</navigation-case>
	</navigation-rule>
</faces-config>