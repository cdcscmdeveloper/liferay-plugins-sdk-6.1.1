<?xml version="1.0"?>

<faces-config version="2.0" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_2_0.xsd">
	<navigation-rule>
		<from-view-id>*</from-view-id>

		<navigation-case>
			<from-outcome>createSimpleQuoteBid</from-outcome>
			<to-view-id>/xhtml/sc/directpurchase/common/simpleQuoteGroupTab.xhtml</to-view-id>
			<redirect />
		</navigation-case>
	</navigation-rule>
	<navigation-rule>
		<from-view-id>*</from-view-id>
		<navigation-case>
			<from-outcome>directPurchase</from-outcome>
			<to-view-id>/xhtml/sc/directpurchase/directPurchase.xhtml</to-view-id>
			<redirect />
		</navigation-case>
	</navigation-rule>
	<navigation-rule>
		<from-view-id>*</from-view-id>
		<navigation-case>
			<from-outcome>taskListView</from-outcome>
			<to-view-id>/xhtml/tasklist/taskListView.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	<navigation-rule>
		<from-view-id>*</from-view-id>
		<navigation-case>
			<from-outcome>quoteBidSupplier</from-outcome>
			<to-view-id>/xhtml/sc/directpurchase/simpleQuoteBidSupplier.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	<navigation-rule>
		<from-view-id>*</from-view-id>
		<navigation-case>
			<from-outcome>requestNote</from-outcome>
			<to-view-id>/xhtml/sc/directpurchase/requestList.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	<navigation-rule>
		<from-view-id>*</from-view-id>
		<navigation-case>
			<from-outcome>commonRequestNote</from-outcome>
			<to-view-id>/xhtml/sc/directpurchase/common/commonRequestNote.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
    <navigation-rule>
		<from-view-id>*</from-view-id>
		<navigation-case>
			<from-outcome>prInquiryMain</from-outcome>
			<to-view-id>/xhtml/sc/directpurchase/prInquiryMain.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	<navigation-rule>
		<from-view-id>*</from-view-id>
		<navigation-case>
			<from-outcome>purchaseInDefaultMain</from-outcome>
			<to-view-id>/xhtml/sc/directpurchase/purchaseInDefaultMain.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<navigation-rule>
		<from-view-id>*</from-view-id>
		<navigation-case>
			<from-outcome>catalogueSearch</from-outcome>
			<to-view-id>/xhtml/cm/catalogue/supplierItemView.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<navigation-rule>
		<from-view-id>*</from-view-id>
		<navigation-case>
			<from-outcome>simpleQuote</from-outcome>
			<to-view-id>/xhtml/sc/directpurchase/simpleQuote.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
   <navigation-rule>
		<from-view-id>*</from-view-id>
		<navigation-case>
			<from-outcome>acknowledge</from-outcome>
			<to-view-id>/xhtml/shared/acknowledge.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	 <navigation-rule>
		<from-view-id>*</from-view-id>
		<navigation-case>
			<from-outcome>supplerView</from-outcome>
			<to-view-id>/xhtml/sc/directpurchase/supplierViewMain.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<navigation-rule>
		<from-view-id>*</from-view-id>
		<navigation-case>
			<from-outcome>requestNoteByZone</from-outcome>
			<to-view-id>/xhtml/sc/directpurchase/requestNoteByZone.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<converter>
		<converter-id>procurementTypeConverter</converter-id>
		<converter-class>my.ep.web.sc.converter.ProcumentTypeConverter</converter-class>
	</converter>
	<converter>
		<converter-id>justificationTypeConverter</converter-id>
		<converter-class>my.ep.web.sc.converter.JustificationTypeConverter</converter-class>
	</converter>
	<converter>
		<converter-id>sourcingItemConverter</converter-id>
		<converter-class>my.ep.web.sc.converter.SourcingItemPickListConverter</converter-class>
	</converter>
	<converter>
		<converter-id>longConverter</converter-id>
		<converter-class>my.ep.web.sc.converter.LongConverter</converter-class>
	</converter>
	<managed-bean>
		<description>Sourcing Constants</description>
		<managed-bean-name>SourcingConstants</managed-bean-name>
		<managed-bean-class>my.ep.constant.sc.SourcingConstants</managed-bean-class>
		<managed-bean-scope>application</managed-bean-scope>
	</managed-bean>
	<managed-bean>
		<description>QT Status Constants</description>
		<managed-bean-name>QTStatusConst</managed-bean-name>
		<managed-bean-class>my.ep.constant.sc.QTStatusConst</managed-bean-class>
		<managed-bean-scope>application</managed-bean-scope>
	</managed-bean>
	<managed-bean>
		<description>DP Status Constants</description>
		<managed-bean-name>DPStatusConstants</managed-bean-name>
		<managed-bean-class>my.ep.constant.sc.DPStatusConstants</managed-bean-class>
		<managed-bean-scope>application</managed-bean-scope>
	</managed-bean>
</faces-config>

