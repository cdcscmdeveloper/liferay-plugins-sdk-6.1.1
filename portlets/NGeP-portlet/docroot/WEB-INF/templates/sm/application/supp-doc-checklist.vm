<html>
<body>

<table style="width: 100%;">
	<tr>
		<td style="background-color:gray;color:white;font-size: 14px;font-weight: bold;">
			$header $applNo
		</td>
	</tr>
	<tr><td height="10"></td></tr>
	<tr>
		<td>
			$note1<br /> 
			$note2<br /> 
			$note3<br />
		</td>
	</tr>

</table>

<br />

<table style="width: 100%;">
	<tr>
		<td style="width: 33%">
			<table>
				<tr>
					<td>$peninAddr1</td>
				</tr>
				<tr>
					<td style="padding-top: 10px;">$peninAddr2</td>
				</tr>
			</table>
		</td>

		<td style="width: 33%">
			<table>
				<tr>
					<td>$sabahAddr1</td>
				</tr>
				<tr>
					<td style="padding-top: 10px;">$sabahAddr2</td>
				</tr>
			</table>
		</td>
		<td style="width: 33%">
			<table>
				<tr>
					<td>$sarawakAddr1</td>
				</tr>
				<tr>
					<td style="padding-top: 10px;">$sarawakAddr2</td>
				</tr>
			</table>
		</td>
	</tr>
</table>

<br />

<table style="width: 100%;" border="1">
	<tr>
		<td style="background-color:gray;color:white;font-size: 14px;font-weight: bold;">
			No.
		</td>
		<td style="background-color:gray;color:white;font-size: 14px;font-weight: bold;">
			$docDesc
		</td>
		#if ($responseType == "PO_INQUIRY")
		<td style="background-color:gray;color:white;font-size: 14px;font-weight: bold;">
			$poRemarks
		</td>
		#end
	</tr>
	
	#foreach($suppDoc in $supportDocs)
		
		<tr>
			<td style="font-size: 14px;">
				$velocityCount
			</td>
			<td style="font-size: 14px;white-space: normal;">
				$suppDoc.pmDocument.docName
			</td>
			#if ($responseType == "PO_INQUIRY")
			<td style="font-size: 14px;white-space: normal;">
				$suppDoc.poRemarks
			</td>
			#end
		</tr>
		
	#end
</table>

</body>
</html>