#parse("templates/sm/questionnaire/shared/header.vm")

	<table>
		<tr align='left'>
	        <td> <br/><br/>$title <br/><br/></td>
		</tr>
	</table>
	
	<table>
		<tr align='left'>
	        <td> $feedbacknote1 <br/><br/></td>
		</tr>
	</table>

	<table>
		<tr align='left'>
        	<td> $feedbacknote2 <br/><br/><br/></td>
		</tr>
	</table>
	
	<table>
		<tr align="left">
			<td class="txtBold" width="15%">Business / Company Name </td>
			<td width="5%">:</td>
			<td width="20%"> $companyName </td>
			<td width="5%"> </td>
			
			<td class="txtBold" width="15%">MOF No. </td>
			<td width="5%">:</td>
			<td width="20%"> $mof </td>
			<td width="5%"> </td>
			<br/><br/>
		</tr>
		
		<tr align="left">
			<td class="txtBold" width="15%">Application Reference No. </td>
			<td width="5%">:</td>
			<td width="20%"> $applNo </td>
			<td width="5%"> </td>
			
			<td class="txtBold" width="15%">Type of Application </td>
			<td width="5%">:</td>
			<td width="20%"> $applType </td>
			<td width="5%"> </td>
			<br/><br/>
		</tr>
		
	</table>
		
	<table>
		
		<tr>
			##Loop Question 
			<td> <br/><br/>
			#foreach($ques in $question)
				<tr>
					<td >$velocityCount.</td>
					<td >$!ques.smQuestion.questionValue</td>
					
				</tr>
				<tr> 
					<td>

					</td>
					<td>
					#if ($ques.smQuestion.smAnswerCategory.answerCategoryId == 2) 
						$!ques.otherRemark
					#else 
						#foreach($answerid  in $ques.smQuestion.smAnswerCategory.smAnswers) 
							#if($ques.smQuestion.smAnswerCategory.answerCategoryId == 3) ##soalan no1,no4- no11 
								#if($!answerid.answerId == 1)
									#if($ques.smAnswer.answerId == 1)
										<img src='$hostUrl/NGeP-portlet/css/images/radio_checked.png' width="8px" height ="8px"></img> 
									#else
										<img src='$hostUrl/NGeP-portlet/css/images/radio_unchecked.png' width="8px" height ="8px"></img> 
									#end
								#else	
									#if($ques.smAnswer.answerId == 2)
										<img src='$hostUrl/NGeP-portlet/css/images/radio_checked.png' width="8px" height ="8px"></img> 
									#else
										<img src='$hostUrl/NGeP-portlet/css/images/radio_unchecked.png' width="8px" height ="8px"></img> 
									#end								
								#end
		
							#elseif($ques.smQuestion.smAnswerCategory.answerCategoryId == 4) ##soalan no3
								#if($!answerid.answerId == 3)
									#if($ques.smAnswer.answerId == 3)
										<img src='$hostUrl/NGeP-portlet/css/images/radio_checked.png' width="8px" height ="8px"></img> 
									#else
										<img src='$hostUrl/NGeP-portlet/css/images/radio_unchecked.png' width="8px" height ="8px"></img> 
									#end
								#else
									#if($ques.smAnswer.answerId == 4)
										<img src='$hostUrl/NGeP-portlet/css/images/radio_checked.png' width="8px" height ="8px"></img> 
									#else
										<img src='$hostUrl/NGeP-portlet/css/images/radio_unchecked.png' width="8px" height ="8px"></img> 
									#end
								#end
						
							#elseif($ques.smQuestion.smAnswerCategory.answerCategoryId == 5) ##soalan no2	
								#if($!answerid.answerId == 5)
									#if($ques.smAnswer.answerId == 5)
										<img src='$hostUrl/NGeP-portlet/css/images/radio_checked.png' width="8px" height ="8px"></img> 
									#else
										<img src='$hostUrl/NGeP-portlet/css/images/radio_unchecked.png' width="8px" height ="8px"></img> 
									#end
								#elseif($!answerid.answerId != 5 && $!answerid.answerId != 7 && $!answerid.answerId != 8)
									#if($ques.smAnswer.answerId == 6)
										<img src='$hostUrl/NGeP-portlet/css/images/radio_checked.png' width="8px" height ="8px"></img> 
									#else
										<img src='$hostUrl/NGeP-portlet/css/images/radio_unchecked.png' width="8px" height ="8px"></img> 
									#end
								#elseif($!answerid.answerId != 5 && $!answerid.answerId != 6 && $!answerid.answerId != 8)
									#if($ques.smAnswer.answerId == 7)
										<img src='$hostUrl/NGeP-portlet/css/images/radio_checked.png' width="8px" height ="8px"></img> 
									#else
										<img src='$hostUrl/NGeP-portlet/css/images/radio_unchecked.png' width="8px" height ="8px"></img> 
									#end
								#elseif($!answerid.answerId != 5 && $!answerid.answerId != 6 && $!answerid.answerId != 7)
									#if($ques.smAnswer.answerId == 8)
										<img src='$hostUrl/NGeP-portlet/css/images/radio_checked.png' width="8px" height ="8px"></img> 
									#else
										<img src='$hostUrl/NGeP-portlet/css/images/radio_unchecked.png' width="8px" height ="8px"></img> 
									#end
								#end
							#else
							#end
							$!answerid.answerDesc
						#end 
						<br/>
					#end
				<br/><br/></td>
				</tr>
				#end
			</td>
		</tr>
		
	  
	</table>

#include("templates/sm/questionnaire/shared/footer.vm")