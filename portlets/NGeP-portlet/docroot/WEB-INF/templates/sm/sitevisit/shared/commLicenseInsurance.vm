<u class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.sitevisit.printing.license.insurance')</u>
<table class="sTable">
	#if($review)
		<tr>
			<th class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.sitevisit.printing.license.insurance')</th>
			<th>$smVmUtil.getDescByLabel('lbl.sm.license.closingexpiry.date')</th>
		</tr>
		#if($licenseInsurance != $null && $licenseInsurance.size() > 0)
			#foreach($licenseIns in $licenseInsurance)
				<tr>
					<td>$smVmUtil.getParameterDesc($!licenseIns.pmParameter)</td>
					<td>$!smVmUtil.formatDate($!licenseIns.expDate)</td>
				</tr>
			#end
		#end
	#else	
		#if($licenseInsurance != $null && $licenseInsurance.size() > 0)
			#foreach($licenseIns in $licenseInsurance)
			<tr>
				<td width="40%" class="txtBold"><br /></td>
				<td class="txtBold">$licenseIns.codeName</td>
			</tr>
			#end
		#end
	#end
</table>