	<tr>
		<td width="40%" class="txtBold"><br /></td>
		<td class="txtBold" width="40%">$smVmUtil.getDescByLabel('lbl.sm.sitevist.premiseloc.others')</td>
		#if($review)<td>#if($facility.otherEnv)$smVmUtil.getDescByLabel('lbl.sm.sme.txt.yes') - $facility.otherEnvRemark #else $smVmUtil.getDescByLabel('lbl.sm.sme.txt.no') #end</td>#end
