<u class="txtBold">Machine/Equipment List</u>
<br /><br />


<table class="descTable" width="100%">
		<tr style="background-color:#99ccff;" align="center">
			<th width="5%" class="txtBold">No</th>
			<th width="25%" class="txtBold">Type of Machine/Equipment</th>
			<th width="20%" class="txtBold">Brand</th>
			<th width="10%" class="txtBold">Function</th>
			<th width="10%" class="txtBold">Qty</th>
			<th width="10%" class="txtBold">Value(RM)</th>
			<th width="10%" class="txtBold">Purchasing/Method</th>
			<th width="10%" class="txtBold">Guarantor Name</th>
		</tr>
		
		#if($machineLs.size() > 0)
			#foreach($machine in $machineLs)
			<tr>
				<td>$velocityCount</td>
				<td>$!machine.machineType</td>
				<td>$!machine.brandName</td>
				<td>$!machine.machineFunction</td>
				<td>$!machine.qty</td>
				<td style="text-align:right">
				#if($machine.value) 
					$smVmUtil.formatToTwoDecimalPoint($machine.value)
				#end
				</td>
				<td>
					$purchaseMethodMap.get($machine.purchaseMethod)
				</td>
				<td>$!machine.guarantorName</td>
			</tr>
			#end
		#else
			<tr>
				<td colspan="8" align="center">No Record Found</td>
			</tr>
		#end
</table>