<u class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.employee.employee')</u>
<br /><br />

<table  class="descTable" width="100%">
		<tr style="background-color:#99ccff;" align="center">
			<th width="5%">No.</th>
			<th width="25%">$smVmUtil.getDescByLabel('lbl.sm.employee.specialization')</th>
			<th width="25%">$smVmUtil.getDescByLabel('lbl.sm.employee.name')</th>
			<th width="20%">$smVmUtil.getDescByLabel('lbl.sm.worker.icno')</th>
			<th width="25%">$smVmUtil.getDescByLabel('lbl.sm.worker.experience')</th>
		</tr>
		
		
		#if($review)
			#if($workerLs != $null && $workerLs.size() > 0)
				#foreach($worker in $workerLs)
				<tr>
					<td width="5%">$velocityCount</td>
					<td width="25%">$!worker.expertise</td>
					<td width="25%">$!worker.name</td>
					<td width="20%">$!worker.identificationNo</td>
					<td width="25%">$!worker.workExpYear</td>
				</tr>
				#end
			#else
				<tr>
		 			<td colspan="5" align="center">$smVmUtil.getDescByLabel('lbl.datatable.msg.no.records.found')</td>
		 		</tr>
			#end
		#else
		 	<tr>
		 		<td colspan="5" align="center">$smVmUtil.getDescByLabel('lbl.datatable.msg.no.records.found')</td>
		 	</tr>
		#end
</table>