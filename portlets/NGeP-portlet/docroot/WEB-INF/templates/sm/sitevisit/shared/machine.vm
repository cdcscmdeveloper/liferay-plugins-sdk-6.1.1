<u class="txtBold">Machine/Equipment List</u>
<br /><br />


<table class="descTable" width="100%">
		<tr style="background-color:#99ccff;" align="center">
			<th width="5%" class="txtBold">No</th>
			<th width="20%" class="txtBold">Type of Machine/Equipment</th>
			<th width="15%" class="txtBold">Brand</th>
			<th width="20%" class="txtBold">Function</th>
			<th width="10%" class="txtBold">Qty</th>
			<th width="10%" class="txtBold">Value(RM)</th>
			<th width="10%" class="txtBold">Purchasing/Method</th>
			<th width="10%" class="txtBold">Guarantor Name</th>
		</tr>
	
		#if($machineLs.size() > 0)
			#foreach($svmachine in $machineLs)
			<tr>
				<td>$velocityCount</td>
				#if($!svmachine.machine.machineDes)
					<td>$!svmachine.machineType</td>
				#else
					<td>$!svmachine.machine.machineDesc</td>
				#end
				<td>$!svmachine.brandName</td>
				<td>$!svmachine.machineFunction</td>
				<td>$!svmachine.qty</td>
				<td style="text-align:right">
				#if($svmachine.value) 
					$smVmUtil.formatToTwoDecimalPoint($svmachine.value)
				#end
				</td>
				<td>
					$purchaseMethodMap.get($svmachine.purchaseMethod)
				</td>
				<td>$!svmachine.guarantorName</td>
			</tr>
			#end
		#else
			<tr>
				<td colspan="8" align="center">No Record Found</td>
			</tr>
		#end
</table>