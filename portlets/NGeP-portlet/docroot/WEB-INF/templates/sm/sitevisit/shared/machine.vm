<u class="txtBold">Machine/Equipment List</u>
<br /><br />


<table class="descTable" width="100%">
		<tr style="background-color:#99ccff;" align="center">
			<th width="5%" class="txtBold">No</th>
			<th width="20%" class="txtBold">Type of Machine/Equipment</th>
			<th width="15%" class="txtBold">Brand</th>
			<th width="20%" class="txtBold">Function</th>
			<th width="10%" class="txtBold">Qty</th>
			<th width="10%" class="txtBold">Value(RM)</th>
			<th width="10%" class="txtBold">Purchasing/Method</th>
			<th width="10%" class="txtBold">Guarantor Name</th>
		</tr>
	
		#if($machineLs.size() > 0)
			#foreach($svmachine in $machineLs)
			<tr>
				<td>$velocityCount</td>
				#if($!svmachine.smMachineDtl.machine.machineDes)
					<td>$!svmachine.smMachineDtl.machineType</td>
				#else
					<td>$!svmachine.smMachineDtl.machine.machineDesc</td>
				#end
				<td>$!svmachine.smMachineDtl.brandName</td>
				<td>$!svmachine.smMachineDtl.machineFunction</td>
				<td>$!svmachine.smMachineDtl.qty</td>
				<td style="text-align:right">
				#if($svmachine.smMachineDtl.value) 
					$smVmUtil.formatToTwoDecimalPoint($svmachine.smMachineDtl.value)
				#end
				</td>
				<td>
					$purchaseMethodMap.get($svmachine.smMachineDtl.purchaseMethod)
				</td>
				<td>$!svmachine.smMachineDtl.guarantorName</td>
			</tr>
			#end
		#else
			<tr>
				<td colspan="8" align="center">No Record Found</td>
			</tr>
		#end
</table>