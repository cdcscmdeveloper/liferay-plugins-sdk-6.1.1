<u class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.sitevisit.additional.machine')</u>
<br /><br />


<table class="descTable" width="100%">
		<tr style="background-color:#99ccff;" align="center">
			<th width="5%" class="txtBold">No</th>
			<th width="20%" class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.manufacturing.type.machine')</th>
			<th width="15%" class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.machine.brand')</th>
			<th width="20%" class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.machine.function')</th>
			<th width="10%" class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.machine.quantity')</th>
			<th width="10%" class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.machine.value')</th>
			<!--#38310 - START -->
			<th width="10%" class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.machine.purchasingMthd')</th>
      <!--#38310 - END -->
			<th width="10%" class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.machine.purchase.year')</th>
			<th width="10%" class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.machine.guarnName')</th>
		</tr>
	
		#if($addMachineLs.size() > 0)
			#foreach($svmachine in $addMachineLs)
			<tr>
				<td>$velocityCount</td>
				<td>$!svmachine.machineType</td>
				<td>$!svmachine.brandName</td>
				<td>$!svmachine.machineFunction</td>
				<td>$!svmachine.qty</td>
				<td style="text-align:right">
				#if($svmachine.value) 
					$smVmUtil.formatToTwoDecimalPoint($svmachine.value)
				#end
				</td>
				<td>$purchaseMethodMap.get($svmachine.purchaseMethod)
					#if($svmachine.purchaseMethod == 'O')
						<br /> ($!svmachine.purchaseMethodRemark)
					#end
				</td>
				<td>$!svmachine.purchaseYear</td>
				<td>$!svmachine.guarantorName</td>
			</tr>
			#set($rowCounter = $rowCounter + 1)
			#end
		#else
			<tr>
				<td colspan="9" align="center">$smVmUtil.getDescByLabel('lbl.datatable.msg.no.records.found')</td>
			</tr>
		#end
</table>