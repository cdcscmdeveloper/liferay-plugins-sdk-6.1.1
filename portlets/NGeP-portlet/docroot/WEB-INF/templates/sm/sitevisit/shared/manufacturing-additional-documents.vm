<u class="txtBold">Additional Documents</u>
<br /><br />


<table class="descTable" width="100%">
		<tr style="background-color:#99ccff;" align="center">
			<th width="5%" class="txtBold">No</th>
			<th width="35%" class="txtBold">Documents</th>
			<th width="20%" class="txtBold">Reference</th>
			<th width="10%" class="txtBold">Date Issued</th>
			<th width="30%" class="txtBold">Notes</th>
		</tr>
		
		#if($machineLs.size() > 0)
			#foreach($additionalDoc in $additionalDocLs)
			<tr>
				<td>$velocityCount</td>
				<td>$additionalDoc.docName</td>
				<td>$additionalDoc.docRef</td>
				<td>$additionalDoc.docDate</td>
				<td>$additionalDoc.remark</td>
			</tr>
			#end
		#else
			<tr>
				<td colspan="5" align="center">No Record Found</td>
			</tr>
		#end
</table>