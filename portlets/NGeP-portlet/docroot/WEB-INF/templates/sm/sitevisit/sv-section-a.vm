#parse("templates/sm/sitevisit/shared/header.vm")

<table width='100%'>
	<tr align='center' style="background-color: #3366ff;">
	    <td>
	    	<font style='color:#ffffff;font-weight: bold;'>$templateType - Section A</font>
	    </td>
    </tr>
    <tr><td><br /></td></tr>
</table>
	
<table  class="sTable">
	<tr>
		<td width="40%" class="txtBold"><u>Capital/Equity Details</u></td>
		<td></td>
		
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Authorized Capital (RM)</td>
		<td class="sColTwentyPerc">$authorizedCapital</td>
		<td class="sColTwentyPerc"><br /></td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Paid-up Capital (RM)</td>
		<td class="sColTwentyPerc">$paidUpCapital</td>
		<td class="sColTwentyPerc"><br /></td>
	</tr>
</table>
<br /><br />

<table class="sTable">
	<tr>
		<td width="40%" class="txtBold"><u>Equity</u></td>
		<td class="sColTwentyPerc"></td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Total Owner</td>
		<td class="sColTwentyPerc">$countOwner person(s)</td>
		<td class="sColTwentyPerc"></td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Bumiputera</td>
		<td class="sColTwentyPerc">RM $bumiEquity</td>
		<td class="sColTwentyPerc">$bumiEquityPct%</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Non-Bumiputera</td>
		<td class="sColTwentyPerc">RM $nonBumiEquity</td>
		<td class="sColTwentyPerc">$nonBumiEquityPct%</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Non-Malaysian</td>
		<td class="sColTwentyPerc">RM $nonMalaysianEquity</td>
		<td class="sColTwentyPerc">$nonMalaysianEquityPct%</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Gov Agency Equity/Unit Trust Agency</td>
		<td class="sColTwentyPerc">RM $govtUnitrustEquity</td>
		<td class="sColTwentyPerc">$govtUnitrustEquityPct%</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Gov Equity</td>
		<td class="sColTwentyPerc">RM $govtEquity</td>
		<td class="sColTwentyPerc">$govtEquityPct%</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Local Company</td>
		<td class="sColTwentyPerc">RM $localCompanyEquity</td>
		<td class="sColTwentyPerc">$localCompanyEquityPct%</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Foreign Company</td>
		<td class="sColTwentyPerc">RM $foreignCompanyEquity</td>
		<td class="sColTwentyPerc">$foreignCompanyEquityPct%</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold" valign="top">Owner Name</td>
		<td class="sColTwentyPerc">
		#if($ownerList.size() > 0)
			#foreach($owner in $ownerList)
		    	$velocityCount. $owner.name <br />
		  	#end
  		#end
		</td>
		<td class="sColTwentyPerc"></td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Company Name</td>
		<td class="sColTwentyPerc">
			#if($!equityCompanies and $equityCompanies.size() > 0)
				#foreach($equityCompany in $equityCompanies)
			    	$velocityCount. $equityCompany.companyName <br />
			  	#end
			#else
				NOT APPLICABLE
	  		#end		
		</td>
		<td class="sColTwentyPerc"></td>
	</tr>
</table>
<br /><br />

<table class="sTable">
	<tr>
		<td width="40%" class="txtBold"><u>Board of Directors</u></td>
		<td class="sColTwentyPerc"></td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Total</td>
		<td class="sColTwentyPerc">$totalBOD person(s)</td>
		<td class="sColTwentyPerc"></td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Bumiputera</td>
		<td class="sColTwentyPerc">$dirBumi person(s)</td>
		<td class="sColTwentyPerc">$dirBumiPct %</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Non Bumiputera</td>
		<td class="sColTwentyPerc">$dirNonBumi person(s)</td>
		<td class="sColTwentyPerc">$dirNonBumiPct %</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Non Malaysian</td>
		<td class="sColTwentyPerc">$dirNonMalaysian person(s)</td>
		<td class="sColTwentyPerc">$dirNonMalaysianPct %</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold" valign="top">Director Name</td>
		<td class="sColTwentyPerc">
		#if($bodLs.size() > 0)
			#foreach($bod in $bodLs)
		    	$velocityCount. $bod.name <br />
		  	#end
  		#end
  		#if($bodLs.size() == 0)
  			NOT APPLICABLE
  		#end
		</td>
		<td class="sColTwentyPerc"></td>
	</tr>
</table>
<br /><br/>

<table class="sTable">
	<tr>
		<td width="40%" class="txtBold"><u>Management</u></td>
		<td class="sColTwentyPerc"></td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Total</td>
		<td class="sColTwentyPerc">$totalMgmt person(s)</td>
		<td class="sColTwentyPerc"></td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Bumiputera</td>
		<td class="sColTwentyPerc">$mgmtBumi person(s)</td>
		<td class="sColTwentyPerc">$mgmtBumiPct%</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Non Bumiputera</td>
		<td class="sColTwentyPerc">$mgmtNonBumi person(s)</td>
		<td class="sColTwentyPerc">$mgmtNonBumiPct%</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Non Malaysian</td>
		<td class="sColTwentyPerc">$mgmtNonMalaysian person(s)</td>
		<td class="sColTwentyPerc">$mgmtNonMalaysianPct%</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Higher Management Name</td>
		<td class="sColTwentyPerc">
			#if($higherManagementNames.size() > 0)
				#foreach($name in $higherManagementNames)
			    	$velocityCount. $name <br />
			  	#end
	  		#end
	  		#if($higherManagementNames.size() == 0)
	  			NOT APPLICABLE
	  		#end
		</td>
		<td class="sColTwentyPerc"></td>
	</tr>
	
		<tr>
		<td width="40%" class="txtBold">Manager Name</td>
		<td class="sColTwentyPerc">
			#if($managementNames.size() > 0)
				#foreach($name in $managementNames)
			    	$velocityCount. $name <br />
			  	#end
	  		#end
	  		#if($managementNames.size() == 0)
	  			NOT APPLICABLE
	  		#end
		</td>
		<td class="sColTwentyPerc"></td>
	</tr>
</table>
<br /><br/>

<table class="sTable">
	<tr>
		<td width="40%" class="txtBold"><u>Workers</u></td>
		<td class="sColTwentyPerc"></td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Total</td>
		<td class="sColTwentyPerc">$totalWorker person(s)</td>
		<td class="sColTwentyPerc"></td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Bumiputera</td>
		<td class="sColTwentyPerc">$workerBumi person(s)</td>
		<td class="sColTwentyPerc">$workerBumiPct%</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Non Bumiputera</td>
		<td class="sColTwentyPerc">$workerNonBumi person(s)</td>
		<td class="sColTwentyPerc">$workerNonBumiPct%</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">Non Malaysian</td>
		<td class="sColTwentyPerc">$workerNonMalaysian person(s)</td>
		<td class="sColTwentyPerc">$workerNonMalaysianPct%</td>
	</tr>
	
</table>
#include("templates/sm/sitevisit/shared/footer.vm")