#parse("templates/sm/sitevisit/shared/header.vm")
	<table width='100%'>
		<tr align='center' style="background-color: #3366ff;">
	        <td>
	            <font style='color:#ffffff;font-weight: bold;font-size: 12pt;'>$templateType - Company Information</font>
	        </td>
    	</tr>
	</table>
	
	<table class="infoTable">
		<tr>
	        <td width="30%"><b>Accepted Application Date</b></td>
	        <td>$accptDate</td>
    	</tr>
    	
    	<tr>
	        <td width="30%"><b>Final Information Date</b></td>
	        <td></td>
    	</tr>
    	
    	<tr>
	        <td width="30%"><b>Company Name</b></td>
	        <td>$companyName</td>
    	</tr>
    	
    	<tr>
	        <td><br /></td>
    	</tr>
    	
    	<tr>
	        <td width="30%"><b>ROC/ROB/ROS No.</b></td>
	        <td>$busRegNo</td>
    	</tr>
    	
    	<tr>
	        <td width="30%"><b>Company Address</b></td>
	        <td>$addrLiines</td>
    	</tr>
    	
    	<tr>
	        <td><br /></td>
    	</tr>
    	
        <tr>
	        <td width="30%"><b>Postal Code</b></td>
	        <td>$postCode</td>
    	</tr>
    	
    	<tr>
	        <td width="30%"><b>Town/City</b></td>
	        <td>$townDtls</td>
    	</tr>
    	
    	<tr>
	        <td width="30%"><b>State</b></td>
	        <td>$stateDtls</td>
    	</tr>
    	
    	<tr>
    		<td width="30%"><b>District</b></td>
    		<td>$districtDtls</td>
    	</tr>
    	
   	    <tr>
	        <td width="30%"><b>MOF Registration No.</b></td>
	        <td>$mofNo</td>
    	</tr>
    	
    	<tr>
	        <td width="30%"><b>Application Reference No.</b></td>
	        <td>$applNo</td>
    	</tr>
    	
       #*	<tr>
	        <td width="30%"><b>Scheduled Date of Visit</b></td>
	        <td></td>
    	</tr>*#
    	
    	#*<tr>
	        <td width="30%"><b>Visiting Date</b></td>
	        <td></td>
    	</tr>*#
    	
    	<tr>
    		<td width="30%" valign="top"><b>Visiting Officers</b></td>
    		<td>$svOfficers</td>
    	</tr>
    	
    	<tr>
    		<td width="30%"><b>Assisting Officers</b></td>
    		<td></td>
    	</tr>
    	
    	<tr>
    		<td width="30%" valign="top"><b>Interviewed Representatives</b></td>
    		<td valign="top">
    			#if($intRepresentatives.size() != $null && $intRepresentatives.size() > 0)
    				<table>
    				#foreach($intRep in $intRepresentatives)
    					<tr><td width="50%" class="txtBold">Name</td>
    						<td>$intRep.name</td>
    					</tr>
	    				<tr><td class="txtBold">Designation</td>
	    					<td>$intRep.designation</td>
	    				</tr>
	    				<tr><td><br /></td></tr>
    				#end
    				</table>
    			#else
	    			<p class="txtBold">Name</p>
	    			<p class="txtBold">Designation</p><br />
	    			<p class="txtBold">Name</p>
	    			<p class="txtBold">Designation</p><br />
	    			<p class="txtBold">Name</p>
	    			<p class="txtBold">Designation</p><br />
    			#end
    		</td>
    	</tr>
	</table>
	<br /><br />
#include("templates/sm/sitevisit/shared/footer.vm")