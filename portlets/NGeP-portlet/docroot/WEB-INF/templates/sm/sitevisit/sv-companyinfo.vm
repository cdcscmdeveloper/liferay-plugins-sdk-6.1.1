#parse("templates/sm/sitevisit/shared/header.vm")
	<table width='100%'>
		<tr align='center' style="background-color: #3366ff;">
	        <td>
	            <font style='color:#ffffff;font-weight: bold;font-size: 12pt;'>$templateType - Company Information</font>
	        </td>
    	</tr>
	</table>
	
	<table class="infoTable">
