       #*	<tr>
	        <td width="30%"><b>Scheduled Date of Visit</b></td>
	        <td></td>
    	</tr>*#
    	
    	#*<tr>
	        <td width="30%"><b>Visiting Date</b></td>
	        <td></td>
    	</tr>*#
    	
    	<tr>
    		<td width="30%" valign="top"><b>$smVmUtil.getDescByLabel('lbl.sm.sv.templ.visiting.officer')</b></td>
    		<td>$svOfficers</td>
    	</tr>
    	
    	<tr>
    		<td width="30%"><b>$smVmUtil.getDescByLabel('lbl.sm.sv.templ.assisting.officer')</b></td>
    		<td></td>
    	</tr>
    	
    	<tr>
    		<td width="30%" valign="top"><b>$smVmUtil.getDescByLabel('lbl.sm.sv.templ.interview.representative')</b></td>
    		<td valign="top">
    			#if($intRepresentatives.size() != $null && $intRepresentatives.size() > 0)
