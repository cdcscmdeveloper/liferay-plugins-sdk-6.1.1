    						<td>$intRep.name</td>
    					</tr>
	    				<tr><td class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.sv.templ.designation')</td>
	    					<td>$intRep.designation</td>
	    				</tr>
	    				<tr><td><br /></td></tr>
    				#end
    				</table>
    			#else
	    			<p class="txtBold">Name</p>
	    			<p class="txtBold">Designation</p><br />
	    			<p class="txtBold">Name</p>
	    			<p class="txtBold">Designation</p><br />
	    			<p class="txtBold">Name</p>
	    			<p class="txtBold">Designation</p><br />
