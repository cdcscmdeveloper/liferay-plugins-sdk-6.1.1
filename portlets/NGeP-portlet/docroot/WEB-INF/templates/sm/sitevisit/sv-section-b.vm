#parse("templates/sm/sitevisit/shared/header.vm")
#set($bumi = $smVmUtil.getDescByLabel('lbl.sm.person.bumi'))
#set($nonBumi = $smVmUtil.getDescByLabel('lbl.sm.person.composition.nonBumi'))
#set($nonMy = $smVmUtil.getDescByLabel('lbl.sm.person.composition.Frg'))


<table width='100%'>
	<tr align='center' style="background-color: #3366ff;">
	    <td>
	    	<font style='color:#ffffff;font-weight: bold;'>$templateType - $smVmUtil.getDescByLabel('lbl.sm.sv.templ.section') B</font>
	    </td>
    </tr>
    <tr><td><br /></td></tr>
</table>

<table  class="sTable">
	<tr>
		<td width="40%" class="txtBold"><u>$smVmUtil.getDescByLabel('lbl.sm.sv.templ.financial')</u></td>
		<td></td>
		
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.sv.templ.cheque.signatories')</td>
		<td class="sColTwentyPerc">$totolCheqSignatory $smVmUtil.getDescByLabel('lbl.sm.sv.templ.individu')</td>
		<td class="sColTwentyPerc"><br /></td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.sv.templ.bumiputera')</td>
		<td class="sColTwentyPerc">$bumiCheqSign $smVmUtil.getDescByLabel('lbl.sm.sv.templ.individu')</td>
		<td class="sColTwentyPerc">$bumiCheqSignPct%</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.sv.templ.non.bumiputera')</td>
		<td class="sColTwentyPerc">$nonBumiCheqSign $smVmUtil.getDescByLabel('lbl.sm.sv.templ.individu')</td>
		<td class="sColTwentyPerc">$nonBumiCheqSignPct%</td>
	</tr>
	
	<tr>
		<td width="40%" class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.sv.templ.non.malaysian')</td>
		<td class="sColTwentyPerc">$nonMalaysianCheqSign $smVmUtil.getDescByLabel('lbl.sm.sv.templ.individu')</td>
		<td class="sColTwentyPerc">$nonMalaysianCheqSignPct%</td>
	</tr>
</table>
	
<table  class="sTable">
	<tr>
		<td class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.sv.templ.bank.info')</td>
	</tr>
</table>

<table>
	#foreach($bank in $bankInfo)
	<tr>
		<td valign="top">
		<table>
			<tr><td>$velocityCount.</td></tr>
		</table>
		</td>
		
		<td valign="top">
			<table>
			<tr>
				<td class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.sv.templ.bank.name')</td>
				<td>
					$bank.smSupplierBank.pmFinancialOrg.finOrgName
				</td>
			</tr>
						
			<tr>
				<td class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.sv.templ.acc.no')</td>
				<td>$bank.smSupplierBank.accountNo<br /></td>
			</tr>
			
			##14055 start - add cheque signatory status			
			<tr>
				<td class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.sv.templ.cheque.signatory.name')</td>
				#foreach($signatory in $bank.smSupplierBank.smChequeSignatories)										
					<tr>
						<td>$velocityCount. $signatory.smPersonnel.name</td>
						<td class="sColTwentyPerc"></td>
						<td width="20%" class="txtBold">Status</td>
										
						#if($signatory.smPersonnel.bumiFlg == 1)
							<td>$bumi</td> 													
						#elseif($signatory.smPersonnel.bumiFlg == 0 && $signatory.smPersonnel.pmCountry.countryCode ==	$malaysiaCode)
							<td>$nonBumi</td> 												
						#else
							<td>$nonMy</td> 										
						#end
					</tr>															
				#end				
			</tr>
			##14055 end
						
			<tr>
				<td valign="top" class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.sv.templ.term.condition')</td>
				<td valign="top">$!bank.smSupplierBank.signatureInstruction</td>
			</tr>
			
			##14055 start - change placement of the Remarks
			<tr>
				<td class="txtBold">$smVmUtil.getDescByLabel('lbl.sm.remark'):</td>
				
				##29645 start - display remark data
				##28774 - Start - set height to minimum 100px. if exceeded will become larger
				<td><p style="width: 350px;min-height: 100px;background: white;border:solid thin black;">$!bank.remark</p></td>
				##28774 - End
				##29645 end
				
			</tr>
			##14055 end
			
			</table>
		</td>		
	</tr>
	#end
</table>
<br /><br />

<table class="sTable">
	#if($review)
		<tr>
			<td class="txtBold" width="40%"><u>$smVmUtil.getDescByLabel('lbl.sm.sv.templ.check.list')</u></td>
			<td class="txtBold"><u>$smVmUtil.getDescByLabel('lbl.sm.availableLbl')</u></td>
			<td class="txtBold"><u>$smVmUtil.getDescByLabel('lbl.sm.sv.templ.remark')</u></td>
		</tr>
		#if($financialCheckList.size() > 0)
			#foreach($finCheckItem in $financialCheckList)
				<tr>
			    	<td>$smVmUtil.getParameterDesc($finCheckItem.pmParameter)</td>
			    	<td>#if($finCheckItem.valid)$smVmUtil.getDescByLabel('lbl.sm.sme.txt.yes') 
			    		#else $smVmUtil.getDescByLabel('lbl.sm.sme.txt.no') #end</td>
			    	<td>$!finCheckItem.remark</td>
			    </tr>
			<tr><td><br /></td></tr>
			#end
  		#end
	#else
		<tr>
			<td class="txtBold"><u>$smVmUtil.getDescByLabel('lbl.sm.sv.templ.check.list')</u></td>
		</tr>
		#if($financialCheckList.size() > 0)
			#foreach($finCheckItem in $financialCheckList)
			    <tr>
			    	<td><p style="width: 10px;height: 10px;background: white;border:solid thin black;" /></td>
			    	<td>$finCheckItem</td>
			    	<td valign="bottom"><p style="width: 200px; background: white;border-bottom: 1px solid black;" /></td>
			    </tr>
			#end
  		#end
	#end
</table>

#include("templates/sm/sitevisit/shared/footer.vm")