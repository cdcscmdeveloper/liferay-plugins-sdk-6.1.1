#parse("templates/sm/sitevisit/shared/header.vm")

	<table width='100%'>
		<tr align='center' style="background-color: #3366ff;">
	        <td>
	            <font style='color:#ffffff;font-weight: bold;font-size: 10pt;'>$templateType - Preparation Details</font>
	        </td>
    	</tr>
	</table>
	
	<table class="infoTable">
		<tr>
	        <td width="35%"><b>Application Reference No.</b></td>
	        <td>$applNo</td>
    	</tr>
    	
    	<tr>
	        <td width="35%"><b>Company Name</b></td>
	        <td>$companyName</td>
    	</tr>
    	
    	<tr>
	        <td><br /></td>
    	</tr>
    	
    	<tr>
	        <td width="35%"><b>Business Registration No.</b></td>
	        <td>$businessRegistrationNo</td>
    	</tr>
    	
    	<tr>
    		 <td width="35%"><b>GST Registration No.</b></td>
	        <td>$!gstRegNo</td>
    	</tr>
    	
    	<tr>
    		 <td width="35%"><b>GST Effective Date.</b></td>
	        <td>$!smVmUtil.formatDate($gstEffDate)</td>
    	</tr>
    	
    	<!--
    	<tr>
    		 <td width="35%"><b>GST Effective End Date.</b></td>
	        <td>$!smVmUtil.formatDate($gstEndDate)</td>
    	</tr>
    	-->
    	
 
	    <tr>
			 <td width="35%" valign="top"><b>Site Visit Address</b></td>
			 <td>$addressFormatter.getAddress($svAddress)</td>
		</tr>
		    	
		<tr>
			 <td width="35%"><b>Postal Code</b></td>
			 <td>$svAddress.postcode</td>
		</tr>
		    	
		<tr>
			 <td width="35%"><b>Town/City</b></td>
			 <td>$svAddress.pmCity.cityName</td>
		</tr>
		    	
		<tr>
			 <td width="35%"><b>State</b></td>
			 <td>$svAddress.pmState.stateName</td>
		 </tr>
		    	
		 <tr>
		    <td><b>Schedule Date of Visit</b></td>
		    <td>$smVmUtil.formatDate($scheduleDate)</td>
		 </tr>
		    	
		 <tr>
	        <td width="30%"><b>Visiting Date</b></td>
	    	<td>#if($actualSiteVisitDate != $null) $smVmUtil.formatDate($actualSiteVisitDate) #end</td>
    	</tr>
    	<tr>
    		<td width="35%"><b>Latitude</b></td>
    		<td>$!latitude</td>
    	</tr>
    	
    	<tr>
    		<td width="35%"><b>Longitude</b></td>
    		<td>$!longitute</td>
    	</tr>
	 
   	    <tr>
	        <td width="35%"><b>Telephone No.</b></td>
	        <td>$telNo</td>
    	</tr>
    	
       	<tr>
	        <td width="35%"><b>Visiting Purpose</b></td>
	        <td>$visitingPurpose</td>
    	</tr>
    	
    	<tr>
	        <td width="35%"><b>Contact Person Name</b></td>
	        <td>$!contactPersonName</td>
    	</tr>
    	
       <tr>
	        <td width="35%"><b>Contact Person Designation</b></td>
	        <td>$!contactPersonDesignation</td>
    	</tr>
	</table>
	<br /><br />
	
	<table class="descTable" width="100%">
		<tr style="background-color:#99ccff;" align="center">
			<th>Category Description</th>
			<th>Category Remarks</th>
		</tr>
		#if($catApplicable)
				#set($codeL1 = $catApplicable.pmCategoryL1.categoryL1Code)
				#set($codeL2 = $catApplicable.pmCategoryL2.categoryL2Code)
				#set($codeL3 = $catApplicable.pmCategoryL3.categoryL3Code)
		    	<tr>
		    	<td>
		    		$codeL1$codeL2$codeL3 : $catApplicable.pmCategoryL3.categoryName
		    		#if($catApplicable.pmCategoryL3.categoryL3Code == "99")
		    			($catApplicable.otherDesc)
		    		#end
		    	</td>
		    	<td></td></tr>
  		#else
  			<tr align="center"><td colspan="2">No records found.</td></tr>
  		#end
	</table>
	
#include("templates/sm/sitevisit/shared/footer.vm")