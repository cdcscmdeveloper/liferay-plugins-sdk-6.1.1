    	<tr>
	        <td width="35%"><b>$smVmUtil.getDescByLabel('lbl.sm.sv.templ.contact')</b></td>
	        <td>$!contactPersonName</td>
    	</tr>
    	
       <tr>
	        <td width="35%"><b>$smVmUtil.getDescByLabel('lbl.sm.sv.templ.contact.desgn')</b></td>
	        <td>$!contactPersonDesignation</td>
