	<br /><br />
	
	<table class="descTable" width="100%">
		<tr style="background-color:#99ccff;" align="center">
			<th>$smVmUtil.getDescByLabel('lbl.sm.sv.templ.cat.desc')</th>
			<th>$smVmUtil.getDescByLabel('lbl.sm.sv.templ.cat.remarks')</th>
		</tr>
		
		#if($isGroup)
			#foreach($tmp in $templates)
				#set($codeL1 = $tmp.suppCategory.pmCategoryL1.categoryL1Code)
				#set($codeL2 = $tmp.suppCategory.pmCategoryL2.categoryL2Code)
				#set($codeL3 = $tmp.suppCategory.pmCategoryL3.categoryL3Code)
		    	<tr>
		    	<td>
		    		$codeL1$codeL2$codeL3 : $tmp.suppCategory.pmCategoryL3.categoryName
		    		#if($!tmp.suppCategory.otherDesc && $!tmp.suppCategory.otherDesc != "")
		    			($!tmp.suppCategory.otherDesc)
		    		#end
		    	</td>
		    	<td></td></tr>
			#end
  		#else
  			<tr align="center"><td colspan="2">$smVmUtil.getDescByLabel('lbl.datatable.msg.no.records.found')</td></tr>
  		#end
	</table>
	
#include("templates/sm/sitevisit/shared/footer.vm")