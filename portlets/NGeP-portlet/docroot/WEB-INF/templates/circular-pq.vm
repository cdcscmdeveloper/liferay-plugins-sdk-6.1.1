<html>

<head>
	<style>
		@page { size: A4 portrait;}
		@page { @top-right { content: element(header) }}
				
		.header {
			display: block; text-align: right;
			position: running(header);
		}	
		
		.title-text {
			font-family: Albertus Medium;
			font-weight:bold;
			font-size:10px;			
		}
		
		tr {
			font-family: Albertus Medium;
			font-size:9px;			
		}
		
		.bold-text {
			font-weight:bold;
		}
	</style>
</head>

<body>

<table>
	<tr class='bold-text'>
		<td>
			<span style='width:70px;font-size:11px;font-family: Albertus Medium;'>Circular No.</span>
		</td>
		<td style='width:5px;'>:</td>
		<td >
			<span style='font-size:11px;font-family: Times New Roman;'>$circularNo</span>
		</td>	
	</tr>
	<tr class='bold-text'>
		<td>
			<span style='width:70px;font-size:11px;font-family: Albertus Medium;'>Circular Name</span>
		</td>
		<td style='width:5px;'>:</td>
		<td >
			<span style='font-size:11px;font-family: Times New Roman;'>$circularName</span>
		</td>
	</tr>
</table>
<br/>
<table width='100%' style='font-size:11px;font-family: Albertus Medium;'>
	#foreach( $item in $itemList )
	<tr>
		<td style='width:100px;font-size:11px;font-family: Albertus Medium;'>Item Name</td>
		<td style='width:5px;'>:</td>
		<td style='font-size:11px;font-family: Times New Roman;'>$item.itemName</td>
	</tr>
	<tr>
		<td style='width:70px;font-size:11px;font-family: Albertus Medium;'>
			#if ( $item.panelCoverageId.parameterCode == "Z")
            	Zone and Supplier
            #end		
            #if ( $item.panelCoverageId.parameterCode == "A")
            	Supplier
            #end
		</td>
		<td style='width:5px;'>:</td>
		<td style='font-size:11px;font-family: Times New Roman;'>
			<table width='100%'>
			#if ( $item.panelCoverageId.parameterCode == "Z")
            	#foreach( $zone in $item.ctPanelZones )
            		<tr>
            			<td style='width:100px;'>
            				Zone $zone.name
            			</td>
            			<td style='width:5px;'>:</td>
            			<td>
            				#foreach( $supplier in $zone.ctPanelSuppliers )
            					 $supplier.supplier.companyName;
            				#end
            			</td>
            		</tr>
            	#end
            #end
            #if ( $item.panelCoverageId.parameterCode == "A")
        		<tr>
        			<td>
        				#foreach( $supplier in $item.ctPanelSuppliers )
        					 $supplier.supplier.companyName;
        				#end
        			</td>
        		</tr>            	
            #end
            </table>
		</td>
	</tr>
	<tr><td><br/></td></tr>	
	#end
</table>
<br/>
<table>	
	<tr>
		<td>Update as of $changedDate</td>
	</tr>
</table>

</body>
</html>