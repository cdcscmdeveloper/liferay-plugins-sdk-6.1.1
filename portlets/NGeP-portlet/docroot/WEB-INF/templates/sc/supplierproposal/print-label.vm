<html>
<head>
	<style>
		@page { size: A4 portrait;}
		@page { @bottom-center { content: element(footer) }}
				
		.footer {
			display: block; text-align: center;
			position: running(footer);
		}
			
		table{
   			 border: 1px solid black;
			}		
	</style>
</head>

<body>

 	#foreach( $sampleItem in $sampleItems )
 	
		<table cellpadding="0" cellspacing="0" width="100%">
			<tr style="width : 100%">
         		<td style="width : 5%"></td><td style="width : 80%"><h3>PTJ Code - $PTJCode</h3></td>
       		</tr>
			<tr style="width : 100%">
         		<td style="width : 5%"></td><td style="width : 80%"><h3>PTJ Name - $PTJName</h3></td>
        	</tr>
			<tr style="width : 100%">
         		<td style="width : 5%"></td><td style="width : 80%"><h3>QT No - $QTNo</h3></td>
        	</tr>
			<tr style="width : 100%">
         		<td style="width : 5%"></td><td style="width : 80%"><h4>QT Title - $QTTitle</h4></td>
        	</tr>
        	<tr style="width : 100%">
         		<td style="width : 5%"></td><td style="width : 80%"><h3>Item Name - $sampleItem.scRequestItem.itemName</h3></td>
        	</tr>
			<tr style="width : 100%">
         		<td style="width : 5%"></td><td style="width : 80%"><h2>$lableNo - $sampleItem.subLableNo</h2></td>
        	</tr>
        </table>
          <br/>
          
	#end
	
 </body>

</html>
