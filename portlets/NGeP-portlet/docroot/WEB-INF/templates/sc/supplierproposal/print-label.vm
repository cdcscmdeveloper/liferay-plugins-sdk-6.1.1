<html>
<head>
	<style>
		@page { size: A4 portrait;}
		@page { @bottom-center { content: element(footer) }}
				
		.footer {
			display: block; text-align: center;
			position: running(footer);
		}
			
		table{
   			 border: 1px solid black;
			}		
	</style>
</head>

<body>

    ## #11104 -start-
    #set($rowCount = 0)
    ## #11104 -end-
    
 	#foreach( $sampleItem in $sampleItems )
 	
 	    ## #11104 -start-
		<table cellpadding="0" cellspacing="10" width="100%" style="border: 3px solid black">
		<br/>
		
		<table cellpadding="0" cellspacing="0" width="100%" border="1">
			<tr style="width : 100%" border="1">
				<td style="width : 40%"><h3>Nama PTJ</h3></td>
				<td style="width : 60%"><h3>$PTJName</h3></td>
       		</tr>
			<tr style="width : 100%" border="1">
				<td style="width : 40%"><h3>Kod PTJ</h3></td>
				<td style="width : 60%"><h3>$PTJCode</h3></td>
        	</tr>
			<tr style="width : 100%" border="1">
				<td style="width : 40%"><h3>Tajuk Perolehan</h3></td>
				<td style="width : 60%"><h3>$QTTitle</h3></td>
        	</tr>
			<tr style="width : 100%" border="1">
				<td style="width : 40%"><h3>No. Sebut Harga/Tender</h3></td>
				<td style="width : 60%"><h3>$QTNo</h3></td>
        	</tr>
        	<tr style="width : 100%" border="1">
				<td style="width : 40%"><h3>Nama Item</h3></td>
				<td style="width : 60%"><h3>$bean.replaceWithBR($sampleItem.scRequestItem.itemName)</h3></td>
        	</tr>
			<tr style="width : 100%" border="1">
				<td style="width : 40%"><h3>No.Siri Label</h3></td>
				<td style="width : 60%"><h3>$lableNo - $sampleItem.subLableNo</h3></td>
				## #11104 -end-
				
        	</tr>
        </table>
          <br/>
     ## #11104 -start-      
	</table>
     #set($rowCount = $rowCount + 1)
	#if($rowCount < $sampleItems.size())
		<div style="page-break-after:always;"><br/></div>
	#end
	## #11104 -end-     
	#end
	
 </body>

</html>
