<html>
<head>
	<style>
		@page { size: A4 portrait;}
		@page { @bottom-center { content: element(footer) }}
				
		.footer {
			display: block; text-align: center;
			position: running(footer);
		}
		
		.descTable{
		 	border-collapse: collapse;
		}
		
		.descTable td, .descTable tr, .descTable th {
		 	border: 1px solid black;
		}
		
		body{
			
		}
		
		.txtBold{
			font-weight : bold;
		}
		
		.sTable{
			width : 80%;
		}
		
		.sColTwentyPerc{
			width : 20%;
		}
		
		.infoTable{
			border-collapse: collapse;
			width: 100%;
		}
		.infoTable td {
			border: 1px solid black;
		}
		.tdInfoTable {
			border: 1px solid black;
			font-family: Verdana;
			font-size: 12px;
			font-weight: normal;
			font-style: inherit;
		}
	</style>
</head>
<body>
<table width='100%'>
	<tr>
		<td align="left">
			<span style="font-family:Thoma;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">
			2. Perlantikan Jawatan Kuasa Rundingan</span>
			<br/>
		</td>
	</tr>
</table>
<table class="infoTable">
	<tr>
		<td class="tdInfoTable">Nama</td>
		<td class="tdInfoTable">Jawatan</td>
		<td class="tdInfoTable">Gred</td>
		<td class="tdInfoTable">Kad Pengenalan No.</td>
		<td class="tdInfoTable">Jabatan </td>
		<td class="tdInfoTable">Peranan</td>
	</tr>
	#foreach( $activityList in $activityLists )
	<tr>
		<td class="tdInfoTable">$activityList.scCommitteeMember.memberName</td>
		<td class="tdInfoTable">$activityList.scCommitteeMember.designation</td>
		<td class="tdInfoTable">$activityList.scCommitteeMember.grade</td>
		<td class="tdInfoTable">$activityList.scCommitteeMember.icPassport</td>
		<td class="tdInfoTable">$activityList.scCommitteeMember.pmOrgProfile.orgName</td>
		<td class="tdInfoTable">$bean.getParameterDesc($activityList.scCommitteeMember.memberRole)</td>
	</tr>
	#end
</table>
</body>
</html>