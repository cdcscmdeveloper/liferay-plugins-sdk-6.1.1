<html>
<head>
	<style>
		.header {
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:16px;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
	</style>
</head>
<body>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">2. Lokasi Rundingan</th>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#6d839b" class="title border left">Nama Pembekal</th>
			<th bgcolor="#6d839b" class="title border left">Lokasi Rundingan</th>
			<th bgcolor="#6d839b" class="title border left-right">Tarikh</th>
		</tr>
		#foreach( $scLoi in $loiList )
			#if($scLoi.scWorkFlowStatus.pmStatus.statusId != $rejectedStatus)
				<tr class="ui-content">
					<td class="standard border-bottom left">$scLoi.scLoiLoa.supplierName</td>
					#foreach( $scNegoLocation in $scLoi.scNegoLocations )
						<td class="standard border-bottom left">$scNegoLocation.negoLocation</td>
						<td class="standard border-bottom left-right">$dateSDF.format($scNegoLocation.negoDate)</td>
					#end
				</tr>
			#end
		#end
	</tbody>
</table>
</body>
</html>