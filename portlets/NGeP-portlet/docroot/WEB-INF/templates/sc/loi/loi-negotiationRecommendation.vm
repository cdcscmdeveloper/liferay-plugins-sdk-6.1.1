<html>
<head>
	<style>
		.header {
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:16px;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
		.alignRight {
			text-align:right;
		}
	</style>
</head>
<body>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">5. Pengesyoran</th>
		</tr>
	</tbody>
</table>
<br/>
#if ($itemized == "true")
	<table width="100%" border="0" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				#if ($isZonal)
					<th width="12%" bgcolor="#6d839b" class="title border left">Zone</th>
				#end
				<td width="15%" bgcolor="#6d839b" class="title border left">Item</td>
				<td bgcolor="#6d839b" class="title border right">
					<table width="100%" border="0" cellpadding="0" cellspacing="0">
						<tbody>
							<tr>
								<td width="15%" bgcolor="#6d839b" class="title left">Recommended Supplier</td>
								<td width="10%" bgcolor="#6d839b" class="title left">Proposal ID</td>
								<td width="10%" bgcolor="#6d839b" class="title left">Bumiputra Status</td>
								<td width="15%" bgcolor="#6d839b" class="title left">Offered Price (RM)</td>
								<td width="12%" bgcolor="#6d839b" class="title left">Total Score</td>
								<td width="10%" bgcolor="#6d839b" class="title left">Ranking</td>
								<td width="10%" bgcolor="#6d839b" class="title left">Quantity</td>
							</tr>
						</tbody>
					</table>
				</td>
			</tr>
			#foreach( $item in $recommendList )
			<tr class="ui-content">
				#if ($isZonal) 
					<td class="standard border-bottom left">
						#if($!item.tplSpecZoneDtl) 
							#set( $zoneName = $item.tplSpecZoneDtl.zoneName.replaceAll("&", "&#38;") )
								$zoneName
							#end 
					 </td> 
				#end
				<td width="15%" class="standard border-bottom left" >$item.requestItem.itemName</td>
				<td class="standard border-bottom right">
					#foreach( $evalResultDtl in $item.awardSupplierList )
						<table width="100%" border="0" cellpadding="0" cellspacing="0">
							<tbody>
								<tr>
									#if ($evalResultDtl.awareded)
										<td width="18%" class="standard left">$evalResultDtl.qtEvaluationResult.scQtProposal.scQtSupplier.smSupplier.companyName</td>
										<td width="11%" class="standard left">$evalResultDtl.qtEvaluationResult.scQtProposal.supplierNo</td>
										<td width="12%" class="standard left">
											#if ($evalResultDtl.qtEvaluationResult.scQtProposal.scQtSupplier.smSupplier.bumi == "true")
												Yes
											#else
												No
											#end
										</td>
										<td width="17%" class="standard left alignRight">$numberFormatter.format($evalResultDtl.qtEvaluationResult.offeredPrice)</td>
										<td width="13%" class="standard left alignRight">$evalResultDtl.totalScore</td>
										<td width="11%" class="standard left">$evalResultDtl.evalRank</td>
										<td width="11%" class="standard left">$evalResultDtl.scQtRecommendDtl.get(0).awardQty</td>
									#end
								</tr>
							</tbody>
						</table>
					#end
				</td>
			</tr>
			#end
		</tbody>
	</table>
#end 
#if ($itemized == "false")
	<br/>
	<table width="100%" border="0" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				<td width="15%" bgcolor="#6d839b" class="title border left">Supplier Name</td>
				<td width="15%" bgcolor="#6d839b" class="title border left">Supplier Code</td>
				<td width="15%" bgcolor="#6d839b" class="title border left">Bumiputra Status</td>
				<td width="23%" bgcolor="#6d839b" class="title border left">After Negotiation Offered Price (RM)</td>
				<td width="12%" bgcolor="#6d839b" class="title border left">Total Score</td>
				<td width="10%" bgcolor="#6d839b" class="title border left">Ranking</td>
			</tr>
			#foreach($supplierDtl in $recommendSupplierList)
				#set($String = "formatter")
				#if($supplierDtl.awareded)
				<tr class="ui-content">
					<td width="15%" class="standard border-bottom left" >$supplierDtl.qtEvaluationResult.scQtProposal.scQtSupplier.smSupplier.companyName</td>
					
					<td width="15%" class="standard border-bottom left" >$supplierDtl.qtEvaluationResult.scQtProposal.supplierNo</td>
					<td width="12%" class="standard border-bottom left">
						#if ($supplierDtl.qtEvaluationResult.scQtProposal.scQtSupplier.smSupplier.bumi == "true")
							Yes
						#else
							No
						#end
					</td>
					<td width="23%" class="standard border-bottom left">$numberFormatter.format($supplierDtl.qtEvaluationResult.offeredPrice)</td>
					<td width="12%" class="standard border-bottom left">$String.format("%.2f", $supplierDtl.totalScore)</td>
					<td width="10%" class="standard border-bottom left-right">$supplierDtl.evalRank</td>
				</tr>
				#end
			#end
		</tbody>
	</table>
	<br/>
	<table width="100%" border="0" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				#if ($isZonal)
					<th width="12%" bgcolor="#6d839b" class="title border left">Zone</th>
				#end
				<td width="20%" bgcolor="#6d839b" class="title border left">Item</td>
				<td width="10%" bgcolor="#6d839b" class="title border left">Quantity</td>
				<td width="15%" bgcolor="#6d839b" class="title border left">Unit Price (RM)</td>
				<td width="15%" bgcolor="#6d839b" class="title border left">Offered Price (RM)</td>
			</tr>
			#foreach( $scLoi in $scLois )
				#foreach( $loiLoaItem in $scLoi.scLoiLoaItems )
					#foreach( $item in $recommendList )
						#foreach( $recommendDtl in $item.recommendDtls )
							#set($String = "formatter")
							#if ( $recommendDtl.recommendDtlId == $loiLoaItem.scQtRecommendDtl.recommendDtlId and 
									$recommendDtl.recordStatusFlg == 1)
							<tr class="ui-content">
								#if ($isZonal) 
								   <td class="standard border-bottom left">
									   #if($!loiLoaItem.tplSpecZoneDtl) 
										   #set( $zoneName = $loiLoaItem.tplSpecZoneDtl.zoneName.replaceAll("&", "&#38;") )
											$zoneName   #end 
									 </td> 
								 #end
								<td class="standard border-bottom left">$loiLoaItem.scRequestItem.itemName</td>
								<td class="standard border-bottom left alignRight">
									#if ($!loiLoaItem.tplSpecTierQty )
									   $loiLoaItem.tplSpecTierQty.fromQty - $loiLoaItem.tplSpecTierQty.toQty
									#else
									 $loiLoaItem.qty
									#end 
								</td>
								<td class="standard border-bottom left alignRight">
									#if($!loiLoaItem.scQtProposalItem.finalPrice) 
										$String.format("%.2f", $!loiLoaItem.scQtProposalItem.finalPrice) 
									 #end
								</td>
								<td class="standard border-bottom left-right alignRight">
									 #if ($!loiLoaItem.tplSpecTierQty )
									 #else
										$numberFormatter.format($!loiLoaItem.afterNegoSubTotal)
									 #end
								</td>
							</tr>
							#end
						#end
					#end	
				#end
			#end
			<tr class="ui-content">
				#if ($isZonal)
					<th colspan="4" bgcolor="#6d839b" class="title border left alignRight">Total</th>
				#else
					<th colspan="3" bgcolor="#6d839b" class="title border left alignRight">Total</th>
				#end
				<td bgcolor="#6d839b" class="title border left alignRight">$afterNegoSubTotal</td>
			</tr>
		</tbody>
	</table>
#end 
</body>
</html>