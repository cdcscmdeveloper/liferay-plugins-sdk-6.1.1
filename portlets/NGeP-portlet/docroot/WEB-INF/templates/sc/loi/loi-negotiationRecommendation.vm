<html>
<head>
	<style>
		.header {
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:16px;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
		.alignRight {
			text-align:right;
		}
	</style>
</head>
<body>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">5. Pengesyoran</th>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
            <td width="15%" bgcolor="#6d839b" class="title border left">Item</td>
            <td bgcolor="#6d839b" class="title border right">
				<table width="100%" border="0" cellpadding="0" cellspacing="0">
					<tbody>
						<tr>
							<td width="15%" bgcolor="#6d839b" class="title left">Recommended Supplier</td>
							<td width="10%" bgcolor="#6d839b" class="title left">Proposal ID</td>
							<td width="10%" bgcolor="#6d839b" class="title left">Bumiputra Status</td>
							<td width="15%" bgcolor="#6d839b" class="title left">Offered Price (RM)</td>
							<td width="12%" bgcolor="#6d839b" class="title left">Total Score</td>
							<td width="10%" bgcolor="#6d839b" class="title left">Ranking</td>
							<td width="10%" bgcolor="#6d839b" class="title left">Quantity</td>
						</tr>
					</tbody>
				</table>
			</td>
		</tr>
		#foreach( $item in $recommendList )
		<tr>
			<td width="15%" class="standard border-bottom left" >$item.requestItem.itemName</td>
			<td class="standard border-bottom right">
				#foreach( $evalResultDtl in $item.awardSupplierList )
					<table width="100%" border="1" cellpadding="0" cellspacing="0">
						<tbody>
							<tr>
								#if ($evalResultDtl.awareded)
									<td width="18%" class="standard left">$evalResultDtl.qtEvaluationResult.scQtProposal.scQtSupplier.smSupplier.companyName</td>
									<td width="11%" class="standard left">$evalResultDtl.qtEvaluationResult.scQtProposal.supplierNo</td>
									<td width="12%" class="standard left">
										#if ($evalResultDtl.qtEvaluationResult.scQtProposal.scQtSupplier.smSupplier.bumi == "true")
											Yes
										#else
											No
										#end
									</td>
									<td width="17%" class="standard left alignRight">$numberFormatter.format($evalResultDtl.qtEvaluationResult.offeredPrice)</td>
									<td width="13%" class="standard left alignRight">$evalResultDtl.totalScore</td>
									<td width="11%" class="standard left">$evalResultDtl.evalRank</td>
									<td width="11%" class="standard left">$evalResultDtl.scQtRecommendDtl.awardQty</td>
								#end
							</tr>
						</tbody>
					</table>
				#end
			</td>
		</tr>
		#end
	</tbody>
</table>
</body>
</html>