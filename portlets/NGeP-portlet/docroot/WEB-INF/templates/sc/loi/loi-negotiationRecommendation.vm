<html>
<head>
	<style>
		.header {
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:16px;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
	</style>
</head>
<body>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">5. Pengesyoran</th>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
            <th bgcolor="#6d839b" class="title border left">Item</th>
            <th bgcolor="#6d839b" class="title border right">
				<table width="100%" border="0" cellpadding="0" cellspacing="0">
					<tbody>
						<tr>
							<th bgcolor="#6d839b" class="title left">Recommended Supplier</th>
							<th bgcolor="#6d839b" class="title left">Proposal ID</th>
							<th bgcolor="#6d839b" class="title left">Bumiputra Status</th>
							<th bgcolor="#6d839b" class="title left">Offered Price (RM)</th>
							<th bgcolor="#6d839b" class="title left">Total Score</th>
							<th bgcolor="#6d839b" class="title left">Ranking</th>
							<th bgcolor="#6d839b" class="title left">Quantity</th>
						</tr>
					</tbody>
				</table>
			</th>
		</tr>
		#foreach( $item in $recommendList )
		<tr>
			<td valign="top" bgcolor="#f1f1f1" class="standard border-bottom left" ><strong>$item.requestItem.itemName</strong></td>
			<td bgcolor="#f1f1f1" class="standard border-bottom right">
				#foreach( $evalResultDtl in $item.awardSupplierList )
					<table width="100%" border="0" cellpadding="0" cellspacing="0">
						<tbody>
							<tr>
								#if ($evalResultDtl.awareded)
									<th bgcolor="#f1f1f1" class="standard left">$evalResultDtl.qtEvaluationResult.scQtProposal.scQtSupplier.smSupplier.companyName</th>
									<th bgcolor="#f1f1f1" class="standard left">$evalResultDtl.qtEvaluationResult.scQtProposal.supplierNo</th>
									<th bgcolor="#f1f1f1" class="standard left">
										#if ($evalResultDtl.qtEvaluationResult.scQtProposal.scQtSupplier.smSupplier.bumi == "true")
											Yes
										#else
											No
										#end
									</th>
									<th bgcolor="#f1f1f1" class="standard left">$numberFormatter.format($evalResultDtl.qtEvaluationResult.offeredPrice)</th>
									<th bgcolor="#f1f1f1" class="standard left">$evalResultDtl.totalScore</th>
									<th bgcolor="#f1f1f1" class="standard left">$evalResultDtl.evalRank</th>
									<th bgcolor="#f1f1f1" class="standard left">$evalResultDtl.scQtRecommendDtl.awardQty</th>
								#end
							</tr>
						</tbody>
					</table>
				#end
			</td>
		</tr>
		#end
	</tbody>
</table>
</body>
</html>