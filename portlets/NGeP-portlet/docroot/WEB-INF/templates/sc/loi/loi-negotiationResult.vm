<html>
<head>
	<style>
		.header {
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:16px;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
		.alignRight {
			text-align:right;
		}
	</style>
</head>
<body>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">4. Hasil Rundingan</th>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">4.1 Senarai Pembekal Untuk Hasil Rundingan</th>
		</tr>
	</tbody>
</table>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<td>
				<table width="100%" border="0" cellpadding="0" cellspacing="0">
					<tbody>
						<tr>
							<th bgcolor="#6d839b" class="title border left">Nama Pembekal</th>
							<th bgcolor="#6d839b" class="title border left">Terma Rundingan</th>
							<th bgcolor="#6d839b" class="title border left-right">Hasil Rundingan</th>
						</tr>
						#foreach( $scLoi in $scLois )
						<tr class="ui-content">
							<td class="standard border-bottom left">$scLoi.scLoiLoa.supplierName</td>
							<td class="standard border-bottom left">
								#foreach( $scLoiTerm in $scLoi.scNegoTerms )
									#if (! $scLoiTerm.termDesc)
										<br/>
									#else
										$scLoiTerm.termDesc <br/>
									#end
								#end
							</td>
							<td class="standard border-bottom left-right">
								#foreach( $scLoiTerm in $scLoi.scNegoTerms )
									#if (! $scLoiTerm.negoResult )
										<br/>
									#else
										$scLoiTerm.negoResult <br/>
									#end

								#end
							</td>
						</tr>
						#end
					</tbody>
				</table>
			</td>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">4.2 Hasil Rundingan Untuk Harga Tawaran</th>
		</tr>
	</tbody>
</table>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	#foreach( $scLoi in $scLois )
	<tbody>
		<tr>
			<td>
				<span style="font-family:'Arial', sans-serif;font-size:12px;text-align:left;color:#333;">
					Nama Pembekal : $scLoi.scLoiLoa.supplierName
				</span>
			</td>
		</tr>
		<tr>
			<td>
				<table width="100%" border="0" cellpadding="0" cellspacing="0">
					<tbody>
						<tr>
						
							#if ($isZonal)
								  	<th colspan="4" bgcolor="#6d839b" class="title border left"></th>
						      #else
								  	<th colspan="3" bgcolor="#6d839b" class="title border left"></th>
						       #end
						
							<th colspan="2" bgcolor="#6d839b" class="title border left">Harga Tawaran Asal</th>
							<th colspan="2" bgcolor="#6d839b" class="title border left-right">Harga Tawaran Selepas Rundingan</th>
						</tr>
						<tr>
						    #if ($isZonal)
					          <th bgcolor="#6d839b" class="title border left">Zone</th>
					        #end
							<th bgcolor="#6d839b" class="title border left">Item</th>
							<th bgcolor="#6d839b" class="title border left">UOM</th>
							<th bgcolor="#6d839b" class="title border left-right">Kuantiti</th>
							<th bgcolor="#6d839b" class="title border left">Per Unit (RM)</th>
							<th bgcolor="#6d839b" class="title border left">Jumlah Harga (RM)</th>
							<th bgcolor="#6d839b" class="title border left">Per Unit (RM)</th>
							<th bgcolor="#6d839b" class="title border left-right">Jumlah Harga (RM)</th>
						</tr>
						
						 #set($String = "formatter")
                         
						#foreach( $loiLoaItem in $scLoi.scLoiLoaItems )
						<tr class="ui-content">
						 
						   #if ($isZonal) 
						       <td class="standard border-bottom left">
							       #if($!loiLoaItem.tplSpecZoneDtl) 
								       #set( $zoneName = $loiLoaItem.tplSpecZoneDtl.zoneName.replaceAll("&", "&#38;") )
                                        $zoneName   #end 
							     </td> 
							 #end  
						 
							<td class="standard border-bottom left">$loiLoaItem.scRequestItem.itemName</td>
							<td class="standard border-bottom left">$loiLoaItem.scRequestItem.uom.uomCode</td>
							<td class="standard border-bottom left alignRight">
							 #if ($!loiLoaItem.tplSpecTierQty )
								   $loiLoaItem.tplSpecTierQty.fromQty - $loiLoaItem.tplSpecTierQty.toQty
							 #else
								 $loiLoaItem.qty
						      #end </td>
							<td class="standard border-bottom left alignRight">
							#if($!loiLoaItem.scQtProposalItem.offerPrice) 
	                            $String.format("%.2f", $!loiLoaItem.scQtProposalItem.offerPrice) 
                             #end
							</td>
							<td class="standard border-bottom left alignRight">$!loiLoaItem.offeredPriceSubTotal</td>
							<td class="standard border-bottom left alignRight">
							#if($!loiLoaItem.scQtProposalItem.offerPrice) 
							    $String.format("%.2f", $!loiLoaItem.scQtProposalItem.finalPrice)
							#end	
						     </td>
							<td class="standard border-bottom left-right alignRight">$!loiLoaItem.afterNegoSubTotal</td>
						</tr>
						#end
					</tbody>
				</table>
			</td>
		</tr>
	</tbody>
	#end
</table>
</body>
</html>