<html>
<head>
	<style>
		.header {
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:16px;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
	</style>
</head>
<body>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">1. KETERANGAN TAWARAN DAN MAKLUMAT SEBUT HARGA / TENDER</th>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<td class="standard border left">1.1</td>
			<td class="standard border left">Perkara</td>
			<td class="standard border left-right">$title</td>
		</tr>
		<tr>
			<td class="standard border-bottom left">1.2</td>
			<td class="standard border-bottom left">Tempoh Perjanjian / Tempoh Penyiapan</td>
			<td class="standard border-bottom left-right">$contractDuration</td>
		</tr>
		<tr>
			<td class="standard border-bottom left">1.3</td>
			<td class="standard border-bottom left">Jabatan Pengguna</td>
			<td class="standard border-bottom left-right">$ptj</td>
		</tr>
		<tr>
			<td class="standard border-bottom left">1.4</td>
			<td class="standard border-bottom left">Bilangan Pembekal Dipanggil Untuk Rundingan</td>
			<td class="standard border-bottom left-right">$supplierSize</td>
		</tr>
		<tr>
			<td class="standard border-bottom left">1.5</td>
			<td class="standard border-bottom left">Bilangan Pembekal Yang Mengesahkan Surat Niat</td>
			<td class="standard border-bottom left-right">$statusSupplierSize</td>
		</tr>
	</tbody>
</table>
</body>
</html>