<html>

<head>
<style>
	    @page { size: A4 portrait;}
		@page { @bottom-center { content: "Page " counter(page) " / " counter(pages); }}
		 
		#bottom {
			clear:both;
			text-align:right;
		}
		body{
			font-size: 8pt;
		}
		.table1 {
			border-collapse: collapse;
			width:100%;
			border: 1px solid #505860;
			cellpadding:5px;
		}
		.table1 td {
			border: 1px solid #505860;
			border-color="#A4A4A4"
			
		}
		.table1 th{
		    border: 2px solid #505860;
			background-color:#6B839B;
			color:white;
			font-size:16px;
		}
		h1{
			background-color:#A2A2A2;
			color: white;
			height:32px;
			font-family: Calibri, Candara, Segoe, "Segoe UI", Optima, Arial, sans-serif;
			font-style: normal;
			font-variant: normal;
			font-weight: 600;
		}
		
		caption{
            background-color:#A2A2A2;
			color: white;
			height:22px;
			font-family: Calibri, Candara, Segoe, "Segoe UI", Optima, Arial, sans-serif;
			font-style: normal;
			font-variant: normal;
			font-weight: 600;
            text-align:left;
			margin-bottom:5px;
			font-size:15px;
         }
}
		.table1 td span{
		    font-family: Calibri, Candara, Segoe, "Segoe UI", Optima, Arial, sans-serif;
			font-style: normal;
			font-variant: normal;
			font-weight: 400;
		}
		.table2{
		   font-family: Calibri;
		   font-style: normal;
		   font-variant: normal;
		   font-size:16px;
		   color:#505860;
		   width: 100%; 
		   margin-left:15px;
		}
		.dataBgcolor{
		  background-color:#F1F1F1;
		}
	</style>
</head>

<body>

	<h1><span>Spesifikasi</span></h1>

	<table class="table2">
		<tr>
			<td width="100px">Tajuk Templat</td>
			<td width="10px">:</td>
			<td>$!scLoa.scLoiLoa.title</td>
		</tr>
		
		<tr>
			<td>Jenis Barangan</td>
			<td>:</td>
			<td>$!itemOrignCode</td>
		</tr>
	</table>

	<br />
	<br />
	<br />

	<table class="table1" width='100%' cellpadding="10px">
	 <caption>PRODUK</caption>
		<tr>
			#if ($isZonal)
			<th rowspan="2">Zone</th> #end
			<th rowspan="2" width="16%">Item</th>
			<th>UOM</th>
			<th>Kekerapan /Unit Ukuran</th>
			<th>Bil. UnitUkuran Sehari</th>
			<th>Bil. UnitUkuran Sebulan</th>
			<th>Kuantiti</th>

		</tr>
		<tr>
			<th colspan="5" style="text-align: center;">Spesifikasi</th>

		</tr>

		#foreach( $scLoiLoaItem in $productItems )
		<tr class="dataBgcolor">
			#if ($isZonal)
			<td rowspan="2"><span>
					#if($!scLoiLoaItem.tplSpecZoneDtl) #set( $zoneName =
					$scLoiLoaItem.tplSpecZoneDtl.zoneName.replaceAll("&", "&#38;") )
					$zoneName #end </span></td> #end
			<td rowspan="2" width="16%"><span>$!scLoiLoaItem.scRequestItem.itemName</span></td>
			<td><span>$!scLoiLoaItem.scRequestItem.uom.uomCode</span></td>
			<td><span>$!scLoiLoaItem.scRequestItem.tplSpecQuestion.clUomFrequency</span></td>
			<td><span>$!scLoiLoaItem.scRequestItem.tplSpecQuestion.clUomPerDay</span></td>
			<td><span>$!scLoiLoaItem.scRequestItem.tplSpecQuestion.clUomPerMonth</span></td>
			<td align="right"><span>
					#if ($!scLoiLoaItem.tplSpecTierQty ) 
						$!scLoiLoaItem.tplSpecTierQty.fromQty - $!scLoiLoaItem.tplSpecTierQty.toQty 
					#else
						$!scLoiLoaItem.qty 
					#end 
			</span></td>

		</tr>
		<tr class="dataBgcolor">
			<td colspan="5">$!scLoiLoaItem.scRequestItem.itemDesc</td>
		</tr>
		#end
	</table>
	
	
	<br />
	<br />


	<table class="table1" width='100%' cellpadding="10px">
	 <caption>PERKHIDMATAN</caption>
		<tr>
			#if ($isZonal)
			<th rowspan="2">Zone</th> #end
			<th rowspan="2" width="16%">Item</th>
			<th>UOM</th>
			<th>Kekerapan /Unit Ukuran</th>
			<th>Bil. UnitUkuran Sehari</th>
			<th>Bil. UnitUkuran Sebulan</th>
			<th>Kuantiti</th>

		</tr>
		<tr>
			<th colspan="5" style="text-align: center;">Spesifikasi</th>

		</tr>

		#foreach( $scLoiLoaItem in $serviceItems )
		<tr class="dataBgcolor">
			#if ($isZonal)
			<td rowspan="2"><span>
					#if($!scLoiLoaItem.tplSpecZoneDtl) #set( $zoneName =
					$scLoiLoaItem.tplSpecZoneDtl.zoneName.replaceAll("&", "&#38;") )
					$zoneName #end </span></td> #end
			<td rowspan="2" width="16%"><span>$!scLoiLoaItem.scRequestItem.itemName</span></td>
			<td><span>$!scLoiLoaItem.scRequestItem.uom.uomCode</span></td>
			<td><span>$!scLoiLoaItem.scRequestItem.tplSpecQuestion.clUomFrequency</span></td>
			<td><span>$!scLoiLoaItem.scRequestItem.tplSpecQuestion.clUomPerDay</span></td>
			<td><span>$!scLoiLoaItem.scRequestItem.tplSpecQuestion.clUomPerMonth</span></td>
			<td align="right"><span>
					#if ($!scLoiLoaItem.tplSpecTierQty ) 
						$!scLoiLoaItem.tplSpecTierQty.fromQty - $!scLoiLoaItem.tplSpecTierQty.toQty 
					#else
						$!scLoiLoaItem.qty 
					#end 
			</span></td>

		</tr>
		<tr class="dataBgcolor">
			<td colspan="5">$!scLoiLoaItem.scRequestItem.itemDesc</td>
		</tr>
		#end
	</table>
	
	
</body>
</html>
