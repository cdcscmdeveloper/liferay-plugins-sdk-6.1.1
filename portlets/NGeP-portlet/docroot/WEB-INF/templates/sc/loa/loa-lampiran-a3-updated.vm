<html>
<head>
	<style>
@page {
	size: A4 portrait;
}

@page { @bottom-center { content:"Page "counter(page)" / "counter(pages);	
}
p {
	text-align: justify;
}

.text_family {
	font-family: Arial;
	font-size: 14.5px;
	font-weight: normal;
	font-style: normal;
	line-height: 20px;
	text-decoration: none;
	color: #333333;
}

.text_family_red {
	font-family: Arial;
	font-size: 14.5px;
	font-weight: normal;
	font-style: normal;
	line-height: 20px;
	text-decoration: none;
	color: red;
}

.text_family_medium {
	font-family: Arial;
	font-weight: normal;
	font-style: normal;
	line-height: 20px;
	text-decoration: none;
	font-size: 14.5px;
	color: red;
}

.text_family_small {
	font-family: Arial;
	font-weight: normal;
	font-style: normal;
	line-height: 20px;
	text-decoration: none;
	font-size: 9px;
	color: red;
}

.text_family_bold {
	font-family: Arial;
	font-weight: bold;
	font-size: 14.5px;
	line-height: 20px;
}

.text_family_italic {
	font-family: Arial;
	font-style: italic;
	font-size: 14.5px;
	line-height: 20px;
}

.text_family_header {
	font-family: Arial;
	font-size: 14.5px;
	font-weight: bold;
	line-height: 20px;
}

.text_header_submenu {
	font-family: Arial;
	font-size: 14.5px;
	font-weight: bold;
	font-style: normal;
	line-height: 20px;
	text-decoration: underline;
}

.text_header_submenu_red {
	font-family: Arial;
	font-weight: bold;
	font-style: normal;
	font-size: 14.5px;
	line-height: 20px;
	text-decoration: underline;
	color: red;
}

.text_sub_header_red {
	font-family: Arial;
	font-weight: bold;
	font-style: normal;
	font-size: 14.5px;
	line-height: 20px;
	text-decoration: none;
	color: red;
}

.submenu_padding {
	padding-left: 30px; width: 60%"
}

.text_indent {   
	margin-left: 20px; 
}

hr {
    display: block;
    height: 1px;
    border: 0;
    border-top: 1px solid #ccc;
    margin: 1em auto;
    padding: 0;
}

u {    
	border-bottom: 2px dotted #000;
	text-decoration: none;
}

.break-after {
	page-break-after:always;
}
</style>
</head>
<body>
<table border="0" cellpadding="5" cellspacing="5" width="100%">
	<tbody>
		<tr>
			<td width="100%" align="left"> <span style="font-family: Arial, Helvetica, sans-serif; color:#8c8c8c; font-size: 10px;"> <b>No. Surat Setuju Terima : $loaNo</b></span></td>
		</tr>
		<br/>
		<br/>
		<tr>
			<td width="100%" align="right"> <span style="font-family: Arial, Helvetica, sans-serif;"> <b><i>Lampiran A3</i></b></span></td>
		</tr>
		<br/>
		<tr>
			<td><span class="text_header_submenu"><u style="text-decoration:underline; font-family: Arial, Helvetica, sans-serif;"><b>*Spesifikasi/Skop
