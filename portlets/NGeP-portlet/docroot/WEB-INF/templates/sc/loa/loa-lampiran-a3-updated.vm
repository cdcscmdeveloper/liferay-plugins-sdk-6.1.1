						$tplSpecAnswer.newSupplierOffer
					#else
						#if ($tplSpecAnswer.answerRemark != $null && $tplSpecAnswer.answerRemark != "" )
							$tplSpecAnswer.answerRemark
						#else
							$defaultValue
						#end
					#end
					</td>
					<td valign="top" bgcolor="#d0eaee" class="standard border-bottom left" rowspan="2" style="text-align: left; padding-left: 5px; padding-right: 5px;">
					$serviceScope
					</td>
				</tr>
				<tr></tr>
				#end
				#if ($tplSpecAnswer.tplSpecQuestion.questionType == "S" )
