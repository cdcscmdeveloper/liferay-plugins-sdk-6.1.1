					#end
					#end
					<td valign="top" bgcolor="#d0eaee" class="standard border-bottom left" style="text-align: left; padding-left: 5px; padding-right: 5px;">
					#if ($tplSpecAnswer.newSupplierOffer != $null && $tplSpecAnswer.newSupplierOffer != "")
						$tplSpecAnswer.newSupplierOffer
					#else
						#if ($tplSpecAnswer.answerRemark != $null && $tplSpecAnswer.answerRemark != "" )
							$tplSpecAnswer.answerRemark
						#else
							$defaultValue
						#end
					#end
					</td>
					<td valign="top" bgcolor="#d0eaee" class="standard border-bottom left" style="text-align: left; padding-left: 5px; padding-right: 5px;">$serviceScope</td>
				</tr>	
				#end
			#end
			</tbody>
		</table>
		<br/>
		<br/>
		#end
		#if ($itemType == "Perkhidmatan" || $itemType == "Service")
		<table width="100%" border="1" cellpadding="0" cellspacing="0" style='font-size:85%'>
			<tbody>
			<tr>
				<th bgcolor="#6d839b" class="title border left" rowspan="2" style="text-align: left; padding-left: 5px; padding-right: 5px; font-size:10px;">Item</th>
				<th bgcolor="#6d839b" class="title border left" style="text-align: left; padding-left: 5px; padding-right: 5px; font-size:10px;">Jenis Pemenuhan</th>
