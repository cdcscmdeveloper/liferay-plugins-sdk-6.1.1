	</div>
	
	<table border="0" cellpadding="0" cellspacing="0" width="100%">
    <tr>
        <td align="center">
            <span style='font-weight:Arial;font-size:20px;font-family: Albertus Medium;'>SURAT SETUJU TERIMA</span>
            <br/> <br/>
        </td>
    </tr>
    <tr>
        <td align="right">
            Rujukan: $fileNo <br/>
            $loaNo <br/>
            $issueDate <br/><br/>
        </td>
