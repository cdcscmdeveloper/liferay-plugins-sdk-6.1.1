						## 25025- start
						<table class="text_family" style="text-align:justify;">
							<tr>
								<td align="center" style="vertical-align: top;">(a)</td>
								<td align="justify">syarikat tuan gagal mematuhi mana-mana terma di perenggan 4 dalam tempoh masa yang ditetapkan;</td>
							</tr>
							<tr>
								<td align="center" style="vertical-align: top;">(b)</td>
								<td>syarikat tuan gagal mematuhi mana-mana terma yang dinyatakan  dalam Surat Akuan Pembida Berjaya;</td>
							</tr>
							<tr>
