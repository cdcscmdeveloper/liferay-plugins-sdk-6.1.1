									<td>syarikat tuan gagal <span class="text_family_red"> *menyempurnakan perkhidmatan/membekalkan barang </span> dalam tempoh yang ditetapkan seperti di <b><i>Lampiran A</i></b>; </td>
								#else
									<td>syarikat tuan gagal <span class="text_family_red"> *menyempurnakan perkhidmatan/membekalkan barang </span> dalam tempoh yang ditetapkan seperti di <b><i>Lampiran A</i></b>; </td>
								#end
							</tr>
