<html>
<head>
	<style>
		@page { size: A4 portrait;}
		@page { @bottom-center { content: element(footer) }}
				
		.footer {
			display: block; text-align: center;
			position: running(footer);
		}
		
		.descTable{
		 	border-collapse: collapse;
		}
		
		.descTable td, .descTable tr, .descTable th {
		 	border: 1px solid black;
		}
		
		body{
			
		}
		
		.txtBold{
			font-weight : bold;
		}
		
		.sTable{
			width : 80%;
		}
		
		.sColTwentyPerc{
			width : 20%;
		}
		
		.infoTable{
			border-collapse: collapse;
			width: 100%;
		}
		.infoTable td {
			border: 1px solid black;
		}
		.tdInfoTable {
			border: 1px solid black;
			font-family: Verdana;
			font-size: 12px;
			font-weight: normal;
			font-style: inherit;
		}
	</style>
</head>
<body>
<table border="0" cellpadding="0" cellspacing="0" width="100%">
	<tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> KERTAS TAKLIMAT TENDER/SEBUT HARGA UNTUK PERTIMBANGAN </span>
            <br/><br/>
        </td>
    </tr>
    <tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> $ptj <!-- <br/> $jabatan --> </span>
			<br/>
        </td>
    </tr>
</table>
<br/>
	<table width='100%'>
		<tr>
			<td align="left">
				<span style="font-family:Thoma;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">
				<u> Notice Board </u></span>
				<br/><br/>
			</td>
		</tr>
		<tr>
			<td align="left">
				<span style="font-family:Thoma;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">
				TENDER DETAILS </span>
				<br/>
			</td>
		</tr>
	</table>

	<table class="infoTable">
		<tr>
			<td class="tdInfoTable">1</td>
			<td class="tdInfoTable">Title</td>
			<td class="tdInfoTable">$title</td>
		</tr>
		<tr>
			<td class="tdInfoTable">2</td>
			<td class="tdInfoTable">Quotation/Tender No</td>
			<td class="tdInfoTable">$qtNo</td>
		</tr>
		<tr>
			<td class="tdInfoTable">3</td>
			<td class="tdInfoTable">Ministry</td>
			<td class="tdInfoTable">$ministry</td>
		</tr>
		<tr>
			<td class="tdInfoTable">4</td>
			<td class="tdInfoTable">Jabatan</td>
			<td class="tdInfoTable">$jabatan</td>
		</tr>
		<tr>
			<td class="tdInfoTable">5</td>
			<td class="tdInfoTable">PTJ</td>
			<td class="tdInfoTable">$ptj</td>
		</tr>
		<tr>
			<td class="tdInfoTable">6</td>
			<td class="tdInfoTable">Notice Publish Date</td>
			<td class="tdInfoTable">$publishDate</td>
		</tr>
		<tr>
			<td class="tdInfoTable">7</td>
			<td class="tdInfoTable">Publishing Period (Days)</td>
			<td class="tdInfoTable">$publishPeriod</td>
		</tr>
		<tr>
			<td class="tdInfoTable">8</td>
			<td class="tdInfoTable">Closing Date</td>
			<td class="tdInfoTable">$closingDate</td>
		</tr>
		<tr>
			<td class="tdInfoTable">9</td>
			<td class="tdInfoTable">ProposalValidity (Days)	</td>
			<td class="tdInfoTable">$validityDays</td>
		</tr>
		<tr>
			<td class="tdInfoTable">10</td>
			<td class="tdInfoTable">Proposal Validity Until</td>
			<td class="tdInfoTable">$validityDays</td>
		</tr>
		<tr>
			<td class="tdInfoTable">11</td>
			<td class="tdInfoTable">Evaluation Type</td>
			<td class="tdInfoTable">
				#if ($tier == "1")
					One Tier
				#else
					Two Tier 
				#end
			</td>
		</tr>
	</table>
	<br/>
	<table width='100%'>
		<tr>
			<td align="left">
				<span style="font-family:Thoma;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">
				SUPPLIER QUALIFICATION CRITERIA </span>
				<br/>
			</td>
		</tr>
	</table>
	<table class="infoTable">
		<tr>
			<td style="width: 30%;" class="tdInfoTable">Supplier Status</td>
			<td class="tdInfoTable">
				#if ($openFor == "B")
					Bumiputra
				#else
					All 
				#end
			</td>
		</tr>
		<tr>
			<td style="width: 30%;" class="tdInfoTable">Min Paid Up Capital(RM)</td>
			<td class="tdInfoTable">$paidupcapital</td>
		</tr>
	</table>
	<br/>
	<table width='100%'>
		<tr>
			<td align="left">
				<span style="font-family:Thoma;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">
				CATEGORY CODE LIST </span>
				<br/>
			</td>
		</tr>
	</table>
	<table class="infoTable">
		<tr>
			<td class="tdInfoTable" bgcolor="#eee">Category Code</td>
			<td class="tdInfoTable" bgcolor="#eee">Main-Category</td>
			<td class="tdInfoTable" bgcolor="#eee">Sub-Category</td>
			<td class="tdInfoTable" bgcolor="#eee">Sub-Category Division</td>
			<td class="tdInfoTable" bgcolor="#eee">Category Type</td>
		</tr>
		#foreach( $categoryDtls in $categoryList )
		<tr>
			<td class="tdInfoTable">
				$categoryDtls.pmCategoryL1.categoryL1Code
				$categoryDtls.pmCategoryL2.categoryL2Code
				$categoryDtls.pmCategoryL3.categoryL3Code</td>
			<td class="tdInfoTable">
				$categoryDtls.pmCategoryL3.pmCategoryL2.pmCategoryL1.categoryName</td>
			<td class="tdInfoTable">
				$categoryDtls.pmCategoryL3.pmCategoryL2.categoryName</td>
			<td class="tdInfoTable">
				$categoryDtls.pmCategoryL3.categoryName</td>
			<td class="tdInfoTable">
				$bean.getParameterDesc($categoryDtls.pmCategoryL3.categoryTypeCode)</td>
		</tr>
		#end
	</table>
	<br/>
	<table width='100%'>
		<tr>
			<td align="left">
				<span style="font-family:Thoma;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">
				LOCATION SELECTION </span>
				<br/>
			</td>
		</tr>
	</table>
	<table>
		<tr>
			<td>
				#if ($locLevel == "true")
					<span style="font-family:Arial;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">Location Level :</span> $locationLevel <br/>
					<span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'> Location
						<table class="infoTable">
							<tr>
								<td bgcolor="#eee">Zone</td>
								<td bgcolor="#eee">State</td>
								#if ($locationLevel == "District")
									<td>District</td>
								#end
							</tr>
							#foreach($location in $zoneLocality)
								#foreach($locCriteria in $location.tplSpecZoneLocs)
								<tr>
									<td>$location.zoneName</td>
									<td>
										$locCriteria.pmState.stateName
									</td>
									#if ($locationLevel == "District")
										<td>
											$locCriteria.pmDistrict.districtName
										</td>
									#end
								</tr>
								#end
							#end
						</table>
					</span>
				#end
				#if ($locLevel == "false")
					#if ($subLocLevel == "true")
						<span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'> Location
						<table class="infoTable">
							<tr>
								<td bgcolor="#eee">State</td>
								#if ($locationLevel == "District")
									<td bgcolor="#eee">District</td>
								#end
							</tr>
							#foreach($tplSpecLoc in $locality)
								<tr>
									<td>
										$tplSpecLoc.pmState.stateName
									</td>
									#if ($locationLevel == "District")
										<td>
											$tplSpecLoc.pmDistrict.districtName
										</td>
									#end
								</tr>
							#end
						</table>
						</span>
					#end
					#if ($subLocLevel == "false")
					#end
				#end
			</td>
		</tr>
	</table>
	<br/>
	<table>
		<tr>
			<td>
				#if ($isbsv == "true")
					#foreach( $zoneList in $zoneBeans )
						#if ( $isZone)
							$zoneList.tplSpecZoneDtl.zoneName<br/>
						#end
						Site Visit Same As Briefing : 
						#if ($zoneList.scQtBsv.sameBsv)
							Yes
						#else 
							No 
						#end<br/>
						<table class="infoTable">
							<tr>
								<td bgcolor="#eee">Description</td>
								<td bgcolor="#eee">Date/Time</td>
								<td bgcolor="#eee">Location</td>
								<td bgcolor="#eee">Coordinationg Officer</td>
								<td bgcolor="#eee">Max Attendance</td>
							</tr>
							#foreach( $briefingdtls in $zoneList.briefingList )
							<tr>
								<td>$briefingdtls.bsvDesc</td>
								<td>$briefingdtls.bsvDate</td>
								<td>$briefingdtls.location</td>
								<td>$briefingdtls.coordinatingOfficer</td>
								<td>$briefingdtls.maxNoOfAttendance</td>
							</tr>
							#end
						</table>
						Attendance for Briefing : 
						#if ($zoneList.scQtBsv.allBriefingReq)
							Yes
						#else 
							No 
						#end<br/>
						<br />
						<table class="infoTable">
							<tr>
								<td bgcolor="#eee">Description</td>
								<td bgcolor="#eee">Date/Time</td>
								<td bgcolor="#eee">Location</td>
								<td bgcolor="#eee">Coordinationg Officer</td>
								<td bgcolor="#eee">Max Attendance</td>
							</tr>
							#foreach( $sitevisitdtls in $zoneList.sitevisitList )
							<tr>
								<td>$sitevisitdtls.bsvDesc</td>
								<td>$sitevisitdtls.bsvDate</td>
								<td>$sitevisitdtls.location</td>
								<td>$sitevisitdtls.coordinatingOfficer</td>
								<td>$sitevisitdtls.maxNoOfAttendance</td>
							</tr>
							#end
						</table>
						Attendance for Site Visit : 
						#if ($zoneList.scQtBsv.allSiteVisitReq)
							Yes
						#else 
							No 
						#end<br/>
					#end
				#end
				#if ($isbsv == "false")
				#end
			</td>
		</tr>
	</table>
	<br/>
	<table width='100%'>
		<tr>
			<td align="left">
				<span style="font-family:Thoma;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">
				CONTACT PERSON DETAILS </span>
				<br/>
			</td>
		</tr>
	</table>
	<table class="infoTable">
		<tr>
			<td class="tdInfoTable" bgcolor="#eee">Name</td>
			<td class="tdInfoTable" bgcolor="#eee">Tel No</td>
			<td class="tdInfoTable" bgcolor="#eee">Fax No</td>
			<td class="tdInfoTable" bgcolor="#eee">Email</td>
		</tr>
		#foreach( $contactPerson in $contactPersons )
		<tr>
			<td class="tdInfoTable">$contactPerson.name</td>
			<td class="tdInfoTable">$contactPerson.phoneNo</td>
			<td class="tdInfoTable">$contactPerson.faxNo</td>
			<td class="tdInfoTable">$contactPerson.email</td>
		</tr>
		#end
	</table>
	<br/>
</body>
</html>
