<html>
<head>
	<style>
		.header {
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:16px;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
	</style>
</head>
<body>
<table border="0" cellpadding="0" cellspacing="0" width="100%">
	<tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> KERTAS TAKLIMAT SEBUT HARGA / TENDER UNTUK PERTIMBANGAN </span>
            <br/><br/>
        </td>
    </tr>
    <tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> $ptj <!-- <br/> $jabatan --> </span>
			<br/>
        </td>
    </tr>
</table>
<br/>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header"><u> Notice Board </u></th>
		</tr>
	</tbody>
</table>
<br/>
<br/>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">Tender Details</th>
		</tr>
	</tbody>
</table>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<td class="standard border left">1</td>
			<td class="standard border left">Perkara</td>
			<td class="standard border left-right">$title</td>
		</tr>
		<tr>
			<td class="standard border-bottom left">2</td>
			<td class="standard border-bottom left">Quotation/Tender No</td>
			<td class="standard border-bottom left-right">$qtNo</td>
		</tr>
		<tr>
			<td class="standard border-bottom left">3</td>
			<td class="standard border-bottom left">Ministry</td>
			<td class="standard border-bottom left-right">$ministry</td>
		</tr>
		<tr>
			<td class="standard border-bottom left">4</td>
			<td class="standard border-bottom left">PTJ</td>
			<td class="standard border-bottom left-right">$ptj</td>
		</tr>
		<tr>
			<td class="standard border-bottom left">5</td>
			<td class="standard border-bottom left">Notice Publish Date</td>
			<td class="standard border-bottom left-right">$publishDate</td>
		</tr>		
		<tr>
			<td class="standard border-bottom left">6</td>
			<td class="standard border-bottom left">Publishing Period (Days)</td>
			<td class="standard border-bottom left-right">$publishPeriod</td>
		</tr>
		<tr>
			<td class="standard border-bottom left">7</td>
			<td class="standard border-bottom left">Closing Date</td>
			<td class="standard border-bottom left-right">$closingDate</td>
		</tr>
		<tr>
			<td class="standard border-bottom left">8</td>
			<td class="standard border-bottom left">Proposal Validity (Days)</td>
			<td class="standard border-bottom left-right">$validityDays</td>
		</tr>
		<tr>
			<td class="standard border-bottom left">9</td>
			<td class="standard border-bottom left">Proposal Validity Until</td>
			<td class="standard border-bottom left-right">$!proposalValidityDate</td>
		</tr>
		<tr>
			<td class="standard border-bottom left">10</td>
			<td class="standard border-bottom left">Evaluation Type</td>
			<td class="standard border-bottom left-right">
				#if ($tier == "1")
					One Tier
				#else
					Two Tier 
				#end
			</td>
		</tr>
	</tbody>
</table>
<br/>

#if ($panel == "false" and $zonal == "true")
	<br/>
	<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				<th bgcolor="#a2a2a2" class="header">Zone Information</th>
			</tr>
		</tbody>
	</table>
	<table width="100%" border="0" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				<td>
					#if ($zoneLocLevel == "true")
						<table width="100%" border="0" cellpadding="0" cellspacing="0">
							<tbody>
								<tr>
									<td width="15%" class="standard"><nobr>Zone Coverage:</nobr></td>
									<td class="standard">$zoneLocationLevel</td>
								</tr>
							</tbody>
						</table>
						<br/>
						<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
							<tbody>
								<tr>
									<th bgcolor="#a2a2a2" class="header">Zone</th>
								</tr>
							</tbody>
						</table>
						<br/>
						<table width="100%" border="0" cellpadding="0" cellspacing="0">
							<tbody>
								<tr>
									<th bgcolor="#6d839b" class="title border left">Zone</th>
									<th bgcolor="#6d839b" class="title border left-right">State</th>
									#if ($zoneLocationLevel == "District")
										<th bgcolor="#6d839b" class="title border left-right">District</th>
									#end
								</tr>
								#foreach($location in $zoneLocality.keySet())
									<tr class="ui-content">
										#if ($zoneLocationLevel == "District")
											<td class="standard border-bottom left" colspan="3">$location.zoneName</td>
										#else 
											<td class="standard border-bottom left" colspan="2">$location.zoneName</td>
										#end
									</tr>								
									#foreach($locState in $zoneLocality.get($location).keySet())
										#if ($zoneLocationLevel == "District")
											<tr class="ui-content">
												<td class="standard border-bottom left"></td>
												<td class="standard border-bottom left-right" colspan="2">$locState.stateName</td>
											</tr>
											#foreach($locDistrict in $zoneLocality.get($location).get($locState))
												<tr class="ui-content">
													<td class="standard border-bottom left"></td>
													<td class="standard border-bottom left-right"></td>
													<td class="standard border-bottom left-right">
														$locDistrict.districtName
													</td>														
												</tr>
											#end											
										#else
											<tr class="ui-content">
												<td class="standard border-bottom left"></td>
												<td class="standard border-bottom left-right">$locState.stateName</td>
											</tr>											
										#end
									#end
								#end
							</tbody>
						</table>
					#end
				</td>
			</tr>
		</tbody>
	</table>
	<br/>
#end

#if ($panel == "true")
	<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				<th bgcolor="#a2a2a2" class="header">Panel Information</th>
			</tr>
		</tbody>
	</table>
	<br/>
	<table width="100%" border="0" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				<td width="30%" class="standard"><nobr>Treasury Contract Circular No. :</nobr></td>
				<td class="standard">$ctCircularVer.circularNo</td>
			</tr>
			<tr>
				<td width="30%" class="standard"><nobr>Circular Name :</nobr></td>
				<td class="standard">$ctCircularVer.name</td>
			</tr>
			<tr>
				<td width="30%" class="standard"><nobr>Circular Expiry Date :</nobr></td>
				<td class="standard">$dateSDF.format($ctCircularVer.endDate)</td>
			</tr>
		</tbody>
	</table>
	<br/>
	<table width="100%" border="0" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				<th bgcolor="#6d839b" class="title border left">Panel Item</th>
				<th bgcolor="#6d839b" class="title border left">Spesifikasi</th>
				<th bgcolor="#6d839b" class="title border left">Item Category</th>
				<th bgcolor="#6d839b" class="title border left">Panel Coverage</th>
				<th bgcolor="#6d839b" class="title border left">UOM</th>
				<th bgcolor="#6d839b" class="title border left">Min.Order Qty</th>
				<th bgcolor="#6d839b" class="title border left-right">Maximum Procuremnt Amount Out of Contract (RM)</th>
			</tr>
			#foreach( $panelItem in $panelList)
				<tr class="ui-content">
					<td class="standard border-bottom left">$panelItem.itemName</td>
					<td class="standard border-bottom left">$!panelItem.specification</td>
					<td class="standard border-bottom left">$bean.getParameterDesc($panelItem.itemCategoryId)</td>
					<td class="standard border-bottom left">$bean.getParameterDesc($panelItem.panelCoverageId)</td>
					<td class="standard border-bottom left">$panelItem.pmUom.uomName</td>
					<td class="standard border-bottom left">$panelItem.minimumOrderQty</td>
					<td class="standard border-bottom left-right">$panelItem.maxProcureAmt</td>
				</tr>
			#end
		</tbody>
	</table>
#end 

#if ($panel == "false")
	<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				<th bgcolor="#a2a2a2" class="header">Supplier Qualification Criteria</th>
			</tr>
		</tbody>
	</table>
	<table width="100%" border="0" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				<td width="25%" class="standard border left">Supplier Status</td>
				<td class="standard border left-right">
					#if ($openFor == "B")
						Bumiputra
					#else
						All 
					#end
				</td>
			</tr>
			<tr>
				<td width="25%" class="standard border-bottom left">Min Paid Up Capital(RM)</td>
				<td class="standard border-bottom left-right">$paidupcapital</td>
			</tr>
		</tbody>
	</table>
	<br/>
	<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				<th bgcolor="#a2a2a2" class="header">Category Code List</th>
			</tr>
		</tbody>
	</table>
	<br/>
	<table width="100%" border="0" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				<th bgcolor="#6d839b" class="title border left">Category Code</th>
				<th bgcolor="#6d839b" class="title border left">Main-Category</th>
				<th bgcolor="#6d839b" class="title border left">Sub-Category</th>
				<th bgcolor="#6d839b" class="title border left">Sub-Category Division</th>
				<th bgcolor="#6d839b" class="title border left-right">Category Type</th>
			</tr>
			#foreach( $categoryDtls in $categoryList)
				<tr class="ui-content">
					<td class="standard border-bottom left">
						$categoryDtls.pmCategoryL1.categoryL1Code
						$categoryDtls.pmCategoryL2.categoryL2Code
						$categoryDtls.pmCategoryL3.categoryL3Code
					</td>
					<td class="standard border-bottom left">$categoryDtls.pmCategoryL3.pmCategoryL2.pmCategoryL1.categoryName</td>
					<td class="standard border-bottom left">$categoryDtls.pmCategoryL3.pmCategoryL2.categoryName</td>
					<td class="standard border-bottom left">$categoryDtls.pmCategoryL3.categoryName</td>
					<td class="standard border-bottom left-right">$bean.getParameterDesc($categoryDtls.pmCategoryL3.categoryTypeCode)</td>
				</tr>
			#end
		</tbody>
	</table>
	<br/>
	<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				<th bgcolor="#a2a2a2" class="header">Locality</th>
			</tr>
		</tbody>
	</table>
	<table width="100%" border="0" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				<td>
					#if ($locLevel == "true")
						<table width="100%" border="0" cellpadding="0" cellspacing="0">
							<tbody>
								<tr>
									<td width="15%" class="standard"><nobr>Locality Coverage:</nobr></td>
									<td class="standard">$locationLevel</td>
								</tr>
							</tbody>
						</table>
						<br/>
						<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
							<tbody>
								<tr>
									<th bgcolor="#a2a2a2" class="header">Location</th>
								</tr>
							</tbody>
						</table>
						<br/>
						<table width="100%" border="0" cellpadding="0" cellspacing="0">
							<tbody>
								<tr>
									#if ($locationLevel == "District")
										<th bgcolor="#6d839b" class="title border left-right" colspan="2">State</th>
										<th bgcolor="#6d839b" class="title border left-right">District</th>
									#else
										<th bgcolor="#6d839b" class="title border left-right">State</th>
									#end
								</tr>
								#foreach($locState in $locality.keySet())
									#if ($zoneLocationLevel == "District")
										<tr class="ui-content">
											<td class="standard border-bottom left-right" colspan="2">$locState.stateName</td>
										</tr>
										#foreach($locDistrict in $locality.get(locState))
											<tr class="ui-content">
												<td class="standard border-bottom left-right"></td>
												<td class="standard border-bottom left-right">
													$locDistrict.districtName
												</td>														
											</tr>
										#end											
									#else
										<tr class="ui-content">
											<td class="standard border-bottom left-right">$locState.stateName</td>
										</tr>											
									#end
								#end
							</tbody>
						</table>
					#end
					#if ($isAllState == "false")
						#if ($locLevel == "false")
							#if ($subLocLevel == "true")
								<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
									<tbody>
										<tr>
											<th bgcolor="#a2a2a2" class="header">Location</th>
										</tr>
									</tbody>
								</table>
								<br/>
								<table width="100%" border="0" cellpadding="0" cellspacing="0">
									<tbody>
										<tr>
											#if ($locationLevel == "District")
												<th bgcolor="#6d839b" class="title border left-right" colspan="2">State</th>
												<th bgcolor="#6d839b" class="title border left-right">District</th>
											#else
												<th bgcolor="#6d839b" class="title border left-right">State</th>
											#end
										</tr>
										#foreach($locState in $locality.keySet())
											#if ($zoneLocationLevel == "District")
												<tr class="ui-content">
													<td class="standard border-bottom left-right" colspan="2">$locState.stateName</td>
												</tr>
												#foreach($locDistrict in $locality.get(locState))
													<tr class="ui-content">
														<td class="standard border-bottom left-right"></td>
														<td class="standard border-bottom left-right">
															$locDistrict.districtName
														</td>														
													</tr>
												#end											
											#else
												<tr class="ui-content">
													<td class="standard border-bottom left-right">$locState.stateName</td>
												</tr>											
											#end
										#end
									</tbody>
								</table>
							#end
							#if ($subLocLevel == "false")
							#end
						#end
					#else
						<br/>
						<table width="100%" border="0" cellpadding="0" cellspacing="0">
							<tbody>
								<tr>
									<td width="15%" class="standard"><nobr>Location :</nobr></td>
									<td class="standard">All States</td>
								</tr>
							</tbody>
						</table>
					#end
				</td>
			</tr>
		</tbody>
	</table>
	<br/>
	#if ($isbsv == "true")
		#foreach($zoneList in $zoneBeans)
			#if ($isZone)
				<span style="font-family:'Arial', sans-serif;font-size:12px;text-align:left;color:#333;">$zoneList.tplSpecZoneDtl.zoneName</span><br/>
			#end
			<table width="100%" border="0" cellpadding="0" cellspacing="0">
				<tbody>
					<tr>
						<td width="15%" class="standard"><nobr>Site Visit Same As Briefing :</nobr></td>
						<td class="standard">
							#if ($zoneList.scQtBsv.sameBsv)
								Yes
							#else 
								No 
							#end
						</td>
					</tr>
				</tbody>
			</table>
			
			#if ( $zoneList.briefingList != "" && $zoneList.briefingList.size() > 0 ) 
				<table width="100%" border="0" cellpadding="0" cellspacing="0">
					<tbody>
						<tr>
							<th bgcolor="#6d839b" class="title border left">Description</th>
							<th bgcolor="#6d839b" class="title border left">Date/Time</th>
							<th bgcolor="#6d839b" class="title border left">Location</th>
							<th bgcolor="#6d839b" class="title border left">Coordinationg Officer</th>
							<th bgcolor="#6d839b" class="title border left-right">Max Attendance</th>
						</tr>
						#foreach($briefingdtls in $zoneList.briefingList)
							<tr class="ui-content">
								<td class="standard border-bottom left">$briefingdtls.bsvDesc</td>
								<td class="standard border-bottom left">$dateSDF.format($briefingdtls.bsvDate)</td>
								<td class="standard border-bottom left">$briefingdtls.location</td>
								<td class="standard border-bottom left">$briefingdtls.coordinatingOfficer</td>
								<td class="standard border-bottom left-right">$briefingdtls.maxNoOfAttendance</td>
							</tr>
						#end
					</tbody>
				</table>
				<br />
			#end
			
			#if ( $zoneList.sitevisitList != "" && $zoneList.sitevisitList.size() > 0 ) 
				<table width="100%" border="0" cellpadding="0" cellspacing="0">
					<tbody>
						<tr>
							<th bgcolor="#6d839b" class="title border left">Description</th>
							<th bgcolor="#6d839b" class="title border left">Date/Time</th>
							<th bgcolor="#6d839b" class="title border left">Location</th>
							<th bgcolor="#6d839b" class="title border left">Coordinating Officer</th>
							<th bgcolor="#6d839b" class="title border left-right">Max Attendance</th>
						</tr>
						#foreach( $sitevisitdtls in $zoneList.sitevisitList )
							<tr class="ui-content">
								<td class="standard border-bottom left">$sitevisitdtls.bsvDesc</td>
								<td class="standard border-bottom left">$dateSDF.format($sitevisitdtls.bsvDate)</td>
								<td class="standard border-bottom left">$sitevisitdtls.location</td>
								<td class="standard border-bottom left">$sitevisitdtls.coordinatingOfficer</td>
								<td class="standard border-bottom left-right">$sitevisitdtls.maxNoOfAttendance</td>
							</tr>
						#end
					</tbody>
				</table>
				<table width="100%" border="0" cellpadding="0" cellspacing="0">
					<tbody>
						<tr>
							<td width="15%" class="standard"><nobr>Attendance for Site Visit :</nobr></td>
							<td class="standard">
								#if ($zoneList.scQtBsv.allSiteVisitReq)
									Yes
								#else 
									No 
								#end
							</td>
						</tr>
					</tbody>
				</table>
			#end
			
		#end
	#end
	#if ($isbsv == "false")
	#end
#end	
<br/>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">Contact Person Details</th>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#6d839b" class="title border left">Name</th>
			<th bgcolor="#6d839b" class="title border left">Tel No</th>
			<th bgcolor="#6d839b" class="title border left">Fax No</th>
			<th bgcolor="#6d839b" class="title border left-right">Email</th>
		</tr>
		#foreach( $contactPerson in $contactPersons )
			<tr class="ui-content">
				<td class="standard border-bottom left">$contactPerson.name</td>
				<td class="standard border-bottom left">$contactPerson.phoneNo</td>
				<td class="standard border-bottom left">$contactPerson.faxNo</td>
				<td class="standard border-bottom left-right">$contactPerson.email</td>
			</tr>
		#end
	</tbody>
</table>
</body>
</html>