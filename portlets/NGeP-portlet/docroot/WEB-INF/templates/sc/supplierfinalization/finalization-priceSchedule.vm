<html>
<head>
<style>
@page {
	size: A4 portrait;
}

@page { @bottom-center { content:element(footer)
	
}

}
.table2 {
    border-collapse: collapse;
	width:100%;
}
		.table2 th, .table2 td {
			border: 1px solid black;
		}
		 th{
			background-color: #BCE18A;
		 }
.footer {
	display: block;
	text-align: center;
	position: running(footer);
}
</style>
</head>
<body>
<table border="0" cellpadding="0" cellspacing="0" width="100%">
	<tr>
		<td align="left">
			<span style='font-weight:bold;font-size:18px;font-family: Albertus Medium;'><u> PERINCIAN JADUAL SEBUT HARGA / TENDER SELEPAS TARIKH TUTUP </u></span>
            <br/><br/>
        </td>
    </tr>
    <tr>
    	<td>
    		 <span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'>
				#if ($isZone == "true")
					#foreach( $zone in $zones )
						$zone.zoneName.toUpperCase()<br/>
						<table class="table2" width='100%'>
							<tr>
								<td bgcolor="#eee">No.</td>
								<td bgcolor="#eee">Kod Pembekal</td>
								<td bgcolor="#eee">Harga Ditawarkan (RM)</td>
							</tr>
							#set( $count = 1 )
							#foreach( $supplierBean in $supplierBeansMap.get($zone.specZoneId) )
							<tr>
								<td>$count</td>
								<td>$supplierBean.supplierId</td>
								<td>$supplierBean.offeredPrice</td>
							</tr>
							#set( $count = $count + 1 )
							#end
						</table>
						<br/>
					#end
				#end
				
				#if ($isZone == "false")
					<table class="table2" width='100%'>
		    			<tr>
		    				<td bgcolor="#eee">No.</td>
		    				<td bgcolor="#eee">Kod Pembekal</td>
		    				<td bgcolor="#eee">Harga Ditawarkan (RM)</td>
		    			</tr>
		    			#set( $count = 1 )
		    			#foreach( $supplierBean in $supplierBeans )
		    			<tr>
		    				<td>$count</td>
		    				<td>$supplierBean.supplierId</td>
		    				<td>$supplierBean.offeredPrice</td>
		    			</tr>
		    			#set( $count = $count + 1 )
		    			#end
		    		</table>
				#end
	          </span>
    	</td>
    </tr>
</table>
</body>
</html>