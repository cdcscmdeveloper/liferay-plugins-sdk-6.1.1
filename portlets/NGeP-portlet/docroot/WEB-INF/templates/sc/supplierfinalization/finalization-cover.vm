<html>
<head>
<style>
@page {
	size: A4 portrait;
}

@page { @bottom-center { content:element(footer)
	
}

}
.table2 {
    border-collapse: collapse;
	width:100%;
}
		.table2 th, .table2 td {
			border: 1px solid black;
		}
		 th{
			background-color: #BCE18A;
		 }
.footer {
	display: block;
	text-align: center;
	position: running(footer);
}
</style>
</head>
<body>
	<table border="0" cellpadding="0" cellspacing="0" width="100%">
	<tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> KERTAS BIL. $qtNo / $year</span>
            <br/> <br/>
        </td>
    </tr>
    <tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> <!-- $jabatan <br/> --> $ptj</span>
			<br/><br/>
        </td>
    </tr>
    <tr>
        <td align="center">
        	#if ( $procurementMode == "Q")
            	<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> KERTAS TAKLIMAT SEBUT HARGA UNTUK PERTIMBANGAN </span>
            	<br/> <br/>
            #end
            #if ( $procurementMode == "T")
            	<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> KERTAS TAKLIMAT TENDER UNTUK PERTIMBANGAN </span>
            	<br/> <br/>
            #end
        </td>
    </tr>
    <tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'>$commType</span>
            <br/> <br/><br/>
        </td>
    </tr>
	<tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'>BAGI</span>
            <br/> <br/><br/>
        </td>
    </tr>
    <tr>
        <td align="center">
            <span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> $title </span>
            <br/> <br/><br/>
        </td>
    </tr>
    <tr align='left'>
		<td>
			<span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'>
			<table class="table2" width='100%'>
				<tr>
					<td bgcolor="#eee">Bil. Mesyuarat</td>
					<td bgcolor="#eee">Tempat</td>
					<td bgcolor="#eee">Tarikh</td>
					<td bgcolor="#eee">Masa</td>
				</tr>
				#set( $count = 1 )
				#foreach( $meetingDtls in $scQtMeetings )
				<tr>
					<td>$count</td>
					<td>$meetingDtls.meetingLocation</td>
					<td>$meetingDtls.meetDateStr</td>
					<td>$meetingDtls.meetTimeStr</td>
				</tr>
				#set( $count = $count + 1 )
				#end
			</table>
			</span>
		</td>
	</tr>
    </table>
 </body>
 </html>