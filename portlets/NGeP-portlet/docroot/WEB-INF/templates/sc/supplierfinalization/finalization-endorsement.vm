<html>
<head>
	<style>
		@page {
			size: A4 portrait;
		}
		@page { 
			@bottom-center { 
				content: "Page " counter(page) " / " counter(pages);
			}
		}	
		.header {
			font-family:'Arial', sans-serif;
			font-size:16px;
			font-weight: bold;
			text-align:left;
		}
		.standard {
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			text-align:left;
		}
		.number {
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			text-align:right;
		}		
		.title {
			font-family:'Arial', sans-serif;
			font-size:12px;
			font-weight: bold;
		}
		.border {
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom {
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left {
			border-left: 1px solid #a2a2a2;
		}
		.right {
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table {
			width: 100%;
		}
		th {
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td {
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white {
			color:#fff;
		}
		.align-left {
			text-align: left;
		}
		.align-right {
			text-align: right;
		}		
	</style>
</head>
<body>
<table border="0" cellpadding="0" cellspacing="0" width="100%">
	<tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> KERTAS KEPUTUSAN </span>
            <br/><br/>
        </td>
    </tr>
	<tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> $!committeeTypeStr </span>
            <br/>
        </td>
    </tr>
	<tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> $!ministryName </span>
            <br/><br/>
        </td>
    </tr>
	<tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> MESYUARAT BIL. 1</span>
            <br/>
        </td>
    </tr>
	<tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> $!meetingDate </span>
            <br/><br/>
        </td>
    </tr>
	<tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> $!meetingLocation </span>
            <br/><br/>
        </td>
    </tr>
	<tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> $!qtTitle </span>
            <br/><br/><br/><br/>
        </td>
    </tr>
    
	#if ($isRepublish == "true")  
	<tr>
		<td align="left">
			<table width="100%" border="0" cellpadding="0" cellspacing="0">
				<tbody>
					<tr>
						<td width="15%" class="title align-right">Keputusan Mesyuarat</td>
						<td width="15%" class="align-left">$!meetingDecision</td>
					</tr>
					<tr>
						<td width="15%" class="title align-right">Perubahan Spesifikasi Diperlukan</td>
						<td width="15%" class="align-left">
							#if ($requireSpecChanges == "true") 
								Ya
							#else
								Tiada
							#end
						</td>
					</tr>					
				</tbody>
			</table>
        </td>
    </tr> 	
	#end 
	
	#if ($isReEvaluate == "true")  
	<tr>
		<td align="left">
			<table width="100%" border="0" cellpadding="0" cellspacing="0">
				<tbody>
					<tr>
						<td width="15%" class="title align-right">Keputusan Mesyuarat</td>
						<td width="15%" class="align-left">$!meetingDecision</td>
					</tr>
					<tr>
						<td width="15%" class="title align-right">Penilaian Semula</td>
						<td width="15%" class="align-left"> </td>
					</tr>					
					<tr>
						<td width="15%" class="title align-right">Ketepatan Dokumen</td>
						<td width="15%" class="align-left">
							#if ($documentCompliance == "true") 
								Ya
							#else
								Tiada
							#end
						</td>
					</tr>
					
					#if ($hasTechnical == "true")
					<tr>
						<td width="15%" class="title align-right">Teknikal</td>
						<td width="15%" class="align-left">
							#if ($technical == "true") 
								Ya
							#else
								Tiada
							#end
						</td>
					</tr>	
					#end
										
					<tr>
						<td width="15%" class="title align-right">Kewangan</td>
						<td width="15%" class="align-left">
							#if ($financial == "true") 
								Ya
							#else
								Tiada
							#end
						</td>
					</tr>									
				</tbody>
			</table>
        </td>
    </tr> 	
	#end
	
	#if ($isCancel == "true")  
	<tr>
		<td align="left">
			<table width="100%" border="0" cellpadding="0" cellspacing="0">
				<tbody>
					<tr>
						<td width="15%" class="title align-right">Keputusan Mesyuarat</td>
						<td width="15%" class="align-left">$!meetingDecision</td>
					</tr>
				</tbody>
			</table>
        </td>
    </tr> 	
	#end	
    
    #if ($isSupplierFinalization == "true" || $isForwardToHigherAuthority == "true")
	<tr>
		<td align="left">
			<table width="100%" border="0" cellpadding="0" cellspacing="0">
				<tbody>
					<tr>
						<td width="15%" class="title align-right">Keputusan Mesyuarat</td>
						<td width="15%" class="align-left">$!meetingDecision</td>
					</tr>
					<tr>
						<td width="15%" class="title align-right">Pemilihan Berdasarkan</td>
						<td width="15%" class="align-left">$!selectionBasedOn</td>
					</tr>
					<tr>
						<td width="15%" class="title align-right">Kaedah Memuktamadkan Pembekal</td>
						<td width="15%" class="align-left">$!finalizationMethod</td>
					</tr>	
					<tr>
						<td width="15%" class="title align-right">LOI / LOA Disediakan Oleh</td>
						<td width="15%" class="align-left">$!loiLoaPreparedBy</td>
					</tr>	
					
					
					#if ($isForwardToHigherAuthority == "true") 
					<tr>
						<td width="15%" class="title align-right">Sebab</td>
						<td width="15%" class="align-left">$!reason</td>
					</tr>
					<tr>
						<td width="15%" class="title align-right">Peringkat Atasan</td>
						<td width="15%" class="align-left">$!higherAuthority</td>
					</tr>					
					#end	
																		
				</tbody>
			</table>
        </td>
    </tr> 

    <tr>
    	<td>
		#if ($isZonal == "true")
			#if ($zoneDetailsMap.keySet())
				#foreach ($specZoneDtl in $zoneDetailsMap.keySet())
					#set ($zoneReportDTO = $zoneDetailsMap.get($specZoneDtl))
					<span>Zone Name : <b>$specZoneDtl.zoneName</b></span>
					<br/><br/>
								
					#if ($itemized == "true")
						<table width="100%" border="0" cellpadding="0" cellspacing="0">
							<tbody>
								<tr>
									<td width="15%" class="title border left">Item</td>
									<td class="title border right">
										<table width="100%" border="0" cellpadding="0" cellspacing="0">
											<tbody>
												<tr>
													<td width="11%" class="title left">Kod Pembekal</td>
													<td width="12%" class="title left">Status Bumiputra</td>
													<td width="17%" class="title left">Jumlah Harga (RM)</td>
													<td width="11%" class="title left">Jumlah Harga Dalam Perkataan (RM)</td>
												</tr>
											</tbody>
										</table>
									</td>
								</tr>
								#foreach( $item in $zoneReportDTO.recommendedSuppliersByItem.keySet() )
									<tr class="ui-content">
										<td width="15%" class="standard border-bottom left">$item.requestItem.itemName</td>
										#if ($!zoneReportDTO.recommendedSuppliersByItem.get($item) && 
														$zoneReportDTO.recommendedSuppliersByItem.get($item).size() > 0)
											<td class="standard border-bottom right">
												#set ($count = 0)
												#foreach( $evalResultDtlBean in $zoneReportDTO.recommendedSuppliersByItem.get($item) )
													<table width="100%" border="0" cellpadding="0" cellspacing="0">
														<tbody>
															<tr>
																#if ($evalResultDtlBean.awarded == "true" || $evalResultDtlBean.shortlisted == "true")
																	<td width="11%" class="standard left">$evalResultDtlBean.scQtProposal.supplierNo</td>
																	<td width="12%" class="standard left">
																		#if ($evalResultDtlBean.scQtProposal.bumi == "true")
																			Ya
																		#else
																			Tiada
																		#end
																	</td>
																	<td width="17%" class="number left">
																		$numberFormatter.format($evalResultDtlBean.offeredPrice)
																	</td>
																	<td width="11%" class="standard left">
																		$evalResultDtlBean.amountInWords
																	</td>																	
																#else 
																	#set ($count = $count + 1)
																#end														
															</tr>
														</tbody>
													</table>
												#end
												#if ($count == $zoneReportDTO.recommendedSuppliersByItem.get($item).size())
													No shortlisted supplier(s) for this item
												#end										
											</td>
										#else
											<td class="standard border-bottom right">
												No shortlisted supplier(s) for this item
											</td>
										#end
									</tr>
								#end
							</tbody>
						</table>
					#else
						#if ($zoneReportDTO.empty == "false")
							<table width="100%" border="0" cellpadding="0" cellspacing="0">
								<tbody>
									<tr>
										<td width="15%" class="title border left">Kod Pembekal</td>
										<td width="10%" class="title border left">SSM No.</td>
										<td width="15%" class="title border left">Status Bumiputra</td>
										<td width="23%" class="title border left">Jumlah Harga (RM)</td>
										<td width="23%" class="title border left-right">Jumlah Harga Dalam Perkataan (RM)</td>
									</tr>
									#foreach($evalResDtlBean in $zoneReportDTO.recommendedSuppliers)
										#set($String = "formatter")
										<tr class="ui-content">
											<td width="15%" class="standard border-bottom left">
												$evalResDtlBean.scQtProposal.supplierNo
											</td>
											<td width="15%" class="standard border-bottom left">
												$evalResDtlBean.scQtProposal.scQtSupplier.smSupplier.regNo
											</td>
											<td width="12%" class="standard border-bottom left">
												#if ($evalResDtlBean.scQtProposal.bumi == "true")
													Ya
												#else
													Tiada
												#end
											</td>
											<td width="10%" class="number border-bottom left">
												$numberFormatter.format($evalResDtlBean.scQtProposalAmount.proposalAmt)
											</td>
											<td width="10%" class="standard border-bottom left-right">
												$evalResDtlBean.amountInWords
											</td>											
										</tr>
									#end
								</tbody>
							</table>
							<br/>
						#else
							No awarded supplier(s) in this zone
						#end
					#end
					<br/><br/><br/><br/>
				#end
			#end 
		#else
			#if ($itemized == "true")
				<table width="100%" border="0" cellpadding="0" cellspacing="0">
					<tbody>
						<tr>
							<td width="15%" class="title border left">Item</td>
							<td class="title border right">
								<table width="100%" border="0" cellpadding="0" cellspacing="0">
									<tbody>
										<tr>
											<td width="11%" class="title left">Kod Pembekal</td>
											<td width="12%" class="title left">Status Bumiputra</td>
											<td width="13%" class="title left">SSM No.</td>
											<td width="17%" class="title left">Jumlah Harga (RM)</td>
											<td width="17%" class="title left">Jumlah Harga Dalam Perkataan (RM)</td>
										</tr>
									</tbody>
								</table>
							</td>
						</tr>
						#foreach ($item in $reportDTO.recommendedSuppliersByItem.keySet())
							<tr class="ui-content">
								<td width="15%" class="standard border-bottom left">$item.requestItem.itemName</td>
								#if ($reportDTO.recommendedSuppliersByItem.get($item).size() > 0)
									<td class="standard border-bottom right">
										#set ($count = 0)
										#foreach ($evalResultDtlBean in $reportDTO.recommendedSuppliersByItem.get($item))
											<table width="100%" border="0" cellpadding="0" cellspacing="0">
												<tbody>
													<tr>
														#if ($evalResultDtlBean.awarded == "true" || $evalResultDtlBean.shortlisted == "true")
															<td width="11%" class="standard left">$evalResultDtlBean.scQtProposal.supplierNo</td>
															<td width="12%" class="standard left">
																#if ($evalResultDtlBean.scQtProposal.bumi == "true")
																	Ya
																#else
																	Tiada
																#end
															</td>
															<td width="13%" class="standard left alignRight">
																$evalResultDtlBean.scQtProposal.scQtSupplier.smSupplier.regNo
															</td>
															<td width="17%" class="standard left alignRight">
																$numberFormatter.format($evalResultDtlBean.offeredPrice)
															</td>	
															<td width="17%" class="standard left">
																$!evalResultDtlBean.amountInWords
															</td>										
														#else 
															#set ($count = $count + 1)
														#end
													</tr>
												</tbody>
											</table>
									    #end
										#if ($count == 0)
											No shortlisted supplier(s) for this item
										#end							    
									</td>
								#else 
									<td class="standard border-bottom right">
										No shortlisted supplier(s) for this item
									</td>
								#end
							</tr>
						#end
					</tbody>
				</table>
			#else
				<br/>
				#if ($reportDTO.empty == "false")
					<table width="100%" border="0" cellpadding="0" cellspacing="0">
						<tbody>
							<tr>
								<td width="15%" class="title border left">Kod Pembekal</td>
								<td width="10%" class="title border left">SSM No.</td>
								<td width="15%" class="title border left">Status Bumiputra</td>
								<td width="23%" class="title border left-right">Jumlah Harga (RM)</td>
								<td width="40%" class="title border left-right">Jumlah Harga Dalam Perkataan (RM)</td>
							</tr>
							#foreach($evalResDtlBean in $reportDTO.recommendedSuppliers)
								#set($String = "formatter")
								<tr class="ui-content">
									<td width="15%" class="standard border-bottom left">
										$evalResDtlBean.scQtProposal.supplierNo
									</td>
									<td width="12%" class="standard border-bottom left">
										$evalResDtlBean.scQtProposal.scQtSupplier.smSupplier.regNo
									</td>
									<td width="12%" class="standard border-bottom left">
										#if ($evalResDtlBean.scQtProposal.bumi == "true")
											Ya
										#else
											Tiada
										#end
									</td>
									<td width="23%" class="number border-bottom left" >
										$numberFormatter.format($evalResDtlBean.scQtProposalAmount.proposalAmt)
									</td>
									<td width="23%" class="standard border-bottom left-right" style="white-space:normal;">
										$!evalResDtlBean.amountInWords
									</td>									
								</tr>
							#end
						</tbody>
					</table>
					<br/>
				#else
					No awarded supplier(s)<br/><br/>
				#end		
			#end 
		#end  
		</td>  
    </tr>
	#end
	
	<tr>
		<td style='font-weight:bold;font-family: Albertus Medium;'>
			<br/><br/> Ulasan : $!endorsementRemarks <br/><br/>
		</td>
	</tr>
		
	<tr>
		<td><span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'>Pengerusi $!committeeType <br />
		Kementerian Keselamatan Dalam Negeri <br /> $!chairPerson <br/>
		---------------- </span>
		<br /><br/><br/><br/></td>
	</tr>
	
	#foreach($member in $commMembers)
	<tr>
		<td><span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'>Ahli $!committeeType <br />
		(Bahagian Perolehan) <br /> $member.memberName.toUpperCase() <br/>
		---------------- </span>
		<br /><br/><br/><br/></td>
	</tr>
	#end
	
</table>
<br/>
</body>
</html>