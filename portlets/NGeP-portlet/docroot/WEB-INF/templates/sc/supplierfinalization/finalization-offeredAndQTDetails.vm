<html>
<head>
<style>
@page {
	size: A4 portrait;
}

@page { @bottom-center { content:element(footer)
	
}

}
.table2 {
    border-collapse: collapse;
	width:100%;
}
		.table2 th, .table2 td {
			border: 1px solid black;
		}
		 th{
			background-color: #BCE18A;
		 }
.footer {
	display: block;
	text-align: center;
	position: running(footer);
}
</style>
</head>
<body>
<table border="0" cellpadding="0" cellspacing="0" width="100%">
	<tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> KERTAS TAKLIMAT TENDER/SEBUT HARGA UNTUK PERTIMBANGAN </span>
            <br/>
        </td>
    </tr>
    <tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> $commType</span>
			<br/>
        </td>
    </tr>
    <tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> $ptj/$jabatan </span>
			<br/>
        </td>
    </tr>
    <tr>
		<td>
			<p>1. KETERANGAN TAWARAN DAN MAKLUMAT TENDER / SEBUT HARGA</p>
			<ol type="1"> 1.1 Perkara <br/> $title</ol>
			
			<ol>1.2 Amaun Tender / Sebut Harga <br/> $estimatedAmount </ol>
			<ol>1.3 Peruntukan
				<table class="table2" width='100%'>
					<tr>
						<td>Budget Amount</td>
					</tr>
					#foreach( $budgetDtls in $budgetList )
					<tr>
						<td>$budgetDtls.budgetAmt</td>
					</tr>
					#end
				</table> 
			</ol>
			<ol>1.4	Tempoh Perjanjian  (Bermasa) / Tempoh Penyiapan (for One-Off) </ol>
			<ol>1.5	Jabatan Pengguna <br/> $ptj </ol>
			<ol>1.6	Pengiklanan <br/>
				Tarikh Iklan : $publishDate <br/>
				Tarikh Tutup Iklan :  $closingDate
			</ol>
			<ol>1.7 Bilangan Pembekal Menyertai Taklimat Bagi <br/>
				<table class="table2" width='100%'>
					<tr>
						<td>Zone Name</td>
						<td>Total Suppliers</td>
						<td>Description</td>
					</tr>
					#foreach( $briefingList in $list )
					<tr>
						<td></td>
					</tr>
					#end
				</table>
			</ol>
			<ol>1.8	Jumlah Pembekal Yang Layak Menyertai Tender/Sebut Harga: $totalQualifiedSuppliers <br/>
			</ol>
			<ol>1.9	Jumlah Pembekal Yang Menghantar Cadangan: $totalSuppliers<br/>
			</ol>
			<ol>1.10 Maklumat Penyerahan Sampel <br/>
				Tarikh Pembukaan: <br/>
				Bil. Penghantaran Sample: <br/>
				Bil. Sample Yang Ditolak: <br/>
				Bil. Sample Yang Diterima: <br/>
			</ol>
			<ol>1.11 Tempoh Sah Laku Tender/Sebut Harga: $validityDays</ol>
			<ol>1.12 Jenis Tender/ Sebut Harga: $openType </ol>
			<ol>1.13 Bumiputra Status: 
				#if ($openType == "Open")
					#if ($openFor == "B")
						Yes
					#else
						No 
					#end
				#end
			</ol>
			<ol>1.14 PEMBEKAL SEMASA <br/>
				$sp Nama Pembekal : $contract.smSupplier.companyName <br/>
				Nilai Perjanjian Asal : $contract.quotationTender.estimatedAmount <br/>
				Harga Tawaran : <br/>
				Tempoh Perjanjian : $contract.quotationTender.contractDuration <br/>
			</ol>
			<p>2. Ahli-Ahli Jawatankuasa Akhir</p>
			<table class="table2" width='100%'>
				<tr>
					<td>Nama</td>
					<td>Jawatan</td>
					<td>Gred</td>
					<td>Kad Pengenalan No.</td>
					<td>Jabatan </td>
					<td>Peranan</td>
				</tr>
				#foreach( $committeeMember in $committeeActivities )
				<tr>
					<td>$committeeMember.scCommitteeMember.memberName</td>
					<td>$committeeMember.scCommitteeMember.designation</td>
					<td>$committeeMember.scCommitteeMember.grade</td>
					<td>$committeeMember.scCommitteeMember.icPassport</td>
					<td></td>
					<td>$bean.getParameterDesc($committeeMember.scCommitteeMember.memberRole)</td>
				</tr>
				#end
			</table>
		</td>
	</tr>
</table>
</body>
</html>