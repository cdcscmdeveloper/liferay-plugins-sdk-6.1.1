<html>
<head>
	<style>
		@page { size: A4 portrait;}
		@page { @bottom-center { content: element(footer) }}
				
		.footer {
			display: block; text-align: center;
			position: running(footer);
		}
		
		.descTable{
		 	border-collapse: collapse;
		}
		
		.descTable td, .descTable tr, .descTable th {
		 	border: 1px solid black;
		}
		
		body{
			
		}
		
		.txtBold{
			font-weight : bold;
		}
		
		.sTable{
			width : 80%;
		}
		
		.sColTwentyPerc{
			width : 20%;
		}
		
		.infoTable{
			border-collapse: collapse;
			width: 100%;
		}
		.infoTable td {
			border: 1px solid black;
		}
		.tdInfoTable {
			border: 1px solid black;
			font-family: Verdana;
			font-size: 12px;
			font-weight: normal;
			font-style: inherit;
		}
	</style>
</head>
<body>
<table border="0" cellpadding="0" cellspacing="0" width="100%">
	<tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> KERTAS TAKLIMAT TENDER/SEBUT HARGA UNTUK PERTIMBANGAN JAWATANKUASA PEMILIHAN AKHIR PEMBEKAL</span>
            <br/><br/>
        </td>
    </tr>
    <tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> $commType</span>
			<br/><br/>
        </td>
    </tr>
    <tr>
		<td align="center">
			<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'> $ptj <br/> $jabatan </span>
			<br/>
        </td>
    </tr>
</table>
<br/>
<table width='100%'>
	<tr>
		<td align="left">
			<span style="font-family:Thoma;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">
			1. KETERANGAN TAWARAN DAN MAKLUMAT TENDER / SEBUT HARGA </span>
			<br/>
		</td>
	</tr>
</table>
<table class="infoTable">
	<tr>
		<td class="tdInfoTable">1.1</td>
		<td class="tdInfoTable">Perkara</td>
		<td class="tdInfoTable">$title</td>
	</tr>
	<tr>
		<td class="tdInfoTable">1.2</td>
		<td class="tdInfoTable">Amaun Tender / Sebut Harga</td>
		<td class="tdInfoTable">$estimatedAmount</td>
	</tr>
	<tr>
		<td class="tdInfoTable">1.3</td>
		<td class="tdInfoTable">Peruntukan</td>
		<td class="tdInfoTable">
			#if ($isPlanned == "true")
				<table class="infoTable">
					<tr>
						<td>Budget Amount</td>
					</tr>
					#foreach( $budgetDtls in $budgetList )
					<tr>
						<td>$budgetDtls.budgetAmt</td>
					</tr>
					#end
				</table>
			#end
			#if ($isPlanned == "false")
				NA
			#end
		</td>
	</tr>
	<tr>
		<td class="tdInfoTable">1.4</td>
		<td class="tdInfoTable">Tempoh Perjanjian  (Bermasa) / Tempoh Penyiapan (for One-Off)</td>
		<td class="tdInfoTable">$contractDuration</td>
	</tr>
	<tr>
		<td class="tdInfoTable">1.5</td>
		<td class="tdInfoTable">Jabatan Pengguna</td>
		<td class="tdInfoTable">$ptj</td>
	</tr>
	<tr>
		<td class="tdInfoTable">1.6</td>
		<td class="tdInfoTable">Pengiklanan</td>
		<td class="tdInfoTable">
			Tarikh Iklan : $publishDate <br/>
			Tarikh Tutup Iklan : $closingDate
		</td>
	</tr>
	<tr>
		<td class="tdInfoTable">1.7</td>
		<td class="tdInfoTable">Bilangan Pembekal Menyertai Taklimat Bagi</td>
		<td class="tdInfoTable">
			#if ($isZone == "true")
				#foreach( $zoneList in $zoneBeans )
					Zone Name : $zoneList.tplSpecZoneDtl.zoneName
				#end
					Total Suppliers : $supplierSize
			#end
			#if ($isZone == "false")
				
			#end
		</td>
	</tr>
	<tr>
		<td class="tdInfoTable">1.8</td>
		<td class="tdInfoTable">Jumlah Pembekal Yang Layak Menyertai Tender/Sebut Harga</td>
		<td class="tdInfoTable">$totalQualifiedSuppliers</td>
	</tr>
	<tr>
		<td class="tdInfoTable">1.9</td>
		<td class="tdInfoTable">Jumlah Pembekal Yang Menghantar Cadangan</td>
		<td class="tdInfoTable">$totalSuppliers</td>
	</tr>
	<tr>
		<td class="tdInfoTable">1.10</td>
		<td class="tdInfoTable">Maklumat Penyerahan Sampel</td>
		<td class="tdInfoTable">
			#if ($isSample == "true")
				Tarikh Pembukaan: <br/>
				Bil. Penghantaran Sample: <br/>
				Bil. Sample Yang Ditolak: <br/>
				Bil. Sample Yang Diterima: <br/>
			#end
			#if ($isSample == "false")
			#end			
		</td>
	</tr>
	<tr>
		<td class="tdInfoTable">1.11</td>
		<td class="tdInfoTable">Tempoh Sah Laku Tender/Sebut Harga</td>
		<td class="tdInfoTable">$validityDays</td>
	</tr>
	<tr>
		<td class="tdInfoTable">1.12</td>
		<td class="tdInfoTable">Jenis Tender/ Sebut Harga</td>
		<td class="tdInfoTable">$openType 
			#if ($openType == "Open")
				to 
				#if ($openFor == "B")
					Bumiputra
				#else
					All 
				#end
			#end		 				
		</td>
	</tr>
	<tr>
		<td class="tdInfoTable">1.13</td>
		<td class="tdInfoTable">PEMBEKAL SEMASA</td>
		<td class="tdInfoTable">
			#if ($existingContract == "")
				$existingContract
			#else
				Nama Pembekal : $contract.smSupplier.companyName <br/>
				Nilai Perjanjian Asal : $contract.quotationTender.estimatedAmount <br/>
				Harga Tawaran : <br/>
				Tempoh Perjanjian : $contract.quotationTender.contractDuration <br/>
			#end
			
		</td>
	</tr>
</table>
<br/>
<table width='100%'>
	<tr>
		<td align="left">
			<span style="font-family:Thoma;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">
			2. Ahli-Ahli Jawatankuasa Akhir </span>
			<br/>
		</td>
	</tr>
</table>
<table class="infoTable">
	<tr>
		<td class="tdInfoTable" bgcolor="#eee">Nama</td>
		<td class="tdInfoTable" bgcolor="#eee">Jawatan</td>
		<td class="tdInfoTable" bgcolor="#eee">Gred</td>
		<td class="tdInfoTable" bgcolor="#eee">Kad Pengenalan No.</td>
		<td class="tdInfoTable" bgcolor="#eee">Jabatan </td>
		<td class="tdInfoTable" bgcolor="#eee">Peranan</td>
	</tr>
	#foreach( $committeeMember in $committeeActivities )
	<tr>
		<td class="tdInfoTable">$committeeMember.scCommitteeMember.memberName</td>
		<td class="tdInfoTable">$committeeMember.scCommitteeMember.designation</td>
		<td class="tdInfoTable">$committeeMember.scCommitteeMember.grade</td>
		<td class="tdInfoTable">$committeeMember.scCommitteeMember.icPassport</td>
		<td class="tdInfoTable">$committeeMember.scCommitteeMember.pmOrgProfile.orgName</td>
		<td class="tdInfoTable">$bean.getParameterDesc($committeeMember.scCommitteeMember.memberRole)</td>
	</tr>
	#end
</table>
</body>
</html>