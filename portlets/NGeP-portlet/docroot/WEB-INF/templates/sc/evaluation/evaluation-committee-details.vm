<html>
<head>
	<style>
		.ui-content {
			border: 0px solid #f4f4f4 !important;
			background: #ffffff !important;
			color: #4f4f4f !important;
			padding: 5px !important;
		}
		body{
			font-family: "Helvetica";
			font-size: 8pt;
		}
		.header {
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:16px;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
	</style>
</head>
<body>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">Keahlian Jawatankuasa</th>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#6d839b" class="title border left">Nama</th>
			<th bgcolor="#6d839b" class="title border left">Jawatan</th>
			<th bgcolor="#6d839b" class="title border left">Gred</th>
			<th bgcolor="#6d839b" class="title border left">Kad Pengenalan No.</th>
			<th bgcolor="#6d839b" class="title border left">Jabatan</th>
			<th bgcolor="#6d839b" class="title border left-right">Peranan</th>
		</tr>
		#foreach( $committeeMember in $committeeActivities )
			<tr class="ui-content">
				<td class="standard border-bottom left">$committeeMember.scCommitteeMember.memberName</td>
				<td class="standard border-bottom left">$committeeMember.scCommitteeMember.designation</td>
				<td class="standard border-bottom left">$!committeeMember.scCommitteeMember.grade</td>
				<td class="standard border-bottom left">$committeeMember.scCommitteeMember.icPassport</td>
				<td class="standard border-bottom left">$committeeMember.scCommitteeMember.pmOrgProfile.orgName</td>
				<td class="standard border-bottom left-right">$bean.getParameterDesc($committeeMember.scCommitteeMember.memberRole)</td>
			</tr>
		#end
	</tbody>
</table>
<br/>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">Turut Hadir</th>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#6d839b" class="title border left">Nama</th>
			<th bgcolor="#6d839b" class="title border left-right">Kad Pengenalan No.</th>
		</tr>
		#foreach( $memberAttendance in $meetingAttendances )
			<tr class="ui-content">
				<td class="standard border-bottom left">$memberAttendance.name</td>
				<td class="standard border-bottom left-right">$memberAttendance.icPassport</td>
			</tr>
		#end
	</tbody>
</table>
</body>
</html>