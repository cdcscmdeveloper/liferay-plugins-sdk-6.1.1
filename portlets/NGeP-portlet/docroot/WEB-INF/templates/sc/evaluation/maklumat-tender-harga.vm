<html>
<head>
	<style>
		.header {
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:16px;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
	</style>
</head>
<body>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">Maklumat Sebut Harga / Tender</th>
		</tr>
	</tbody>
</table>
<br/>
#if ( $ec == "true")
	<table width="100%" border="0" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				<td width="40%" class="standard border left">Jenis Sebut Harga / Tender</td>
				<td class="standard border left-right">$qtType</td>
			</tr>
			<tr>
				<td width="40%" class="standard border-bottom left">Anggaran Kementerian</td>
				<td class="standard border-bottom left-right">$estimatedPrice</td>
			</tr>
			<tr>
				<td width="40%" class="standard border-bottom left">Tarikh Iklan Sebut Harga / Tender</td>
				<td class="standard border-bottom left-right">$publishDate</td>
			</tr>
			<tr>
				<td width="40%" class="standard border-bottom left">Tarikh Tutup Sebut Harga / Tender</td>
				<td class="standard border-bottom left-right">$closingDate</td>
			</tr>
			<tr>
				<td width="40%" class="standard border-bottom left">Bilangan Pembekal</td>
				<td class="standard border-bottom left-right">$totalSuppliers</td>
			</tr>
		</tbody>
	</table>
#end
#if ( $tec == "true")
	<table width="100%" border="0" cellpadding="0" cellspacing="0">
		<tbody>
			<tr>
				<td width="40%" class="standard border left">Jenis Sebut Harga / Tender</td>
				<td class="standard border left-right">$qtType</td>
			</tr>
			<tr>
				<td width="40%" class="standard border-bottom left">Tarikh Iklan Sebut Harga / Tender</td>
				<td class="standard border-bottom left-right">$publishDate</td>
			</tr>
			<tr>
				<td width="40%" class="standard border-bottom left">Tarikh Tutup Sebut Harga / Tender</td>
				<td class="standard border-bottom left-right">$closingDate</td>
			</tr>
			<tr>
				<td width="40%" class="standard border-bottom left">Bilangan Pembekal</td>
				<td class="standard border-bottom left-right">$totalSuppliers</td>
			</tr>
		</tbody>
	</table>	
#end
</body>
</html>