<html>
<head>
	<style>
		.ui-content {
			border: 0px solid #f4f4f4 !important;
			background: #ffffff !important;
			color: #4f4f4f !important;
			padding: 5px !important;
		}
		body{
			font-family: "Helvetica";
			font-size: 8pt;
		}
		.header {
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:16px;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
	</style>
</head>
<body>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">Perincian Mesyuarat</th>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
	#if ( $ec == "true")
			<tr>
				<td class="standard">
					<span style="font-family:'Arial', sans-serif;font-size:12px;text-align:left;color:#333;">Mesyuarat Jawatankuasa Penilaian Teknikal dan Harga telah diadakan seperti berikut:</span>
				</td>
			</tr>
		#end
		#if ( $oc == "true")
		<tr>
			<td class="standard">
				<span style="font-family:'Arial', sans-serif;font-size:12px;text-align:left;color:#333;">Mesyuarat Jawatankuasa Pembuka telah diadakan seperti berikut:</span>
			</td>
		</tr>
		#end
		#if ( $tec == "true")
			<tr>
				<td class="standard">
					<span style="font-family:'Arial', sans-serif;font-size:12px;text-align:left;color:#333;">Mesyuarat Jawatankuasa Penilaian Teknikal telah diadakan seperti berikut:</span>
				</td>
			</tr>
		#end
		#if ( $fec == "true")
			<tr>
				<td class="standard">
					<span style="font-family:'Arial', sans-serif;font-size:12px;text-align:left;color:#333;">Mesyuarat Jawatankuasa Penilaian Harga telah diadakan seperti berikut:</span>
				</td>
			</tr>
		#end
		<tr>
			<td>
				<table width="100%" border="0" cellpadding="0" cellspacing="0">
					<tbody>
						<tr>
							<th bgcolor="#6d839b" class="title border left">Bil.</th>
							<th bgcolor="#6d839b" class="title border left">Tempat</th>
							<th bgcolor="#6d839b" class="title border left">Tarikh</th>
							<th bgcolor="#6d839b" class="title border left-right">Masa</th>
						</tr>
						#set( $count = 1 )
						#foreach( $meetingDtls in $scQtMeetings )
							<tr class="ui-content">
								<td class="standard border-bottom left">$count</td>
								<td class="standard border-bottom left">$meetingDtls.meetingLocation</td>
								<td class="standard border-bottom left">$meetingDtls.meetDateStr</td>
								<td class="standard border-bottom left-right">$meetingDtls.meetTimeStr</td>
							</tr>
						#set( $count = $count + 1 )
						#end
					</tbody>
				</table>
			</td>
		</tr>
	</tbody>
</table>
</body>
</html>
