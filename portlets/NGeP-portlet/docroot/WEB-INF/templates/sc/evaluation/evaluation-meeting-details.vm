<html>
<head>
	<style>
		#wrapper {
			width:660px;
			margin:0px auto;
			padding:10px;
		}
		#header {
			height:80px;
			padding:10px;
		}
		#content {
			margin-top:10px;
			padding-bottom:10px;
		}
		#content div {
			padding:10px;
			float:left;
		}
		#footer {
			float:left;
			margin-top:10px;
			margin-bottom:10px;
			padding:10px;
			width:630px;
		}
		#bottom {
			clear:both;
			text-align:right;
		}
		body{
			font-family: "Helvetica";
			font-size: 8pt;
		}
		.table2 {
			border-collapse: collapse;
			width:100%;
		}		
		.table2 th, .table2 td {
			border: 1px solid black;
		}		
		th{
			background-color: #BCE18A;
		}
	</style>
</head>
<body>
<div id="wrapper">
	<div id="header">
		#parse("sc/shared/header.vm")
	</div>
	<div id="content" style="height:740px;">
		<table width="100%">
		<tr>
			<td align='center' valign="top">
				<span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'>Perincian Mesyuarat</span>
				<br /><br />
			</td>
		</tr>
		<tr>
			<td>#if ( $ec == "true")
				<p>Mesyuarat Jawatankuasa Penilaian Teknikal dan Harga telah diadakan seperti berikut:</p>
				#end
			</td>
		</tr>
		<tr>
			<td>#if ( $oc == "true")
				<p>Mesyuarat Jawatankuasa Pembuka telah diadakan seperti berikut:</p>
				#end
			</td>
		</tr>
		<tr>
			<td>#if ( $tec == "true")
				<p>Mesyuarat Jawatankuasa Penilaian Teknikal telah diadakan seperti berikut:</p>
				#end
			</td>
		</tr>
		<tr>
			<td>#if ( $fec == "true")
				<p>Mesyuarat Jawatankuasa Penilaian Harga telah diadakan seperti berikut:</p>
				#end
			</td>
		</tr>
		<tr align='left'>
			<td>
				<span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'>
				<table class="table2" width='100%'>
					<tr>
						<td>Bil.</td>
						<td>Tempat</td>
						<td>Tarikh</td>
						<td>Masa</td>
					</tr>
					#set( $count = 1 )
					#foreach( $meetingDtls in $scQtMeetings )
					<tr>
						<td><span style="font-family:Arial;font-size:9px;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">$count</span></td>
						<td><span style="font-family:Arial;font-size:9px;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">$meetingDtls.meetingLocation</span></td>
						
						<td><span style="font-family:Arial;font-size:9px;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">$meetingDtls.meetDateStr</span></td>
						<td><span style="font-family:Arial;font-size:9px;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">$meetingDtls.meetTimeStr</span></td>
					</tr>
					#set( $count = $count + 1 )
					#end
				</table>
				</span>
			</td>
		</tr>
		</table>
	</div>

	<div id="footer">
		#parse("sc/shared/footer.vm")
	</div>
	<div id="bottom"></div>
</div>
</body>
</html>
