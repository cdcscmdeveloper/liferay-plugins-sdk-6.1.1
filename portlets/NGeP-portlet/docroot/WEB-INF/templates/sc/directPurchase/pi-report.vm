<html>
   <head>
      <style>
         @page { size: B3 landscape;}
         body {	 
         font-size: 0.7em !important;
         font-family: Arial !important;
         } 
         .table2 {
         border-collapse: collapse;
         width:100%;
         }
         .table2 th, .table2 td {
         border: 1px solid black;
         }
         th{
         background-color: #DEDEDE;
         }
         @media print {
         thead {display: table-header-group;}
         .break {page-break-after: always;}
         }
         @page {
         @bottom-right {
         content: "Page No:" counter(page) "/" counter(pages);
         font-size: 0.7em !important;
         font-family: Arial !important;
         }
         }
      </style>
   </head>
   <body>
        <table width="100%">
         <tbody>
            <tr>
               <td width="25%">
                  <img src="$imgUrl" align="left" height="50" width="60"/>
               </td>
                <td style="font-family:bold ;text-align:center; vertical-align:middle;"> KERAJAAN MALAYSIA
				<br/>
				<br/>
                	MAKLUMAT MAKLUM BALAS PEMBEKAL PERTANYAAN ITEM 
               </td>
                <td width="25%">
                 <img src="$rightImgUrl" align="right" height="36" width="153"/>				
               </td>
            </tr>
         </tbody>
      </table>
     <hr/>

  <table width="100%">
		<tr>
		   <td width="20%"> Kod Item  </td>
		   <td> $productCode  </td>
		</tr>
		<tr>
		   <td> Item  </td>
		   <td> $itemName </td>
	  </tr>
	  <tr>
		   <td> Maklumat Tambahan </td>
		   <td> $desc </td>
	  </tr>
	  <tr>
		   <td> Unit Ukuran </td>
		   <td> $uom </td>
	 </tr>
	 <tr>
		   <td> Jenis Harga </td>
		   <td> $priceType </td>
	 </tr>
	 <tr>
		   <td> Pembekal </td>
		   <td> $supplierName </td>
	 </tr>
	 <tr>
		   <td> Ketersediaan Stok </td>
		   <td> $stockAvailable </td>
	 </tr>
  </table>
  
   <br/>
   <br/>
 <table class="table2">
		<tr>
		<th width="6%"> Zon </th>
		<th width="8%">  Tempoh Penghantaran </th>
		<th width="10%"> Harga Katalog (RM) </th>
		<th width="10%"> Harga Baru Ditawarkan (RM) </th>
		<th width="8%"> Dari Kuantiti </th>
		<th width="7%"> Kepada Kuantiti </th>
     </tr>
     
      #set( $count = 0 )	
 	  #set ($prevSupplierId = "")
      #set ($supplierId = "")
      #foreach( $requestNoteVo in $requestNoteVOList ) 
      #set ($supplierId = $requestNoteVo.supplierId)
      #if( $count == 0 )  
      	<tr>
		    <td>$requestNoteVo.zone</td>
		    <td style="text-align:right">$requestNoteVo.deliveryTerm</td>
		    <td>$requestNoteVo.cataloguePrice</td>
		    <td style="text-align:right">$requestNoteVo.unitPrice</td>
		    <td style="text-align:right">
		    #if( $requestNoteVo.frQty != 0 )
		    	$requestNoteVo.frQty
		    #end
		    </td>
		    <td style="text-align:right">
		     #if( $requestNoteVo.toQty )
		     	$requestNoteVo.toQty
		     #end	
		     </td>
		</tr>
		#else
		<tr>
		    <td>$requestNoteVo.zone</td>
		    #if( $supplierId != $prevSupplierId )
		    <td style="text-align:right">$requestNoteVo.deliveryTerm</td>
		    #else
		    <td></td>
		    #end
		    <td>$requestNoteVo.cataloguePrice</td>
		    <td style="text-align:right">$requestNoteVo.unitPrice</td>
 			<td style="text-align:right">
		    #if( $requestNoteVo.frQty != 0 )
		    	$requestNoteVo.frQty
		    #end
		    </td>
		    <td style="text-align:right">
		     #if( $requestNoteVo.toQty )
		     	$requestNoteVo.toQty
		     #end	
		     </td>
		</tr>
		#end
		
		#set( $prevSupplierId = $requestNoteVo.supplierId )
      	#set( $count = $count + 1 )
      #end
   </table>
   
   </body>   
 </html>