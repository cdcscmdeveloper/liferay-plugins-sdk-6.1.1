<html>
<head>
	<style>
		@page {
	size: A4 portrait;
}
@page { 
	@bottom-center { 
		content: "Page " counter(page) " / " counter(pages);
	}
}
		.ui-content {
			border: 0px solid #f4f4f4 !important;
			background: #ffffff !important;
			color: #4f4f4f !important;
			padding: 5px !important;
		}
		body{
			font-family: "Arial";
			font-size: 12pt;
		}
		.header {
			 
			font-family:'Arial', sans-serif;
			font-size:12pt;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12pt;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12pt;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
	</style>
</head>
<body>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th  class="header"><u>Senarai Semak Pematuhan Kewangan</u></th>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	#if ($isFinanceOff == "true")
		<tbody>
			<tr>
				<th bgcolor="#6d839b" class="title border left">Bil.</th>
				<th bgcolor="#6d839b" class="title border left">Tajuk</th>
				<th bgcolor="#6d839b" class="title border left-right">Mekanisme</th>
			</tr>
			#set( $count = 1 )
			#foreach( $financeList in $uploadFinanceSpecList )
				<tr class="ui-content">
					<td class="standard border-bottom left">$count</td>
					<td class="standard border-bottom left">$financeList.title</td>
					<td class="standard border-bottom left-right">$bean.getParameterDesc($financeList.definationType)</td>
				</tr>
			#set( $count = $count + 1 )
			#end
		</tbody>
	#end
	#if ($isFinanceOff == "false")
		<span style="font-family:'Arial', sans-serif;font-size:12pt;text-align:left;color:#333;">
		No document for compliance /Tiada dokumen untuk pematuhan </span>
	#end
</table>
</body>
</html>