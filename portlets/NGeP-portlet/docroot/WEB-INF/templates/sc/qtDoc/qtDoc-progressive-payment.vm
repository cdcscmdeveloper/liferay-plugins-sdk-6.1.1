<html>
<head>
	<style>
		@page {
	size: A4 portrait;
}
@page { 
	@bottom-center { 
		content: "Page " counter(page) " / " counter(pages);
	}
}
		.header {
			 
			font-family:'Arial', sans-serif;
			font-size:12pt;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12pt;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12pt;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
	</style>
</head>
<body>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th  class="header"><u>Progressive Payment / Mengikut Kemajuan</u></th>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<td width="35%" class="standard"><nobr>Bilangan Tahap/Peringkat : </nobr></td>
			<td class="standard">$totalPhase</td>
		</tr>
	</tbody>
</table>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#6d839b" class="title border left">Tahap/Peringkat</th>
			<th bgcolor="#6d839b" class="title border left">Perihal</th>
			<th bgcolor="#6d839b" class="title border left">Tempoh Mula</th>
			<th bgcolor="#6d839b" class="title border left">Tempoh Akhir</th>
			<th bgcolor="#6d839b" class="title border left-right">Peratus</th>
		</tr>
		#foreach( $payment in $paymentList )
			<tr class="ui-content">
				<td class="standard border-bottom left">$payment.phaseNo</td>
				<td class="standard border-bottom left">$payment.phaseDesc</td>
				<td class="standard border-bottom left">$payment.fromDate</td>
				<td class="standard border-bottom left">$payment.toDate</td>
				<td class="standard border-bottom left-right">$payment.percentage</td>
			</tr>
		#end
	</tbody>
</table>
</body>
</html>
