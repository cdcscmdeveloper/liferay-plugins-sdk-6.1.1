<html>
<head>
	<style>
		.header {
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:16px;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
	</style>
</head>
<body>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">Compliance of Sample Report / Laporan Pematuhan Sampel</th>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<td width="20%" class="standard"><nobr>Nama PTJ :</nobr></td>
			<td class="standard">$ptj</td>
		</tr>
		<tr>
			<td width="20%" class="standard"><nobr>No. Sebut Harga / Tender :</nobr></td>
			<td class="standard">$title</td>
		</tr>
		<tr>
			<td width="20%" class="standard"><nobr>Tajuk Perolehan :</nobr></td>
			<td class="standard">$qtNo</td>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
#foreach( $tplspecMaster1 in $masters )
	<tbody>
		<tr>
            <th bgcolor="#6d839b" class="title border left">No.</th>
            <th bgcolor="#6d839b" class="title border left">Kod Pembekal</th>
            <th bgcolor="#6d839b" class="title border left">Label</th>
			<th bgcolor="#6d839b" class="title border left">Item Name / Series No. </th>
			<th bgcolor="#6d839b" class="title border left">Status Penyerahan</th>
			<th bgcolor="#6d839b" class="title border left-right">Catatan</th>
		</tr>
			<tr class="ui-content">
				<td class="standard border-bottom left">1</td>
				<td class="standard border-bottom left">1</td>
				<td class="standard border-bottom left">LN150000000000146</td>
				<td class="standard border-bottom left">Laptop 001</td>
				<td class="standard border-bottom left">Submitted & Compliance</td>
				<td class="standard border-bottom left-right"></td>
			</tr>
			<tr class="ui-content">
				<td class="standard border-bottom left">2</td>
				<td class="standard border-bottom left">2</td>
				<td class="standard border-bottom left">LN150000000000148</td>
				<td class="standard border-bottom left">Mouse Pad 002</td>
				<td class="standard border-bottom left">Submitted & Compliance</td>
				<td class="standard border-bottom left-right"></td>
			</tr>
	</tbody>
#end
</table>
</body>
</html>