<html>
<head>
	<style>
		@page { size: A4 portrait;}
		@page { @bottom-center { content: element(footer) }}
				
		.footer {
			display: block; text-align: center;
			position: running(footer);
		}
		
	</style>
</head>
<body>
	<table border="0" cellpadding="0" cellspacing="0" width="100%">
	<tr>
        <td>
            <span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'>Senarai Semak Pematuahan </span>
            <br/> <br/>
        </td>
    </tr>
    <tr align='left'>
        <td>
            <span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'>
				<table width='100%' border="1">
					<tr>
						<td>Title</td>
						<td>Type</td>
					</tr>
					#foreach( $techList in $uploadTechSpecList )
					<tr>
            			<td>$techList.title</td>
            			<td>$techList.definationType.parameterCode</td>
            		</tr>
					#end
				</table>
            </span>
        </td>
    </tr>
    </table>
</body>
</html>