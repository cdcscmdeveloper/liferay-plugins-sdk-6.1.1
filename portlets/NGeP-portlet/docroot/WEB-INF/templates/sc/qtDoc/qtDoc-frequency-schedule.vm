<html>
<head>
	<style>
		@page { size: A4 portrait;}
		@page { @bottom-center { content: element(footer) }}
				
		.footer {
			display: block; text-align: center;
			position: running(footer);
		}
		
	</style>
</head>
<body>
	<table border="0" cellpadding="0" cellspacing="0" width="100%">
	<tr>
        <td align="left">
            Total Frequency : $totalFrequency<br/>
        </td>
    </tr>
    <tr align='left'>
        <td>
            <span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'>
				<table width='100%' border="1">
					<tr>
						<td>No. of Schedule</td>
						<td>Start Period</td>
						<td>End Period</td>
						<td>Total Months</td>
						<td>Schedule Type</td>
					</tr>
					#foreach( $schedule in $scheduleList )
					<tr>
            			<td>$schedule.scheduleNo</td>
            			<td>$schedule.fromDate</td>
            			<td>$schedule.toDate</td>
            			<td></td>
            			<td>$schedule.scheduleType.parameterCode</td>
            		</tr>
					#end
				</table>
            </span>
        </td>
    </tr>
	</table>
</body>
</html>
