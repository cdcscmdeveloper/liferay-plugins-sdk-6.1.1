<html>
<head>
<style>
@page {
	size: A4 portrait;
}

@page { @bottom-center { content:element(footer)
	
}

}
.table2 {
    border-collapse: collapse;
	width:100%;
}
		.table2 th, .table2 td {
			border: 1px solid black;
		}
		 th{
			background-color: #BCE18A;
		 }
.footer {
	display: block;
	text-align: center;
	position: running(footer);
}
</style>
</head>
<body>
	<table border="0" cellpadding="0" cellspacing="0" width="100%">
	<tr>
        <td>
            <span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'>Fulfilment Schedule</span>
            <br/> <br/>
        </td>
    </tr>
	<tr>
        <td align="left">
            Total Fulfilment : $totalFrequency<br/>
        </td>
    </tr>
    <tr align='left'>
        <td>
            <span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'>
				<table class="table2" width='100%'>
					<tr>
						<td>No. of Schedule</td>
						<td>Start Period</td>
						<td>End Period</td>
						<td>Total Months</td>
						<td>Schedule Type</td>
					</tr>
					#foreach( $schedule in $scheduleList )
					<tr>
            			<td>$schedule.scheduleNo</td>
            			<td>$schedule.fromDate</td>
            			<td>$schedule.toDate</td>
            			<td></td>
            			<td>$bean.getParameterDesc($schedule.scheduleType)</td>
            		</tr>
					#end
				</table>
            </span>
        </td>
    </tr>
	</table>
</body>
</html>
