<html>
<head>
<style>
@page {
	size: A4 landscape;
	margin-left: 20px;
	margin-right: 20px;
}

@page { @bottom-center { content:"Page "counter(page)" / "counter(pages);	
}
p {
	text-align: justify;
}
</style>
</head>
<body>
<table width="100%" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<td bgcolor="#6d839b" valign="top" colspan="4" class="title border left" style="text-align: left; background-color: #ddd; padding-left: 5px; padding-right: 5px; font-family: Arial;"><b>TECHNICAL CHECKLIST</b></td>
		</tr>
		<br/><br/>
		<tr>
			<th bgcolor="#144b73" width="30%" valign="top" class="title border left" style="color:white; text-align: center; border: 1px solid white; padding-left: 5px; padding-right: 5px; font-family: Arial;">Title / Document</th>
			<th bgcolor="#144b73" width="30%" valign="top" class="title border left" style="color:white; text-align: center; border: 1px solid white; padding-left: 5px; padding-right: 5px; font-family: Arial;">Mechanism</th>
			<th bgcolor="#144b73" width="30%" valign="top" class="title border left" style="color:white; text-align: center; border: 1px solid white; padding-left: 5px; padding-right: 5px; font-family: Arial;">Supplier Action</th>
			<th bgcolor="#144b73" width="10%" valign="top" class="title border left" style="color:white; text-align: center; border: 1px solid white; padding-left: 5px; padding-right: 5px; font-family: Arial;">Scoring</th>
		</tr>
		#foreach( $techChecklist in $scQtCheckSt2techProposal )
		<tr>
			<td valign="top" class="standard border-bottom left" style="text-align: left; padding-left: 5px; font-family: Arial; font-size:16.5px; border: 1px solid #ddd;">
			$techChecklist.title
			</td>
			<td valign="top" class="standard border-bottom left" style="text-align: left; padding-left: 5px; font-family: Arial; font-size:16.5px; border: 1px solid #ddd;">
			$bean.getParameterDesc($techChecklist.definationType)
			</td>
			<td valign="top" class="standard border-bottom left" style="text-align: left; padding-left: 5px; font-family: Arial; font-size:16.5px; border: 1px solid #ddd;">
			$bean.getParameterDesc($techChecklist.action)
			</td>
			<td valign="top" class="standard border-bottom left" style="text-align: left; padding-left: 5px; font-family: Arial; font-size:16.5px; border: 1px solid #ddd;">
				#if($techChecklist.scoringReq)
					<img src='$hostUrl/NGeP-portlet/css/images/checkbox_checked.png' width="20px" height ="20px"></img>
				#else
					<img src='$hostUrl/NGeP-portlet/css/images/checkbox_unchecked.png' width="20px" height ="20px"></img>
				#end
			</td>
		</tr>
		#end
	</tbody>
</table>
</body>
</html>