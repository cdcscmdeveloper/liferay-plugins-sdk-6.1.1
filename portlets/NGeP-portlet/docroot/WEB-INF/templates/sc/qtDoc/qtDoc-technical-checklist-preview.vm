<html>
<head>
	<style>
@page {
	size: A4 landscape;
	margin-left: 20px;
	margin-right: 20px;
}

@page { @bottom-center { content:"Page "counter(page)" / "counter(pages);	
}
p {
	text-align: justify;
}

.text_family {
	font-family: Arial;
	font-size: 14.5px;
	font-weight: normal;
	font-style: normal;
	line-height: 20px;
	text-decoration: none;
	color: #333333;
}

.text_family_red {
	font-family: Arial;
	font-size: 14.5px;
	font-weight: normal;
	font-style: normal;
	line-height: 20px;
	text-decoration: none;
	color: red;
}

.text_family_medium {
	font-family: Arial;
	font-weight: normal;
	font-style: normal;
	line-height: 20px;
	text-decoration: none;
	font-size: 14.5px;
	color: red;
}

.text_family_small {
	font-family: Arial;
	font-weight: normal;
	font-style: normal;
	line-height: 20px;
	text-decoration: none;
	font-size: 9px;
	color: red;
}

.text_family_bold {
	font-family: Arial;
	font-weight: bold;
	font-size: 14.5px;
	line-height: 20px;
}

.text_family_italic {
	font-family: Arial;
	font-style: italic;
	font-size: 14.5px;
	line-height: 20px;
}

.text_family_header {
	font-family: Arial;
	font-size: 14.5px;
	font-weight: bold;
	line-height: 20px;
}

.text_header_submenu {
	font-family: Arial;
	font-size: 14.5px;
	font-weight: bold;
	font-style: normal;
	line-height: 20px;
	text-decoration: underline;
}

.text_header_submenu_red {
	font-family: Arial;
	font-weight: bold;
	font-style: normal;
	font-size: 14.5px;
	line-height: 20px;
	text-decoration: underline;
	color: red;
}

.text_sub_header_red {
	font-family: Arial;
	font-weight: bold;
	font-style: normal;
	font-size: 14.5px;
	line-height: 20px;
	text-decoration: none;
	color: red;
}

.submenu_padding {
	padding-left: 30px; width: 60%"
}

.text_indent {   
	margin-left: 20px; 
}

hr {
    display: block;
    height: 1px;
    border: 0;
    border-top: 1px solid #ccc;
    margin: 1em auto;
    padding: 0;
}

u {    
	border-bottom: 2px dotted #000;
	text-decoration: none;
}

.break-after {
	page-break-after:always;
}
table {
  border-collapse: collapse;
  width: 100%;
}
tr:nth-child(even) {
  background-color: #D6EEEE;
}
</style>
</head>
<body>
#set($rowCount = 0)
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<td bgcolor="#6d839b" valign="top" colspan="4" class="title border left" style="text-align: left; background-color: #ddd; padding-left: 5px; padding-right: 5px; font-family: Arial;"><b>TECHNICAL CHECKLIST</b></td>
		</tr>
		<br/><br/>
		<tr>
			<th bgcolor="#144b73" width="30%" valign="top" class="title border left" style="color:white; text-align: center; border: 1px solid #ddd; padding-left: 5px; padding-right: 5px; font-family: Arial;">Title / Document</th>
			<th bgcolor="#144b73" width="30%" valign="top" class="title border left" style="color:white; text-align: center; border: 1px solid #ddd; padding-left: 5px; padding-right: 5px; font-family: Arial;">Mechanism</th>
			<th bgcolor="#144b73" width="30%" valign="top" class="title border left" style="color:white; text-align: center; border: 1px solid #ddd; padding-left: 5px; padding-right: 5px; font-family: Arial;">Supplier Action</th>
			<th bgcolor="#144b73" width="10%" valign="top" class="title border left" style="color:white; text-align: center; border: 1px solid #ddd; padding-left: 5px; padding-right: 5px; font-family: Arial;">Scoring</th>
		</tr>
		
		#foreach( $techChecklist in $scQtCheckSt2techProposal )
		
		<tr>
			<td valign="top" class="standard border-bottom left" style="text-align: left; padding-left: 5px; font-family: Arial; font-size:16.5px; border: 1px solid #ddd;">
			$techChecklist.title
			</td>
			<td valign="top" class="standard border-bottom left" style="text-align: left; padding-left: 5px; font-family: Arial; font-size:16.5px; border: 1px solid #ddd;">
			$bean.getParameterDesc($techChecklist.definationType)
			</td>
			<td valign="top" class="standard border-bottom left" style="text-align: left; padding-left: 5px; font-family: Arial; font-size:16.5px; border: 1px solid #ddd;">
			$bean.getParameterDesc($techChecklist.action)
			</td>
			<td valign="top" class="standard border-bottom left" style="text-align: left; padding-left: 5px; font-family: Arial; font-size:16.5px; border: 1px solid #ddd;">
				#if($techChecklist.scoringReq)
					<img src='$hostUrl/NGeP-portlet/css/images/checkbox_checked.png' width="20px" height ="20px"></img>
				#else
					<img src='$hostUrl/NGeP-portlet/css/images/checkbox_unchecked.png' width="20px" height ="20px"></img>
				#end
			</td>
		</tr>
		
		#end
	</tbody>
</table>
</body>
</html>