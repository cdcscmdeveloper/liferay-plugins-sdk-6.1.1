<html>
<head>
	<style>
		.header {
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:16px;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
	</style>
</head>
<body>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">Spesifikasi</th>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
#foreach( $tplspecMaster in $masters )
	<tbody>
		<tr>
			<td width="15%" class="standard"><nobr>Tajuk Templat:</nobr></td>
			<td class="standard">$tplspecMaster.specName</td>
		</tr>
		<tr>
			<td width="15%" class="standard"><nobr>Jenis Item:</nobr></td>
			<td class="standard">$itemType</td>
		</tr>
		<tr>
			<td width="15%" class="standard"><nobr>Jenis Barangan:</nobr></td>
			<td class="standard">$localGoods</td>
		</tr>
	</tbody>
#end
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
#foreach( $tplspecMaster1 in $masters )
	<tbody>
		<tr>
            <th bgcolor="#6d839b" class="title border left">Item</th>
            <th bgcolor="#6d839b" class="title border left">Spesifikasi</th>
            <th bgcolor="#6d839b" class="title border left">UOM</th>
			#if ($tplspecMaster.itemTypeCode.parameterCode == "2")
				<td bgcolor="#6d839b" class="title border left>Kekerapan / Unit Ukuran</td>
				<td bgcolor="#6d839b" class="title border left>Bil. Unit Ukuran Sehari</td>
				<td bgcolor="#6d839b" class="title border left>Bil. Unit Ukuran Sebulan</td>
			#end
            <th bgcolor="#6d839b" class="title border left">Jenis Harga</th>
            <th bgcolor="#6d839b" class="title border left-right">Kuantiti</th>
		</tr>
		#foreach( $tplspecQuestion in $tplspecMaster1.tplSpecQuestions )
		<tr>
			#if ($tplspecQuestion.specCount > 0)
			<td valign="top" bgcolor="#d0eaee" class="standard border-bottom left" rowspan="$tplspecQuestion.specCount"><strong>$tplspecQuestion.clItem</strong></td>
			#end
			<td bgcolor="#f1f1f1" class="standard border-bottom left">$tplspecQuestion.clSpecDetail</td>
			#if ($tplspecQuestion.questionType == "I")
				<td bgcolor="#f1f1f1" class="standard border-bottom left">$tplspecQuestion.clUom.uomName</td>
				#if ($tplspecMaster.itemTypeCode.parameterCode == "2")
					<td align="right" bgcolor="#f1f1f1" class="standard border-bottom left">
						#if ($tplspecQuestion.clUomFrequency)
							$tplspecQuestion.clUomFrequency
						#end
					</td>
					<td align="right" bgcolor="#f1f1f1" class="standard border-bottom left">
						#if ($tplspecQuestion.clUomPerDay)
							$tplspecQuestion.clUomPerDay
						#end
					</td>
					<td align="right" bgcolor="#f1f1f1" class="standard border-bottom left">
						#if ($tplspecQuestion.clUomPerMonth)
							$tplspecQuestion.clUomPerMonth
						#end
					</td>
				#end
				<td bgcolor="#f1f1f1" class="standard border-bottom left">$bean.getParameterDesc($tplspecQuestion.clPriceTypeCode)</td>
				<td align="right" bgcolor="#f1f1f1" class="standard border-bottom left-right">
					#if ($tplspecQuestion.clPriceTypeCode.parameterCode == "03" || $tplspecQuestion.clPriceTypeCode.parameterCode == "07" || $tplspecQuestion.clPriceTypeCode.parameterCode == "09" || $tplspecQuestion.clPriceTypeCode.parameterCode == "10")
						#foreach( $tplSpecTierQtie in $tplspecQuestion.tplSpecTierQties)
							#if ($tplSpecTierQtie.toQty)
								$tplSpecTierQtie.fromQty - $tplSpecTierQtie.toQty 
							#else
								$tplSpecTierQtie.fromQty dan lebih
							#end
							<br/>
						#end
					#else
						$tplspecQuestion.clQuantity
					#end
				</td>
			#else
				#if ($tplspecMaster.itemTypeCode.parameterCode == "2")
					<td colspan="6" bgcolor="#f1f1f1" class="standard border-bottom right"></td>
				#else
					<td colspan="3" bgcolor="#f1f1f1" class="standard border-bottom right"></td>
				#end
			#end
		</tr>
		#end
	</tbody>
#end
</table>
</body>
</html>