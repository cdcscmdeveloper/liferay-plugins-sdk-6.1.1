<html>
<head>
	<style>
		@page { size: A4 portrait;}
		@page { @bottom-center { content: element(footer) }}
		
		.table2 {
    border-collapse: collapse;
	width:100%;
}
		.table2 th, .table2 td {
			border: 1px solid black;
		}
		 th{
			background-color: #BCE18A;
		 }
		 
		.footer {
			display: block; text-align: center;
			position: running(footer);
		}
		
	</style>
</head>
<body>
	
	<table width="100%">
	<tr>
		<td align="left">
			<span style="font-family:Arial;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">Spesifikasi</span>
			<br/> <br/>
		</td>
	</tr>
	#foreach( $tplspecMaster in $masters )
	<tr>
        <td align="left">
			<span style="font-family:Arial;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">Title Template :</span>
			<span style="font-family:Arial;font-size:13px;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">$tplspecMaster.specName</span>
			<br/>
        </td>
    </tr>
    <tr>
        <td align="left">
			<span style="font-family:Arial;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">Item Type :</span>
			<span style="font-family:Arial;font-size:13px;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">$itemType</span>
			<br/>
        </td>
    </tr>
    <tr>
        <td align="left">
			<span style="font-family:Arial;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">Local Goods :</span>
			<span style="font-family:Arial;font-size:13px;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">$localGoods</span>
			<br/>
        </td>
    </tr>
    <tr align='left'>
        <td>
            <span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'>
				<table class="table2">
					<tr>
						<td>Item</td>
						<td>Specification</td>
						<td>UOM</td>
						#if ($tplspecMaster.itemTypeCode.parameterCode == "2")
						<td>Freq. per UOM</td>
						<td>No. UOM per day</td>
						<td>No. UOM per month</td>
						#end
						<td>Price Type</td>
						<td>Quantity</td>
					</tr>
					#foreach( $tplspecQuestion in $tplspecMaster.tplSpecQuestions )
						<tr>
							<td>$tplspecQuestion.clItem</td>
							<td>$tplspecQuestion.clSpecDetail</td>
							#if ($tplspecQuestion.questionType == "I")
							<td>$tplspecQuestion.clUom.uomName</td>
							#if ($tplspecMaster.itemTypeCode.parameterCode == "2")
							<td align="right">
								#if ($tplspecQuestion.clUomFrequency)
									$tplspecQuestion.clUomFrequency
								#end
							</td>
							<td align="right">
								#if ($tplspecQuestion.clUomPerDay)
									$tplspecQuestion.clUomPerDay
								#end
							</td>
							<td align="right">
								#if ($tplspecQuestion.clUomPerMonth)
									$tplspecQuestion.clUomPerMonth
								#end
							</td>
							#end
							<td>$bean.getParameterDesc($tplspecQuestion.clPriceTypeCode)</td>
							<td align="right">
								#if ($tplspecQuestion.clPriceTypeCode.parameterCode == "03")
									#foreach( $tplSpecTierQtie in $tplspecQuestion.tplSpecTierQties )
										$tplSpecTierQtie.fromQty - $tplSpecTierQtie.toQty <br/>
									#end
								#elseif ($tplspecQuestion.clPriceTypeCode.parameterCode == "05")
									#foreach( $tplSpecTierQtie in $tplspecQuestion.tplSpecTierQties )
										$tplSpecTierQtie.fromQty - $tplSpecTierQtie.toQty <br/>
									#end
								#elseif ($tplspecQuestion.clPriceTypeCode.parameterCode == "07")
									#foreach( $tplSpecTierQtie in $tplspecQuestion.tplSpecTierQties )
										$tplSpecTierQtie.fromQty - $tplSpecTierQtie.toQty <br/>
									#end
								#elseif ($tplspecQuestion.clPriceTypeCode.parameterCode == "09")
									#foreach( $tplSpecTierQtie in $tplspecQuestion.tplSpecTierQties )
										$tplSpecTierQtie.fromQty - $tplSpecTierQtie.toQty <br/>
									#end
								#elseif ($tplspecQuestion.clPriceTypeCode.parameterCode == "10")
									#foreach( $tplSpecTierQtie in $tplspecQuestion.tplSpecTierQties )
										$tplSpecTierQtie.fromQty - $tplSpecTierQtie.toQty <br/>
									#end
								#else
									$tplspecQuestion.clQuantity
								#end
							</td>
							#else
								#if ($tplspecMaster.itemTypeCode.parameterCode == "2")
									<td colspan="6"></td>
								#else
									<td colspan="3"></td>
								#end
							#end
						</tr>
					#end
				</table>
            </span>
        </td>
    </tr>
	#end
    </table>
</body>
</html>