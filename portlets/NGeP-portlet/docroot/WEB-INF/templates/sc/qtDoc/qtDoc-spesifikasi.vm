<html>
<head>
	<style>
		@page { size: A4 portrait;}
		@page { @bottom-center { content: element(footer) }}
				
		.footer {
			display: block; text-align: center;
			position: running(footer);
		}
		
	</style>
</head>
<body>
	<table border="0" cellpadding="0" cellspacing="0" width="100%">
	<tr>
        <td align="left">
            Title Template : $title<br/>
        </td>
    </tr>
    <tr>
        <td align="left">
            Item Type : $itemType<br/>
        </td>
    </tr>
    <tr>
        <td align="left">
            Local Goods : $localGoods<br/>
        </td>
    </tr>
    <tr align='left'>
        <td>
            <span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'>
				<table width='100%' border="1">
					<tr>
						<td>Item</td>
						<td>Specification</td>
						<td>UOM</td>
						<td>Quantity</td>
						<td>Answer</td>
						<td>Note</td>
					</tr>
					#foreach( $tplSpecQuestions in $tplSpecQuestionsList )
					<tr>
            			<td>$tplSpecQuestions.clItem</td>
            			<td>$tplSpecQuestions.clSpecDetail</td>
						<td>$tplSpecQuestions.clUom.uomName</td>
						<td>$tplSpecQuestions.clQuantity</td>
						<td>$tplSpecQuestions.clAnswerRequired</td>
						<td>$tplSpecQuestions.clReviewRemark</td>
            		</tr>
					#end
				</table>
            </span>
        </td>
    </tr>
    </table>
</body>
</html>