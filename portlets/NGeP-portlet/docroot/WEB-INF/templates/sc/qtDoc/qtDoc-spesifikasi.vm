<html>
<head>
	<style>
		.header {
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:16px;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12px;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
	</style>
</head>
<body>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th bgcolor="#a2a2a2" class="header">Spesifikasi</th>
		</tr>
	</tbody>
</table>
<br/>

#foreach( $tplspecMaster in $masters )
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<td width="15%" class="standard"><nobr>Tajuk Templat:</nobr></td>
			<td class="standard">$tplspecMaster.specName</td>
		</tr>
		<tr>
			<td width="15%" class="standard"><nobr>Jenis Item:</nobr></td>
			<td class="standard">$bean.getParameterDescForReport($tplspecMaster.itemTypeCode)</td>
		</tr>
		<tr>
			<td width="15%" class="standard"><nobr>Jenis Barangan:</nobr></td>
			<td class="standard">$bean.getParameterDescForReport($tplspecMaster.itemOriginCode)</td>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
            <th bgcolor="#6d839b" class="title border left" rowspan="2">Item</th>
            <th bgcolor="#6d839b" class="title border left">UOM</th>
			#if ($tplspecMaster.itemTypeCode.parameterCode == "2")
				<td bgcolor="#6d839b" class="title border left">Kekerapan / <br/>Unit Ukuran</td>
				<td bgcolor="#6d839b" class="title border left">Bil. Unit <br/>Ukuran Sehari</td>
				<td bgcolor="#6d839b" class="title border left">Bil. Unit <br/>Ukuran Sebulan</td>
			#else
            	<th bgcolor="#6d839b" class="title border left">Jenis Harga</th>
            #end
            #if ($tplspecMaster.qtyByZone && $tplspecMaster.tplSpecZone)
            	<th bgcolor="#6d839b" class="title border left">Zon</th>
            #end
            <th bgcolor="#6d839b" class="title border left-right">Kuantiti</th>
		</tr>
		<tr>
			#if ($tplspecMaster.itemTypeCode.parameterCode == "2")
				#if ($tplspecMaster.qtyByZone && $tplspecMaster.tplSpecZone)
	            	<th bgcolor="#6d839b" class="title border left" colspan="6" style="text-align: center;">Spesifikasi</th>
	            #else
	            	<th bgcolor="#6d839b" class="title border left" colspan="5" style="text-align: center;">Spesifikasi</th>
	            #end
			#else
            	#if ($tplspecMaster.qtyByZone && $tplspecMaster.tplSpecZone)
	            	<th bgcolor="#6d839b" class="title border left" colspan="4" style="text-align: center;">Spesifikasi</th>
	            #else
	            	<th bgcolor="#6d839b" class="title border left" colspan="3" style="text-align: center;">Spesifikasi</th>
	            #end
            #end
		</tr>
		#foreach( $tplspecQuestion in $tplspecMaster.tplSpecQuestions )
		<tr>
			#if ($tplspecQuestion.specCount > 0)
			<td valign="top" bgcolor="#d0eaee" class="standard border-bottom left" rowspan="$tplspecQuestion.specCount"><strong>$tplspecQuestion.clItem</strong></td>
			#end
			#if ($tplspecQuestion.questionType == "S")
				#if ($tplspecMaster.itemTypeCode.parameterCode == "2")
					#if ($tplspecMaster.qtyByZone && ($tplspecQuestion.clPriceTypeCode.parameterCode == "05" || $tplspecQuestion.clPriceTypeCode.parameterCode == "07" || $tplspecQuestion.clPriceTypeCode.parameterCode == "10"))
						<td bgcolor="#f1f1f1" class="standard border-bottom left-right" colspan="8">$tplspecQuestion.clSpecDetail</td>
					#else
						<td bgcolor="#f1f1f1" class="standard border-bottom left-right" colspan="7">$tplspecQuestion.clSpecDetail</td>
					#end
				#else
					#if ($tplspecMaster.qtyByZone && ($tplspecQuestion.clPriceTypeCode.parameterCode == "05" || $tplspecQuestion.clPriceTypeCode.parameterCode == "07" || $tplspecQuestion.clPriceTypeCode.parameterCode == "10"))
						<td bgcolor="#f1f1f1" class="standard border-bottom left-right" colspan="5">$tplspecQuestion.clSpecDetail</td>
					#else
						<td bgcolor="#f1f1f1" class="standard border-bottom left-right" colspan="4">$tplspecQuestion.clSpecDetail</td>
					#end
				#end
			#else			
				<td bgcolor="#f1f1f1" class="standard border-bottom left">$tplspecQuestion.clUom.uomName</td>
				#if ($tplspecMaster.itemTypeCode.parameterCode == "2")
					<td bgcolor="#f1f1f1" class="standard border-bottom left" style="text-align: right;">
						#if ($tplspecQuestion.clUomFrequency)
							$tplspecQuestion.clUomFrequency
						#end
					</td>
					<td bgcolor="#f1f1f1" class="standard border-bottom left" style="text-align: right;">
						#if ($tplspecQuestion.clUomPerDay)
							$tplspecQuestion.clUomPerDay
						#end
					</td>
					<td bgcolor="#f1f1f1" class="standard border-bottom left" style="text-align: right;">
						#if ($tplspecQuestion.clUomPerMonth)
							$tplspecQuestion.clUomPerMonth
						#end
					</td>
				#else
					<td bgcolor="#f1f1f1" class="standard border-bottom left">$bean.getParameterDescForReport($tplspecQuestion.clPriceTypeCode)</td>
				#end
				#if ($tplspecMaster.qtyByZone && ($tplspecQuestion.clPriceTypeCode.parameterCode == "05" || $tplspecQuestion.clPriceTypeCode.parameterCode == "07" || $tplspecQuestion.clPriceTypeCode.parameterCode == "10"))
					<td bgcolor="#f1f1f1" class="standard border-bottom left">
						#foreach( $tplSpecZoneQty in $tplspecQuestion.tplSpecZoneQties)
							$tplSpecZoneQty.tplSpecZoneDtl.zoneName
							<br/>
						#end
					</td>
				#end
				<td bgcolor="#f1f1f1" class="standard border-bottom left-right" style="text-align: right;">
					#if ($tplspecQuestion.clPriceTypeCode.parameterCode == "05")
						#if ($tplspecMaster.qtyByZone)
							#foreach( $tplSpecZoneQty in $tplspecQuestion.tplSpecZoneQties)
								$tplSpecZoneQty.qty
								<br/>	
							#end
						#else
							$tplspecQuestion.clQuantity
						#end
					#elseif ($tplspecQuestion.clPriceTypeCode.parameterCode == "03" || $tplspecQuestion.clPriceTypeCode.parameterCode == "07" || $tplspecQuestion.clPriceTypeCode.parameterCode == "09" || $tplspecQuestion.clPriceTypeCode.parameterCode == "10")
						#foreach( $tplSpecTierQtie in $tplspecQuestion.tplSpecTierQties)
							#if ($tplSpecTierQtie.toQty)
								$tplSpecTierQtie.fromQty - $tplSpecTierQtie.toQty 
							#else
								$tplSpecTierQtie.fromQty dan lebih
							#end
							<br/>
						#end
					#else
						$tplspecQuestion.clQuantity
					#end
				</td>
			#end
		</tr>
		#end
	</tbody>
</table>
<br/>
<br/>
#end
</body>
</html>