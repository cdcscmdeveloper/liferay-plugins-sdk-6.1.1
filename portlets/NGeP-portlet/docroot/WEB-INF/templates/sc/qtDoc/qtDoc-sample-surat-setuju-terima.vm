	<tbody>
	<tr>
		<td align="center" class="text_family_header">SURAT SETUJU TERIMA</td>
	</tr>
	<tr>
		<td align="center" class="text_family_header">(Bagi $procurementMode Bekalan/ Perkhidmatan) <br /><br /><br /></td>
	</tr>
	<tr>
		<td align="right" class="text_family">Rujukan Kami : ............................................</td>
	</tr>
	<tr>
