<html>
<head>
<style>
@page {
	size: A4 portrait;
}

@page { @bottom-center { content:element(footer)
	
}

}
.table2 {
    border-collapse: collapse;
	width:100%;
}
		.table2 th, .table2 td {
			border: 1px solid black;
		}
		 th{
			background-color: #BCE18A;
		 }
.footer {
	display: block;
	text-align: center;
	position: running(footer);
}
</style>
</head>
<body>
	<table border="0" cellpadding="0" cellspacing="0" width="100%">
	<tr>
        <td>
            <span style='font-weight:bold;font-size:20px;font-family: Albertus Medium;'>Delivery/Service Address</span>
            <br/> <br/>
        </td>
    </tr>
	<tr align='left'>
        <td>
            <span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'>
        		#foreach( $deliveryaddress in $deliveryAddressBean )
					#if ( $isOneOff)
						$deliveryaddress.tplSpecZoneDtl.zoneName<br/>
	            	#end
					<table class="table2" width='100%'>
	            		<tr>
	            			<td>PTJ</td>
	            			<td>Delivery Address</td>
	            		</tr>
	            		#foreach( $deliveryLoc in $deliveryaddress.deliveryLocList )
	            		<tr>
	            			<td>$deliveryLoc.pmAddressType.pmOrgProfile.orgName</td>
	            			<td>$deliveryLoc.deliveryAddress</td>
	            		</tr>
	             		#end
	            	</table>
	            #end
		    </span>
		 </td>
	</tr>
	</table>
</body>
</html>
