<html>
<head>
	<style>
	@page {
	size: A4 portrait;
}
@page { 
	@bottom-center { 
		content: "Page " counter(page) " / " counter(pages);
	}
}
	
		.ui-content {
			border: 0px solid #f4f4f4 !important;
			background: #ffffff !important;
			color: #4f4f4f !important;
			padding: 5px !important;
		}
		body{
			font-family: "Arial";
			font-size: 12pt;
		}
		.header {
			
			font-family:'Arial', sans-serif;
			font-size:12pt;
			font-weight: bold;
			text-align:left;
		}
		.standard{
			color: #333; 
			font-family:'Arial', sans-serif;
			font-size:12pt;
			text-align:left;
		}
		.title{
			color: #fff; 
			font-family:'Arial', sans-serif;
			font-size:12pt;
			font-weight: bold;
			text-align:left;
		}
		.border{
			border-TOP: 1px solid #a2a2a2;
			border-bottom: 1px solid #a2a2a2;
		}
		.border-bottom{
			border-bottom: 1px solid #a2a2a2;
		}
		.left-right {
			border-left: 1px solid #a2a2a2;
			border-right: 1px solid #a2a2a2;
		}
		.left{
			border-left: 1px solid #a2a2a2;
		}
		.right{
			border-right: 1px solid #a2a2a2;
		}
		table, td, th {
			border: 0 solid #555;
		}
		table{
			width: 100%;
		}
		th{
			height: 20px;
			padding: 5px 5px 5px 10px;
		}
		td{
			height: 18px;
			padding: 5px 5px 5px 10px;
		}
		.white{
			color:#fff;
		}
	</style>
</head>
<body>
<table width="100%" border="0" bordercolor="#142396" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<th  class="header"><u>Alamat Penghantaran / Perkhidmatan</u></th>
		</tr>
	</tbody>
</table>
<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	#foreach( $deliveryaddress in $deliveryAddressBean )
		#if ( $isOneOff)
			$deliveryaddress.tplSpecZoneDtl.zoneName<br/>
		#end
		<tbody>
			<tr>
				<th bgcolor="#6d839b" class="title border left">PTJ</th>
				<th bgcolor="#6d839b" class="title border left-right">Alamat Penghantaran / Perkhidmatan</th>
			</tr>
			#foreach( $deliveryLoc in $deliveryaddress.deliveryLocList )
				<tr class="ui-content">
					<td class="standard border-bottom left">$deliveryLoc.pmAddressType.pmOrgProfile.orgName</td>
					<td class="standard border-bottom left-right">$deliveryLoc.deliveryAddress</td>
				</tr>
			#end
		</tbody>
	#end
</table>
</body>
</html>
