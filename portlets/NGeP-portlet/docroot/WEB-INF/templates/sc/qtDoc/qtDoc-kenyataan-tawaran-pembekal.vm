<html>
<head>
<style>
@page {
	size: A4 portrait;
}
@page { 
	@bottom-center { 
		content: "Page " counter(page) " / " counter(pages);
	}
}
.table2 {
	border-collapse: collapse;
	width:100%;
}
.table2 th, .table2 td {
	border: 1px solid black;
}
th{
	background-color: #BCE18A;
}
.footer {
	display: block;
	text-align: center;
	position: running(footer);
}
.headerfont {
	font-weight:bold;
	font-size:12pt;
	font-family: Arial;
}
.textfont {
	font-size:12pt;;
	font-family: Arial;
}
</style>
</head>
<body>
	<div style="border: 0px solid #a1a1a1;">
		<table style="width: 100%;" border="0" cellspacing="0" cellpadding="0">
			<tbody>
				<tr align="center">
					<td><img src='http://$hostUrl/NGeP-portlet/css/images/Lambang_Malaysia_2010.jpg' width='124' height='100' />
						</td>
				</tr>
				<tr align="center">
					<td><span
						style="font-weight: bold; font-size: 12pt; font-family: Arial;">$ministry</span></td>
				</tr>
				<tr align="center">
					<td><span
						style="font-weight: bold; font-size: 12pt; font-family: Arial;">$ptj</span>
						<br /></td>
				</tr>
			</tbody>
		</table>
	</div> 
	<table width="100%">
		<tr>
			<td>
				<br />
			</td>
		</tr>
		<tr>
			<td>
				<div align="center"><span style="font-family:Arial;font-size:12pt;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;"><u>KENYATAAN TAWARAN</u></span></div>
				<p><span style="font-family:Arial;font-size:12pt;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">Pembekal adalah dipelawa daripada Syarikat-syarikat yang berdaftar dengan <span style="font-family:Arial;font-size:12pt;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">KEMENTERIAN KEWANGAN MALAYSIA</span> dalam kod bidang yang berkaitan dan kriteria berkaitan seperti berikut:</span></p>
			</td>
		</tr>
		<tr>
			<td>
				<p></p>
			</td>
		</tr>
		<tr>
			<td align="left"><span style="font-family:Arial;font-size:12pt;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">KETERANGAN TAWARAN :</span> $qtTitle</td>
		</tr>
		<tr>
			<td align="left"><span style="font-family:Arial;font-size:12pt;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">JENIS TAWARAN :</span> $qtType</td>
		</tr>
		#if($panel == "true")
		#else
			<tr>
				<td align="left">
					<span style="font-family:Arial;font-size:12pt;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">KOD BIDANG :</span> <br /><br />
				</td>
			</tr>
			<tr align='left'>
				<td>
					<table class="table2" width='100%'>
						<span class="headerfont">
						<tr>
							<td width="10%" bgcolor="#a2a2a2">Kod Bidang</td>
							<td width="25%" bgcolor="#a2a2a2">Bidang</td>
							<td  width="35%" bgcolor="#a2a2a2">Sub Bidang</td>
							<td  width="30%" bgcolor="#a2a2a2">Pecahan Sub Bidang</td>
						</tr>
						</span>
						#foreach( $categoryResults in $categoryResults1 )
							<span class="textfont">
							<tr>
								<td>
									$categoryResults.pmCategoryL1.categoryL1Code
									$categoryResults.pmCategoryL2.categoryL2Code
									$categoryResults.pmCategoryL3.categoryL3Code
								</td>
								<td>$categoryResults.pmCategoryL3.pmCategoryL2.pmCategoryL1.categoryName</td>
								<td>$categoryResults.pmCategoryL3.pmCategoryL2.categoryName</td>
								<td>$categoryResults.pmCategoryL3.categoryName</td>
							</tr>
							</span>
						#end
					</table>
				</td>
			</tr>
		#end
		<tr>
			<td>
				<br />
			</td>
		</tr>
		<tr>
			<td align="left"><span style="font-family:Arial;font-size:12pt;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">TARIKH MULA TAWARAN :</span> $publishDate</td>
		</tr>
		<tr>
			<td align="left"><span style="font-family:Arial;font-size:12pt;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">TARIKH TUTUP TAWARAN :</span> $closingDate</td>
		</tr>
		<tr>
			<td align="left"><span style="font-family:Arial;font-size:12pt;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">TEMPOH SAH LAKU :</span> $validityPeriod</td>
		</tr>
		<tr>
			<td align="left"><span style="font-family:Arial;font-size:12pt;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">JUMLAH HARGA INDIKATIF (RM) :</span> $estimatedAmount</td>
		</tr>
		#if($panel == "true")
			
		#else
			<tr>
				<td align="left"><span style="font-family:Arial;font-size:12pt;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">LOKALITI :</span> 
				</td>
			</tr>
			<tr>
				<td>
					#if ($locLevel == "true")
						<span style="font-family:Arial;font-size:12pt;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">Lokaliti Liputan :</span> $locationLevel <br/>
						<span class="headerfont"> Lokaliti </span>
						<table width='100%' class="table2">
						<span class="headerfont">
							<tr>
								<td>Perincian Zon</td>
								<td>Negeri</td>
								#if ($locationLevel == "District")
									<td>Daerah</td>
								#end
							</tr>
						</span>
							#foreach($location in $zoneLocality)
								#foreach($locCriteria in $location.tplSpecZoneLocs)
								<span class="textfont">
								<tr>
									<td>$location.zoneName</td>
									<td>
										$locCriteria.pmState.stateName
									</td>
									#if ($locationLevel == "District")
										<td>
											$locCriteria.pmDistrict.districtName
										</td>
									#end
								</tr>
								</span>
								#end
							#end
						</table>
					#end
					#if ($locLevel == "false")
						#if ($subLocLevel == "true")
							<span class="headerfont"> lokasi </span>
							<table width='100%' class="table2">
							<span class="headerfont">
								<tr>
									<td>Negeri</td>
									#if ($locationLevel == "District")
										<td>Daerah</td>
									#end
								</tr>
								</span>
								#foreach($tplSpecLoc in $locality)
								  <span class="textfont">
									<tr>
										<td>
											$tplSpecLoc.pmState.stateName
										</td>
										#if ($locationLevel == "District")
											<td>
												$tplSpecLoc.pmDistrict.districtName
											</td>
										#end
									</tr>
								</span>
								#end
							</table>
						#end
						#if ($subLocLevel == "false")
							<span style="font-family:Arial;font-size:12pt;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">Semua Negeri</span>
						#end
					#end
				</td>
			</tr>
		#end
		
		<tr align='left'>
	        <td>
				#if ( $bsvReq == 'true' )
					<p style="text-align:justify;"><span style="font-family:Arial;font-size:12pt;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">Pembekal yang berminat adalah diwajibkan hadir ke sesi lawatan tapak dan taklimat pada ketetapan berikut:</span></p>
					#foreach( $zoneList in $zoneBeans )
						<span class="headerfont">
							#if ( $isZone)
								$zoneList.tplSpecZoneDtl.zoneName<br/>
			            	#end
						</span> <br/>
						#if($zoneList.briefingList && $zoneList.briefingList.size() > 0)
						<span class="headerfont">Perincian Taklimat</span>
							<table width='100%' class="table2">
								<span class="headerfont">
								<tr>
			            			<td>Perihal</td>
			            			<td>Tarikh / Masa</td>
			            			<td>Lokasi</td>
			            			<td>Pegawai Penyelaras</td>
			            			<td>Kehadiran Maksima</td>
			            		</tr>
								</span>
			            		#foreach( $briefingdtls in $zoneList.briefingList )
			            			#if($briefingdtls.bsvStatus.statusId != $QTStatusConst.BSV_CANCELLED)
									<span class="textfont">
									<tr>
										<td>$briefingdtls.bsvDesc</td>
										<td>$commonUtils.getFormattedDate($briefingdtls.bsvDate, "dd/MM/yyyy hh:mm a")</td>
										<td>$briefingdtls.location,<br/>$AddressUtils.getFullFormattedAddress($briefingdtls.address)</td>
										<td>$briefingdtls.coordinatingOfficer</td>
										<td>$briefingdtls.maxNoOfAttendance</td>
									</tr>
									</span>
									#end
								#end
							</table>
							<br />
						#end
						#if($zoneList.sitevisitList && $zoneList.sitevisitList.size() > 0)
						<span class="headerfont">Perincian Lawatan Tapak</span>
							<table width='100%' class="table2">
								<span class="headerfont">
			            		<tr>
			            			<td>Perihal</td>
			            			<td>Tarikh / Masa</td>
			            			<td>Lokasi</td>
			            			<td>Pegawai Penyelaras</td>
			            			<td>Kehadiran Maksima</td>
			            		</tr>
								</span>
			            		#foreach( $sitevisitdtls in $zoneList.sitevisitList )
			            			#if($sitevisitdtls.bsvStatus.statusId != $QTStatusConst.BSV_CANCELLED)
									<span class="textfont">
									<tr>
										<td>$sitevisitdtls.bsvDesc</td>
										<td>$commonUtils.getFormattedDate($sitevisitdtls.bsvDate,"dd/MM/yyyy hh:mm a")</td>
										<td>$sitevisitdtls.location,<br/>$AddressUtils.getFullFormattedAddress($sitevisitdtls.address)</td>
										<td>$sitevisitdtls.coordinatingOfficer</td>
										<td>$sitevisitdtls.maxNoOfAttendance</td>
									</tr>
									</span>
									#end
			             		#end
							</table>
							<span class="headerfont">
								Wajib Hadir : 
								#if ($zoneList.scQtBsv.allSiteVisitReq)
									Ya
								#else 
									Tiada 
								#end
							</span> <br/> <br/>
						#end
					#end
				#end
	        </td>
	    </tr>
		<tr align="left">
			<td>#if ($fulfilmentType == "true")
					<p style="text-align:justify;"><span style="font-family:Arial;font-size:12pt;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">Syarikat/Firma/Koperasi/Pemilikan Tunggal hendaklah mengambil perhatian bahawa setiap transaksi melalui Sistem ePerolehan akan dikenakan fi perkhidmatan sebanyak 0.8% (kosong perpuluhan lapan peratus) mengikut setiap nilai invois yang dikemukakan kepada Kerajaan tertakluk kepada had maksimum RM 9,600.00 (Ringgit Malaysia: Sembilan Ribu dan Enam Ratus) bagi invois yang bernilai RM 1.2 juta (Ringgit Malaysia: Satu Juta Dua Ratus Ribu) atau lebih.</span></p>
				#end 
				#if ($fulfilmentType == "false")
					<p style="text-align:justify;"><span style="font-family:Arial;font-size:12pt;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">Syarikat/Firma/Koperasi/Pemilikan Tunggal hendaklah mengambil perhatian bahawa setiap transaksi melalui Sistem ePerolehan akan dikenakan fi perkhidmatan sebanyak 0.4% (kosong perpuluhan empat peratus) mengikut setiap nilai invois yang dikemukakan kepada Kerajaan tertakluk kepada had maksimum RM 4,800.00 (Ringgit Malaysia : Empat Ribu dan Lapan Ratus) bagi invois yang bernilai RM 1.2 juta (Ringgit Malaysia : Satu Juta Dua Ratus Ribu) atau lebih.</span></p>
				#end
			</td>
		</tr>
	</table>
</body>
</html>