<html>
<head>
<style>
@page {
	size: A4 portrait;
}

@page { @bottom-center { content:element(footer)
	
}

}
.table2 {
    border-collapse: collapse;
	width:100%;
}
		.table2 th, .table2 td {
			border: 1px solid black;
		}
		 th{
			background-color: #BCE18A;
		 }
.footer {
	display: block;
	text-align: center;
	position: running(footer);
}
</style>
</head>
<body>
	<div style="border: 0px solid #a1a1a1;">
		<table style="width: 100%;" border="0" cellspacing="0" cellpadding="0">
			<tbody>
				<tr align="center">
					<td><img
						src="http://localhost:8080/NGeP-portlet/resources/ep/images/Lambang_Malaysia_2010.jpg"
						alt="" width="124" height="100" /></td>
				</tr>
				<tr align="center">
					<td><span
						style="font-weight: bold; font-size: 16px; font-family: Albertus Medium;">$ministry</span></td>
				</tr>
				<tr align="center">
					<td><span
						style="font-weight: bold; font-size: 16px; font-family: Albertus Medium;">$agency</span>
						<br /></td>
				</tr>
			</tbody>
		</table>
	</div>
	<table width="100%">
			<tr>
				<td>
					<br />
				</td>
			</tr>
			<tr>
				<td>
					<span style="font-family:Arial;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;"><u>KENYATAAN TAWARAN</u></span>
					<p><span style="font-family:Arial;font-size:13px;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">Pembekal adalah dipelawa daripada Syarikat-syarikat yang berdaftar dengan <span style="font-family:Arial;font-size:13px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">KEMENTERIAN KEWANGAN MALAYSIA</span> dalam kod bidang yang berkaitan and kriteria berkaitan seperti berikut:</span></p>
				</td>
			</tr>
			<tr>
				<td>
					<p></p>
				</td>
			</tr>
			<tr>
				<td align="left"><span style="font-family:Arial;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">KETERANGAN TAWARAN :</span> $qtTitle</td>
			</tr>
			<tr>
				<td align="left"><span style="font-family:Arial;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">JENIS TAWARAN :</span> $qtType</td>
			</tr>
			<tr>
				<td align="left"><span style="font-family:Arial;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">KOD BIDANG :</span> <br />
				<br /></td>
			</tr>
			<tr align='left'>
				<td>
					<span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'>
						<table class="table2" width='100%'>
							<tr>
								<td>Category Code</td>
								<td>Main-Category</td>
								<td>Sub-Category</td>
								<td>Sub-Category Division</td>
								<td>Mandatory</td>
							</tr>
							#foreach( $categoryResults in $categoryResults1 )
							<tr>
								<td>
									$categoryResults.pmCategoryL1.categoryL1Code
									$categoryResults.pmCategoryL2.categoryL2Code
									$categoryResults.pmCategoryL3.categoryL3Code
								</td>
								<td>$categoryResults.pmCategoryL3.pmCategoryL2.pmCategoryL1.categoryName</td>
            					<td>$categoryResults.pmCategoryL3.pmCategoryL2.categoryName</td>
            					<td>$categoryResults.pmCategoryL3.categoryName</td>
            					<td>#if ($categoryResults.mandatory)
										Yes
									#else 
										No 
									#end
            					</td>
							</tr>
							#end
						</table>
					</span>
				</td>
			</tr>
			<tr>
				<td>
					<br />
				</td>
			</tr>
			<tr>
				<td align="left"><span style="font-family:Arial;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">TARIKH MULA TAWARAN :</span> $publishDate</td>
			</tr>
			<tr>
				<td align="left"><span style="font-family:Arial;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">TARIKH TUTUP TAWARAN :</span> $closingDate</td>
			</tr>
			<tr>
				<td align="left"><span style="font-family:Arial;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">TEMPOH SAH LAKU :</span> $validityPeriod</td>
			</tr>
			<tr>
				<td align="left"><span style="font-family:Arial;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">LOKALITI :</span> 
				</td>
			</tr>
			<tr>
				<td>
					#if ($locLevel == "true")
						<span style="font-family:Arial;font-size:14px;font-weight:bold;font-style:normal;text-decoration:none;color:#333333;">Location Level :</span> $locationLevel <br/>
						
						<span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'> Location
						<table width='100%' class="table2">
		            		<tr>
		            			<td>Zone</td>
								<td>State</td>
								#if ($locationLevel == "District")
									<td>District</td>
								#end
		            		</tr>
							#foreach($location in $zoneLocality)
								#foreach($locCriteria in $location.tplSpecZoneLocs)
								<tr>
									<td>$location.zoneName</td>
									<td>
										$locCriteria.pmState.stateName
									</td>
									#if ($locationLevel == "District")
										<td>
											$locCriteria.pmDistrict.districtName
										</td>
									#end
									
								</tr>
								#end
							#end
						</table>
					</span>
					#end
					#if ($locLevel == "false")
						#if ($subLocLevel == "true")
							<span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'> Location
							<table width='100%' class="table2">
								<tr>
									<td>State</td>
									#if ($locationLevel == "District")
										<td>District</td>
									#end
								</tr>
								#foreach($tplSpecLoc in $locality)
									<tr>
										<td>
											$tplSpecLoc.pmState.stateName
										</td>
										#if ($locationLevel == "District")
											<td>
												$tplSpecLoc.pmDistrict.districtName
											</td>
										#end
									</tr>
								#end
							</table>
							</span>
						#end
						#if ($subLocLevel == "false")
						#end
						
					#end
				</td>
			</tr>
			<tr>
				<td>
					<p style="text-align:justify;"><span style="font-family:Arial;font-size:13px;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">Pembekal yang berminat adalah diwajibkan hadir ke sesi lawatan tapak dan taklimat pada ketetapan berikut:</span></p> 
				</td>
			</tr>
			<tr align='left'>
		        <td>
		            <span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'>
		            	
		            		 #foreach( $zoneList in $zoneBeans )
		            		 	#if ( $isZone)
									$zoneList.tplSpecZoneDtl.zoneName<br/>
				            	#end
		            		 	Site Visit Same As Briefing : 
								#if ($zoneList.scQtBsv.sameBsv)
									Yes
								#else 
									No 
								#end<br/>
		            		 	<table width='100%' class="table2">
				            		<tr>
				            			<td>Description</td>
				            			<td>Date/Time</td>
				            			<td>Location</td>
				            			<td>Coordinationg Officer</td>
				            			<td>Max Attendance</td>
				            		</tr>
				            		#foreach( $briefingdtls in $zoneList.briefingList )
				            		<tr>
				            			<td>$briefingdtls.bsvDesc</td>
				            			<td>$briefingdtls.bsvDate</td>
				            			<td>$briefingdtls.location</td>
				            			<td>$briefingdtls.coordinatingOfficer</td>
				            			<td>$briefingdtls.maxNoOfAttendance</td>
				            		</tr>
				             		#end
				            	</table>
								Attendance for Briefing : 
								#if ($zoneList.scQtBsv.allBriefingReq)
									Yes
								#else 
									No 
								#end<br/>
								<br />
								<table width='100%' class="table2">
				            		<tr>
				            			<td>Description</td>
				            			<td>Date/Time</td>
				            			<td>Location</td>
				            			<td>Coordinationg Officer</td>
				            			<td>Max Attendance</td>
				            		</tr>
				            		#foreach( $sitevisitdtls in $zoneList.sitevisitList )
				            		<tr>
				            			<td>$sitevisitdtls.bsvDesc</td>
				            			<td>$sitevisitdtls.bsvDate</td>
				            			<td>$sitevisitdtls.location</td>
				            			<td>$sitevisitdtls.coordinatingOfficer</td>
				            			<td>$sitevisitdtls.maxNoOfAttendance</td>
				            		</tr>
				             		#end
				            	</table>
								Attendance for Site Visit : 
								#if ($zoneList.scQtBsv.allSiteVisitReq)
									Yes
								#else 
									No 
								#end<br/>
							#end
		            	
		            </span>
		        </td>
		    </tr>
			<tr align="left">
				<td>#if ($fulfilmentType == "true")
						<p style="text-align:justify;"><span style="font-family:Arial;font-size:13px;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">Syarikat/Firma/Koperasi/Pemilikan Tunggal hendaklah mengambil perhatian bahawa setiap transaksi melalui Sistem ePerolehan akan dikenakan fi perkhidmatan sebanyak 0.8% (kosong perpuluhan lapan peratus) mengikut setiap nilai invois yang dikemukakan kepada Kerajaan tertakluk kepada had maksimum RM 9,600.00 (Ringgit Malaysia: Sembilan Ribu dan Enam Ratus) bagi invois yang bernilai RM 1.2 juta (Ringgit Malaysia: Satu Juta Dua Ratus Ribu) atau lebih.</span></p>
					#end 
					#if ($fulfilmentType == "false")
						<p style="text-align:justify;"><span style="font-family:Arial;font-size:13px;font-weight:normal;font-style:normal;text-decoration:none;color:#333333;">Syarikat/Firma/Koperasi/Pemilikan Tunggal hendaklah mengambil perhatian bahawa setiap transaksi melalui Sistem ePerolehan akan dikenakan fi perkhidmatan sebanyak 0.4% (kosong perpuluhan empat peratus) mengikut setiap nilai invois yang dikemukakan kepada Kerajaan tertakluk kepada had maksimum RM 4,800.00 (Ringgit Malaysia : Empat Ribu dan Sembilan Ratus) bagi invois yang bernilai RM 1.2 juta (Ringgit Malaysia : Satu Juta Dua Ratus Ribu) atau lebih.</span></p>
					#end
				</td>
			</tr>
	</table>
</body>
</html>