<html>

<head>
	<style>
		@page { size: A4 portrait;}
		@page { @bottom-center { content: element(footer) }}
				
		.footer {
			display: block; text-align: center;
			position: running(footer);
		}
		
	</style>
</head>

<body>

<table>
    <tr align='center'>
        <td>
            <img src='http://$hostUrl/NGeP-portlet/resources/ep/images/Lambang_Malaysia_2010.jpg' width='124' height='100' />
        </td>
    </tr>
    <tr align='center'>
        <td>
            <span style='font-weight:bold;font-size:16px;font-family: Albertus Medium;'>KEMENTERIAN KEWANGAN MALAYSIA</span>
        </td>
    </tr>
    <tr align='center'>
        <td>
            <span style='font-weight:bold;font-size:14px;font-family: Albertus Medium;'>SIJIL AKUAN PENDAFTARAN SYARIKAT</span>
        </td>
    </tr>
    <tr>
    	<td />
    </tr>
    <tr>
        <td align='center'>
            <table width='100%'>
                <tr align='left'>
                	<td width='200' />
                    <td width='180'>
                        <span style='font-size:11px;font-family: Albertus Medium;'>NO. SIJIL</span>
                    </td>
                    <td >
                        <span style='font-size:11px;font-family: Times New Roman;'>: $mofCertSerialNo</span>
                    </td>
                </tr>
                <tr align='left'>
                    <td width='200' />
                    <td width='180'>
                        <span style='font-size:11px;font-family: Albertus Medium;'>NO. RUJUKAN PENDAFTARAN</span>
                    </td>
                    <td>
                        <span style='font-size:11px;font-family: Times New Roman;'>: $mofAccountNo</span>
                    </td>
                </tr>
                <tr align='left'>
                    <td width='200' />
                    <td colspan='2'>
                        <span style='font-size:11px;font-family: Albertus Medium;'>TEMPOH SAH LAKU &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</span>
                        <span style='font-size:11px;font-family: Times New Roman;'>: $effDate - $expDate</span>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
    	<td />
    </tr>
    <tr align='left'>
        <td>
            <span style='font-size:11px;font-family: Albertus Medium;'>Bahawa dengan ini diperakui syarikat:</span>
        </td>
    </tr>
    <tr>
    	<td />
    </tr>
    <tr align='left'>
        <td>
            <span style='font-size:11px;font-family: Times New Roman;'>
            	$companyName ($bizRegNo)<br />
            	$address1 <br />
            	#if ( $address2 != "")
            		$address2<br />
            	#end
            	#if ( $address2 != "")
            		$address3<br />
            	#end
            	#if ( $address2 != "")
            		$address4<br />
            	#end
            	$postCode $cityName, $stateName
            </span>
        </td>
    </tr>
    <tr>
    	<td />
    </tr>
    <tr align='left'>
        <td>
            <span style='font-size:11px;font-family: Albertus Medium;'>Telah berdaftar dengan Kementerian Kewangan Malaysia dalam bidang bekalan/perkhidmatan di bawah sektor, bidang dan sub-bidang seperti di Lampiran A. Kelulusan ini adalah tertakluk kepada syarat-syarat seperti yang dinyatakan di Lampiran B. Individu yang diberi kuasa oleh syarikat bagi urusan perolehan Kerajaan adalah seperti berikut:</span>
        </td>
    </tr>
    <tr>
    	<td />
    </tr>
    <tr align='left'>
        <td>
            <span style='font-weight:bold;font-size:10px;font-family: Times New Roman;'>
            	<table width='100%'>
            		#foreach( $personnel in $personnelList )
            		<tr>
            			<td>$personnel.name</td>
            			<td>$personnel.identificationNo</td>
            			<td>$personnel.designation</td>
            		</tr>
            		#end
            	</table>
            </span>
        </td>
    </tr>
    <tr>
    	<td />
    </tr>
    <tr align='left'>
        <td>
            <table style='border:1px solid #DDDDDD;' width='100%'><tr><td>
                <span style='font-size:8px;font-family: Times New Roman;'>
                    Limitation remarks
                </span>
            </td></tr></table>
        </td>
    </tr>
    <tr>
    	<td />
    </tr>
    <tr>
    	<td />
    </tr>
    <tr align='left'>
        <td>
            <span style='font-weight:bold;font-size:12px;font-family: Albertus Medium;'>DATO' FAUZIAH YAACOB</span><br />
            <span style='font-size:11px;font-family: Albertus Medium;'>Bahagian Perolehan Kerajaan</span><br />
            <span style='font-size:11px;font-family: Albertus Medium;'>b.p. Ketua Setiausaha Perbendaharaan</span><br />
            <span style='font-size:11px;font-family: Albertus Medium;'>Kementerian Kewangan Malaysia</span>
        </td>
    </tr>
    <tr align='left'>
        <td>
            <span style='font-size:11px;font-family: Albertus Medium;'>
                Tarikh Berdaftar Dengan Kementerian Kewangan Malaysia: $registrationDate
            </span>
        </td>
    </tr>
    <!--<tr align='center'>
        <td>
            <span style='font-size:11px;font-family: Albertus Medium;'>
                (Sijil ini adalah cetakan komputer dan tidak memerlukan tandatangan)
            </span>
        </td>
    </tr>-->
    <!--<tr>
        <td>
            <ul>
            #foreach( $product in $allProducts )
                <li>$product</li>
            #end
            </ul>
        </td>
    </tr>-->
</table>
<div class='footer'><span style='font-size:11px;font-family: Times New Roman;'>(Sijil ini adalah cetakan komputer dan tidak memerlukan tandatangan)</span></div>
</body>
</html>