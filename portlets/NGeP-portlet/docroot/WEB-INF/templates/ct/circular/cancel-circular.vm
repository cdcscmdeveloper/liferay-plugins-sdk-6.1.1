<?xml version="1.0"?>

<root available-locales="ms_MY" default-locale="ms_MY">
 <static-content language-id="ms_MY"><![CDATA[<!--?xml version="1.0"?-->

<html>

<head>
	<style>
		@page { size: A4 portrait;}
		@page { @top-right { content: element(header) }}
				
		.header {
			display: block; text-align: right;
			position: running(header);
		}	
		
		.title-text {
			font-family: Albertus Medium;
			font-weight:bold;
			font-size:10px;			
		}
		
		tr {
			font-family: Albertus Medium;
			font-size:9px;			
		}
		
		.bold-text {
			font-weight:bold;
		}
	</style>
</head>

<body>

<table>
	<tr class='bold-text'>
		<td>
			<span style='width:70px;font-size:11px;font-family: Albertus Medium;'>Cancel 1PP Req No.</span>
		</td>
		<td style='width:5px;'>:</td>
		<td >
			<span style='font-size:11px;font-family: Times New Roman;'>$cancelCircularReqNo</span>
		</td>	
	</tr>
</table>
<br/>
<table>
	<tr class='bold-text'>
		<td colspan="3" style='font-size:11px;font-family: Albertus Medium;'>List of cancelled circulars:-</td>
	</tr>
</table>	
<table width='100%' style='font-size:11px;font-family: Albertus Medium;'>
	#foreach( $cancelCircular in $cancelCircularList )
	<tr>
		<td style='width:100px;font-size:11px;font-family: Albertus Medium;'>Physical 1PP No.</td>
		<td style='width:5px;'>:</td>
		<td style='font-size:11px;font-family: Times New Roman;'>$cancelCircular.circularVer.circularNo</td>
	</tr>
	<tr>
		<td style='width:100px;font-size:11px;font-family: Albertus Medium;'>1PP Name</td>
		<td style='width:5px;'>:</td>
		<td style='font-size:11px;font-family: Times New Roman;'>$cancelCircular.circularVer.name<br/></td>
	</tr>	
	#end
</table>

</body>
</html>

]]></static-content>
</root>