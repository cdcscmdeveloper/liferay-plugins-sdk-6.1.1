<html>

<head>
	<style>
		@page { size: A4 portrait;}
		@page { @top-right { content: element(header) }}
				
		.header {
			display: block; text-align: right;
			position: running(header);
		}	
		
		.title-text {
			font-family: Albertus Medium;
			font-weight:bold;
			font-size:10px;			
		}
		
		tr {
			font-family: Albertus Medium;
			font-size:9px;			
		}
		
		.bold-text {
			font-weight:bold;
		}
	</style>
</head>

<body>

<table>
	<tr class='bold-text'>
		<td>
			<span style='width:70px;font-size:11px;font-family: Albertus Medium;'>Circular No.</span>
		</td>
		<td style='width:5px;'>:</td>
		<td >
			<span style='font-size:11px;font-family: Times New Roman;'>$circularNo</span>
		</td>	
	</tr>
	<tr class='bold-text'>
		<td>
			<span style='width:70px;font-size:11px;font-family: Albertus Medium;'>Circular Name</span>
		</td>
		<td style='width:5px;'>:</td>
		<td >
			<span style='font-size:11px;font-family: Times New Roman;'>$circularName</span>
		</td>
	</tr>
</table>
<br/>
<table width='100%' style='font-size:11px;font-family: Albertus Medium;'>
	#foreach( $contract in $contractList )
	<tr>
		<td style='width:70px;font-size:11px;font-family: Albertus Medium;'>Contract No.</td>
		<td style='width:5px;'>:</td>
		<td style='font-size:11px;font-family: Times New Roman;'>$contract.ctContract.contractNo</td>
	</tr>
	<tr>
		<td style='width:70px;font-size:11px;font-family: Albertus Medium;'>Supplier</td>
		<td style='width:5px;'>:</td>
		<td style='font-size:11px;font-family: Times New Roman;'>$contract.ctContract.latestContractVer.ctContractValue.supplierName</td>
	</tr>	
	#end
</table>
<br/>
<table>	
	<tr>
		<td>Update as of $changedDate</td>
	</tr>
</table>

</body>
</html>