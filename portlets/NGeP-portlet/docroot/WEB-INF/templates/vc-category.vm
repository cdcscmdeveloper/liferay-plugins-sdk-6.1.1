<html>

<head>
	<style>
		@page { size: A4 portrait;}
		@page { @bottom-center { content: element(footer) }}
		@page { @top-right { content: element(header) }}

		.header {
			display: block; text-align: right;
			position: running(header);
		}				
		.footer {
			display: block; text-align: left;
			position: running(footer);
		}
		
		
		table
		{
			border-collapse:collapse;
		}
		th
		{
			border:1px solid black;
			font-size:11px;
			font-family: Albertus Medium;
		}
		td
		{
			border-bottom:none;
			border-top:none;
			font-size:11px;
			font-family: Times New Roman;
		}
		
	</style>
</head>

<body>
<div class='header'><span style='font-size:11px;font-family: Albertus Medium;'>LAMPIRAN A</span></div>
<table>
    <tr align='left'>
        <td>
            <table width='100%'>
                <tr align='left'>
                    <td width='180px'>
                        <span style='font-size:11px;font-family: Albertus Medium;'>NO. SIJIL</span>
                    </td>
                    <td >
                        <span style='font-size:11px;font-family: Times New Roman;'>: $mofCertSerialNo</span>
                    </td>
                </tr>
                <tr align='left'>
                    <td width='180px'>
                        <span style='font-size:11px;font-family: Albertus Medium;'>NO. RUJUKAN PENDAFTARAN</span>
                    </td>
                    <td>
                        <span style='font-size:11px;font-family: Times New Roman;'>: $mofAccountNo</span>
                    </td>
                </tr>
                <tr align='left'>
                    <td width='180px'>
                        <span style='font-size:11px;font-family: Albertus Medium;'>TEMPOH SAH LAKU</span>
                    </td>
                    <td>
                        <span style='font-size:11px;font-family: Times New Roman;'>: $effDate - $expDate</span>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
    	<td><span>&#160;</span></td>
    </tr>
    <tr align='left'>
        <td>
		
		<table style='border:10px;'>
		
		 <tr align='center'>
		  	<th width='20' >BIL</th >
		  	<th width='120' >TARIKH DAFTAR BIDANG</th >
		  	<th width='50' >KOD BIDANG</th >
		  	<th width='570' >KETERANGAN</th >
		  	<th width='60' >STATUS</th >
		 </tr>
		#set( $count = 1 )	
		#foreach( $category in $categories )
		 <tr >
		  	<th >$count</th>
		  	<th >$category.get(0)</th>
		  	<th >$category.get(2)</th>
		  	<th >$category.get(3)</th>
		  	<th >$category.get(4)</th>
		 </tr>
			#set( $count = $count + 1 )
		#end
		
		</table>
            
        </td>
    </tr>
    <tr>
    	<td><span>&#160;</span></td>
    </tr>
    #if ( $addDateAndCount != "")
    <tr align='left'>
        <td>
            <span style='font-size:11px;font-family: Albertus Medium;'>Bilangan Tambah Bidang Pada </span>
            <span style='font-size:11px;font-family: Times New Roman;'>$addDateAndCount</span>
        </td>
    </tr>
    #end
    #if ( $deleteDateAndCount != "")
    <tr align='left'>
        <td>
            <span style='font-size:11px;font-family: Albertus Medium;'>Bilangan Batal Bidang Pada</span>
            <span style='font-size:11px;font-family: Times New Roman;'>$deleteDateAndCount</span>
        </td>
    </tr>
    #end
</table>


<div class='footer'>
            <span style='font-size:11px;font-family: Albertus Medium;'>Tarikh Berdaftar Dengan Kementerian Kewangan Malaysia:</span>
            <span style='font-size:11px;font-family: Times New Roman;'>$regDate</span>
</div>

</body>
</html>