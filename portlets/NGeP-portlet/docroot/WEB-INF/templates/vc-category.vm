<html>

<head>
	<style>
		@page { size: A4 portrait;}
		@page { @bottom-center { content: element(footer) }}
		@page { @top-right { content: element(header) }}

		.header {
			display: block; text-align: right;
			position: running(header);
		}				
		.footer {
			display: block; text-align: center;
			position: running(footer);
		}
		
		
		table
		{
			border-collapse:collapse;
		}
		th
		{
			border:1px solid black;
			font-size:11px;
			font-family: Albertus Medium;
		}
		td
		{
			border-bottom:none;
			border-top:none;
			font-size:11px;
			font-family: Times New Roman;
		}
		
	</style>
</head>

<body>
<div class='header'><span style='font-size:11px;font-family: Albertus Medium;'>LAMPIRAN A</span></div>
<table>
    <tr align='left'>
        <td>
            <table width='100%'>
                <tr align='left'>
                    <td width='180px'>
                        <span style='font-size:11px;font-family: Albertus Medium;'>NO. SIJIL</span>
                    </td>
                    <td >
                        <span style='font-size:11px;font-family: Times New Roman;'>: $mofCertSerialNo</span>
                    </td>
                </tr>
                <tr align='left'>
                    <td width='180px'>
                        <span style='font-size:11px;font-family: Albertus Medium;'>NO. RUJUKAN PENDAFTARAN</span>
                    </td>
                    <td>
                        <span style='font-size:11px;font-family: Times New Roman;'>: $mofAccountNo</span>
                    </td>
                </tr>
                <tr align='left'>
                    <td width='180px'>
                        <span style='font-size:11px;font-family: Albertus Medium;'>TEMPOH SAH LAKU</span>
                    </td>
                    <td>
                        <span style='font-size:11px;font-family: Times New Roman;'>: $effDate - $expDate</span>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
    	<td><span>&#160;</span></td>
    </tr>
    <tr align='left'>
        <td>
		<table border='1' >
		
		 <tr >
		  	<th width='20' >BIL</th >
		  	<th width='200' >TARIKH DAFTAR BIDANG</th >
		  	<th width='200' >KOD BIDANG</th >
		  	<th width='200' >KETERANGAN</th >
		  	<th width='200' >STATUS</th >
		 </tr>
		#set( $count = 1 )	
		#foreach( $supplierCategory in $categoryList )
		 <tr >
		  	<td width='20' >$count</td>
		  	<td width='200' >$supplierCategory.changedDate</td>
		  	<td width='100' >$supplierCategory.pmCategoryL1.categoryL1Code$supplierCategory.pmCategoryL1.categoryL1Code$supplierCategory.pmCategoryL3.categoryL3Code</td>
		  	<td width='400' >$supplierCategory.pmCategoryL3.categoryName</td>
		  	<td width='100' >AKTIF</td>
		 </tr>
			#set( $count = $count + 1 )
		#end
		
		</table>
            
        </td>
    </tr>
    <tr>
    	<td><span>&#160;</span></td>
    </tr>
    <tr align='left'>
        <td>
            <span style='font-size:11px;font-family: Albertus Medium;'>Bilangan Tambah Bidang Pada</span>
            <span style='font-size:11px;font-family: Times New Roman;'>dd/mm/yyyy</span>
        </td>
    </tr>
    <tr align='left'>
        <td>
            <span style='font-size:11px;font-family: Albertus Medium;'>Bilangan Batal Bidang Pada</span>
            <span style='font-size:11px;font-family: Times New Roman;'>dd/mm/yyyy</span>
        </td>
    </tr>
</table>


<div style='margin-top:800px;'>
            <span style='font-size:11px;font-family: Albertus Medium;'>Tarikh Berdaftar Dengan Kementerian Kewangan Malaysia:</span>
            <span style='font-size:11px;font-family: Times New Roman;'>$regDate</span>
</div>

</body>
</html>