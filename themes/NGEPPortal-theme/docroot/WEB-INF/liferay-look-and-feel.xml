<?xml version="1.0"?>
<!DOCTYPE look-and-feel PUBLIC "-//Liferay//DTD Look and Feel 6.0.0//EN" "http://www.liferay.com/dtd/liferay-look-and-feel_6_0_0.dtd">

<look-and-feel>
	<compatibility>
		<version>6.1.0+</version>
	</compatibility>
	<theme id="NGEPPortal" name="NGEPPortal" >
		<settings>
        	<setting key="my-setting" value="my-value" />
	    </settings>
	    
	    <color-scheme id="green" name="green">
	        <css-class>green</css-class>
	        <color-scheme-images-path>${images-path}/color_schemes/${css-class}</color-scheme-images-path>
	    </color-scheme>
	    
	    <color-scheme id="blue" name="blue">
	        <css-class>blue</css-class>
	        <color-scheme-images-path>${images-path}/color_schemes/${css-class}</color-scheme-images-path>
	    </color-scheme>
	    
	    <color-scheme id="red" name="red">
	        <css-class>red</css-class>
	        <color-scheme-images-path>${images-path}/color_schemes/${css-class}</color-scheme-images-path>
	    </color-scheme>
	    
	</theme>
</look-and-feel>