	#js ("$javascript_folder/jquery.cookie.js")
	<script language="javascript">
		function resizeText(multiplier) 
		{
			if (document.body.style.fontSize == "") 
			{
		    	document.body.style.fontSize = "1.0em";
		  	}
		  	document.body.style.fontSize = parseFloat(document.body.style.fontSize) + (multiplier * 0.2) + "em";
		}
		
		function resetText()
		{
			var curURL = document.URL;
			window.location.href=curURL;
		}
	
		function onPageLoad()
		{
			var curURL = document.URL;
			if(curURL.indexOf("8080/en")!=-1)
			{
				document.getElementById("SelectedLanguage").innerHTML="English";	
			}
			else if(curURL.indexOf("8080/ms")!=-1)
			{
				document.getElementById("SelectedLanguage").innerHTML="Bahasa Malaysia";
			}
		}
		
		function selectLanguage(option){
			
			var curURL = document.URL;
			var newURL;
									
			if(curURL.indexOf("8080/en")!=-1)
			{
				switch(option)
				{
					case 'ms':
						newURL = curURL.replace("8080/en","8080/ms");
						break;
					case 'en':
						newURL = curURL;
						break;
				}
			}
			else if(curURL.indexOf("8080/ms")!=-1)
			{
				switch(option)
				{
					case 'ms':
						newURL = curURL;
						break;
					case 'en':
						newURL = curURL.replace("8080/ms","8080/en");
						break;
				}
			}
			else if(curURL.indexOf("8080/")!=-1)
			{
				switch(option)
				{
					case 'ms':
						newURL = curURL.replace("8080/","8080/ms/");
						break;
					case 'en':
						newURL = curURL.replace("8080/","8080/en/");
						break;
				}
			}
			else
			{
				switch(option)
				{
					case 'ms':
						newURL = curURL.replace("8080","8080/ms");
						break;
					case 'en':
						newURL = curURL.replace("8080","8080/en");
						break;
				}
			}
			
			window.location.href=newURL;
			
		}
	</script>
	
	<script type="text/javascript">  
	$(function() {  
    $('#close').click(function() {  
        $('.sticky').remove();  
    	});  
	});  
	</script>
	
		<script>
	jQuery(document).ready(function(){
	
	onPageLoad();
	
   var colorscheme = jQuery.cookie('colorscheme');
   
   if (colorscheme === "undefined"){
	
   }
   else
   {
   		if(!jQuery('body').hasClass(colorscheme))
		   		{
		   			if(colorscheme==="green")
		   			{
		   				jQuery('body').removeClass('blue');
		   			}
		   			else
		   			{
		   				jQuery('body').removeClass('green');
		   			}
		   			jQuery('body').addClass(colorscheme);
		   		};
   };

  jQuery("#bred").click(function(){
    
	jQuery.cookie('colorscheme', "red", { expires: 7 });
	
	location.reload();
  });
     
  jQuery("#bgreen").click(function(){
   
	jQuery.cookie('colorscheme', "green", { expires: 7 });
	
	location.reload();
  });
  
  
  jQuery("#bblue").click(function(){
    
	jQuery.cookie('colorscheme', "blue", { expires: 7 });
	
	location.reload();
  });
  
  
  
});
</script>

