<!DOCTYPE html>

#parse ($init)

<html class="#language("lang.dir")" dir="#language("lang.dir")" lang="$w3c_language_id">

<head>
	<title>$the_title - $company_name</title>

	$theme.include($top_head_include)
	
	<script language="javascript">
		function resizeText(multiplier) 
		{
			if (document.body.style.fontSize == "") 
			{
		    	document.body.style.fontSize = "1.0em";
		  	}
		  	document.body.style.fontSize = parseFloat(document.body.style.fontSize) + (multiplier * 0.2) + "em";
		}
		
		function resetText()
		{
			var curURL = document.URL;
			window.location.href=curURL;
		}
	
		function onPageLoad()
		{
			var curURL = document.URL;
			if(curURL.indexOf("8080/en")!=-1)
			{
				document.getElementById("SelectedLanguage").innerHTML="English";	
			}
			else if(curURL.indexOf("8080/in")!=-1)
			{
				document.getElementById("SelectedLanguage").innerHTML="Melayu";
			}
		}
		
		function selectLanguage(option){
			
			var curURL = document.URL;
			var newURL;
									
			if(curURL.indexOf("8080/en")!=-1)
			{
				switch(option)
				{
					case 'my':
						newURL = curURL.replace("8080/en","8080/in");
						break;
					case 'en':
						newURL = curURL;
						break;
				}
			}
			else if(curURL.indexOf("8080/in")!=-1)
			{
				switch(option)
				{
					case 'my':
						newURL = curURL;
						break;
					case 'en':
						newURL = curURL.replace("8080/in","8080/en");
						break;
				}
			}
			else if(curURL.indexOf("8080/")!=-1)
			{
				switch(option)
				{
					case 'my':
						newURL = curURL.replace("8080/","8080/in/");
						break;
					case 'en':
						newURL = curURL.replace("8080/","8080/en/");
						break;
				}
			}
			else
			{
				switch(option)
				{
					case 'my':
						newURL = curURL.replace("8080","8080/in");
						break;
					case 'en':
						newURL = curURL.replace("8080","8080/en");
						break;
				}
			}
			
			window.location.href=newURL;
			
		}
	</script>
</head>

<body class="$css_class">

$theme.include($body_top_include)

#if ($is_signed_in)

	#dockbar
	
#end

	<header>
    	        
        <div class="middle-navi login-top-navi">
            <div class="middle-navi-wrapper">
            	
                <div class="middle-navi-left-wrapper">
                    <a class="logo" href="$site_default_url" title="#language("go-to") $site_name">
                    <img alt="$logo_description" height="$site_logo_height" src="$site_logo" width="$site_logo_width" />
                    </a>
            	</div>
                
            	<div class="middle-navi-right-wrapper">
                    <ul>
                    	<li class="divider"></li>
                        <li class="btn-language">
                            <a href="#" id="SelectedLanguage">English</a>
                            <div class="dropdown-language-wrapper">
								<a href="javascript:selectLanguage('en');"><p>English</p></a> 
                                <div class="clear"></div>                           
								<a href="javascript:selectLanguage('my');"><p>Bahasa Melayu</p></a>                            
                            </div>
                        </li>
                    	<li class="divider"></li>
                        <li><a href="#"><img src="$images_folder/navi/btn-disabled.png" /></a></li>
                    	<li class="divider"></li>
                        <li class="btn-reset"><a href="javascript:resetText();">Reset</a></li>
                        <li class="btn-smaller"><a href="javascript:resizeText(-1);">A-</a></li>
                        <li class="btn-larger"><a href="javascript:resizeText(1);">A+</a></li>
                    	<li class="btn-login-register divider-no-padding-right">
                    	
                    	#if (!$is_signed_in)
                    		<a class="btn-login-register" href="$sign_in_url" id="sign-in" rel="nofollow">Login or Register</a>	
                    	#end
                    	</li>
                    </ul>
                    <div class="clear"></div>
                </div>
                
                <div class="middle-search-wrapper">
                    <input name="search" type="text" placeholder="Search"><a class="btn-search" href="#"></a>
                </div>
                
                <div class="middle-logo-wrapper">
                    <ul>
                        <li><a href="#"><img src="$images_folder/general/eperolehan-top.png" /></a></li>
                        <li><img src="$images_folder/general/msc.png" /></li>
                    </ul>
                </div>                
            	<div class="clear"></div>
            </div>
        </div>
				
        	#if($has_navigation)
			#parse("$full_templates_path/navigation.vm")
		#end
	
    </header>

	<div id="content">

		#if ($selectable)
			$theme.include($content_include)
		#else
			$portletDisplay.recycle()

			$portletDisplay.setTitle($the_title)

			$theme.wrapPortlet("portlet.vm", $content_include)
		#end
